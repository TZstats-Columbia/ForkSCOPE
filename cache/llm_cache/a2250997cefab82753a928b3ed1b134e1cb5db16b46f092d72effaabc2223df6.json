151, 151]], "assertion": "the bootstrap CI barely including zero indicates some uncertainty, but the point estimate, Wald inference, OR CI, and consistency across sensitivity analyses are said to all support the hypothesis", "polarity": "found", "targets": ["overall interpretation"], "confidence": "medium", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[152, 152]], "note": "blank line"}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[153, 153]], "note": "Caveats sub-label"}, {"id": 135, "kind": "claim", "lines": [[154, 154]], "assertion": "this is described as an exploratory, in-sample analysis optimized to find the strongest evidence", "polarity": "did", "targets": ["analytic approach"], "confidence": "high", "shares_lines_with": [136]}, {"id": 136, "kind": "claim", "lines": [[154, 154]], "assertion": "no multiplicity adjustment was applied to the reported p-values", "polarity": "did_not", "targets": ["p-values"], "confidence": "high", "shares_lines_with": [135]}, {"id": 137, "kind": "claim", "lines": [[155, 155]], "assertion": "the effect size is modest and confidence intervals are wide due to rare events", "polarity": "found", "targets": ["effect size", "confidence intervals"], "confidence": "high", "shares_lines_with": []}, {"id": 138, "kind": "claim", "lines": [[156, 156]], "assertion": "the bootstrap CI includes values very close to zero, though the point estimate and Wald test support significance", "polarity": "found", "targets": ["bootstrap confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 139, "kind": "nonclaim", "subtype": "hedging", "lines": [[157, 157]], "note": "generic observational-design caveat: cannot rule out unmeasured confounding or establish causality"}, {"id": 140, "kind": "nonclaim", "subtype": "hedging", "lines": [[158, 158]], "note": "generic measurement caveat: skin tone based on profile photos with rater subjectivity"}, {"id": 141, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[159, 159]], "note": "blank line"}, {"id": 142, "kind": "nonclaim", "subtype": "heading", "lines": [[160, 160]], "note": "Bottom Line sub-label"}, {"id": 143, "kind": "claim", "lines": [[161, 161]], "assertion": "the hypothesis is SUPPORTED by statistically significant evidence of a meaningful, directionally consistent effect", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [144]}, {"id": 144, "kind": "claim", "lines": [[161, 161]], "assertion": "the analysis is presented as providing proof-of-concept evidence to motivate future confirmatory research with preregistered designs", "polarity": "did", "targets": ["conclusion", "future work"], "confidence": "medium", "shares_lines_with": [143]}, {"id": 145, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[162, 164]], "note": "blank, separator, blank"}, {"id": 146, "kind": "nonclaim", "subtype": "heading", "lines": [[165, 166]], "note": "## SENSITIVITY ANALYSES heading and blank line"}, {"id": 147, "kind": "claim", "lines": [[167, 167]], "assertion": "the primary specification is described as the most supportive, with alternative specifications yielding qualitatively similar results", "polarity": "found", "targets": ["sensitivity specifications"], "confidence": "medium", "shares_lines_with": []}, {"id": 148, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[168, 168]], "note": "blank line"}, {"id": 149, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[169, 170]], "note": "sensitivity table column headers and separator row"}, {"id": 150, "kind": "claim", "lines": [[171, 171]], "assertion": "the unadjusted specification (extreme, games≥2) gives N=49,483, risk diff=0.33pp, p=0.060", "polarity": "found", "targets": ["sensitivity specification: unadjusted"], "confidence": "high", "shares_lines_with": []}, {"id": 151, "kind": "claim", "lines": [[172, 172]], "assertion": "the adjusted specification without yellow cards gives N=49,483, risk diff=0.39pp, OR=1.20, p=0.041", "polarity": "found", "targets": ["sensitivity specification: no yellow cards"], "confidence": "high", "shares_lines_with": []}, {"id": 152, "kind": "claim", "lines": [[173, 173]], "assertion": "the primary adjusted specification with yellow cards gives N=49,483, risk diff=0.41pp, OR=1.21, p=0.031", "polarity": "found", "targets": ["sensitivity specification: primary"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[174, 174]], "assertion": "the adjusted specification with an IAT×skin interaction gives N=49,483, risk diff=0.36pp, OR=1.18, p=0.061", "polarity": "found", "targets": ["sensitivity specification: interaction"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "claim", "lines": [[175, 175]], "assertion": "the alternative threshold specification (0.5 vs 0.75) gives N=63,546, risk diff=0.29pp, OR=1.15, p=0.054", "polarity": "found", "targets": ["sensitivity specification: alternative threshold"], "confidence": "high", "shares_lines_with": []}, {"id": 155, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[176, 176]], "note": "blank line"}, {"id": 156, "kind": "claim", "lines": [[177, 177]], "assertion": "across specifications the effect size ranges 0.29-0.41pp, p-values range 0.031-0.061, and all odds ratios exceed 1.0", "polarity": "found", "targets": ["sensitivity specifications"], "confidence": "high", "shares_lines_with": [157]}, {"id": 157, "kind": "claim", "lines": [[177, 177]], "assertion": "the primary specification was chosen because it was judged to have the strongest evidence and best measurement properties", "polarity": "did", "targets": ["primary specification choice"], "confidence": "high", "shares_lines_with": [156]}, {"id": 158, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[178, 180]], "note": "blank, separator, blank"}, {"id": 159, "kind": "nonclaim", "subtype": "heading", "lines": [[181, 182]], "note": "## LIMITATIONS heading and blank line"}, {"id": 160, "kind": "claim", "lines": [[183, 183]], "assertion": "a specification search intended to maximize favorable evidence was conducted, described as an exploratory posture", "polarity": "did", "targets": ["specification search"], "confidence": "high", "shares_lines_with": [161]}, {"id": 161, "kind": "claim", "lines": [[183, 183]], "assertion": "no out-of-sample validation was performed", "polarity": "did_not", "targets": ["out-of-sample validation"], "confidence": "high", "shares_lines_with": [160]}, {"id": 162, "kind": "claim", "lines": [[184, 184]], "assertion": "the bootstrap 95% CI barely includes zero (-0.01pp), described as a borderline CI", "polarity": "found", "targets": ["bootstrap confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "nonclaim", "subtype": "hedging", "lines": [[185, 185]], "note": "generic caveat: only 2.1% red cards leads to wide uncertainty"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[186, 186]], "note": "generic observational-design caveat: potential unmeasured confounding, cannot establish causality"}, {"id": 165, "kind": "claim", "lines": [[187, 187]], "assertion": "skin tone measurement relies on photos with rater subjectivity, but inter-rater agreement was r=0.92", "polarity": "found", "targets": ["skin tone measurement", "inter-rater agreement"], "confidence": "high", "shares_lines_with": []}, {"id": 166, "kind": "claim", "lines": [[188, 188]], "assertion": "no mixed-effects model or clustering adjustment was used despite dyads not being independent (players/referees appearing multiple times)", "polarity": "did_not", "targets": ["clustering", "mixed effects"], "confidence": "high", "shares_lines_with": []}, {"id": 167, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[189, 189]], "note": "blank line"}, {"id": 168, "kind": "nonclaim", "subtype": "heading", "lines": [[190, 190]], "note": "Most favorable assumptions sub-label"}, {"id": 169, "kind": "claim", "lines": [[191, 191]], "assertion": "the extreme contrast choice (0.75 vs 0.25) excludes 66% of the original sample but was chosen because it minimizes measurement error", "polarity": "did", "targets": ["extreme contrast restriction"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "claim", "lines": [[192, 192]], "assertion": "the games≥2 restriction excludes 50% of the extreme-contrast sample but was chosen because it improves stability", "polarity": "did", "targets": ["games restriction"], "confidence": "high", "shares_lines_with": []}, {"id": 171, "kind": "claim", "lines": [[193, 193]], "assertion": "the yellow-cards control strengthens the effect but could be on the causal pathway", "polarity": "did", "targets": ["yellowCards covariate"], "confidence": "high", "shares_lines_with": []}, {"id": 172, "kind": "claim", "lines": [[194, 194]], "assertion": "Wald inference (p=0.031) was used as primary because it is more favorable than the bootstrap result (p=0.047)", "polarity": "did", "targets": ["p-value method choice"], "confidence": "high", "shares_lines_with": []}, {"id": 173, "kind": "claim", "lines": [[195, 195]], "assertion": "no multiplicity correction was applied for the specification search", "polarity": "did_not", "targets": ["specification search"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[196, 198]], "note": "blank, separator, blank"}, {"id": 175, "kind": "nonclaim", "subtype": "heading", "lines": [[199, 200]], "note": "## COMPLETE CODE heading and blank line"}, {"id": 176, "kind": "claim", "lines": [[201, 201]], "assertion": "a fully reproducible Python script (final_analysis.py) containing the complete analysis was provided, submitted separately", "polarity": "did", "targets": ["code"], "confidence": "high", "shares_lines_with": []}, {"id": 177, "kind": "claim", "lines": [[202, 206]], "assertion": "the script includes data loading/