ilerplate", "lines": [[132, 132]], "note": "blank line"}, {"id": 113, "kind": "nonclaim", "subtype": "heading", "lines": [[133, 133]], "note": "subheading"}, {"id": 114, "kind": "claim", "lines": [[134, 134]], "assertion": "the model adjusted for position, league, games, yellow cards, and (in sensitivity analyses) implicit/explicit bias measures", "polarity": "did", "targets": ["position", "league", "games", "yellow cards", "implicit bias", "explicit bias"], "confidence": "high", "shares_lines_with": []}, {"id": 115, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[135, 135]], "note": "blank line"}, {"id": 116, "kind": "nonclaim", "subtype": "heading", "lines": [[136, 136]], "note": "'Not adjusted for:' label"}, {"id": 117, "kind": "claim", "lines": [[137, 137]], "assertion": "player behavior/aggression was not fully adjusted for beyond the partial yellow-card proxy", "polarity": "did_not", "targets": ["player behavior", "yellow cards"], "confidence": "high", "shares_lines_with": []}, {"id": 118, "kind": "claim", "lines": [[138, 138]], "assertion": "referee-specific characteristics were not adjusted for; only country-level bias measures were available", "polarity": "did_not", "targets": ["referee characteristics"], "confidence": "high", "shares_lines_with": []}, {"id": 119, "kind": "claim", "lines": [[139, 139]], "assertion": "team quality was not adjusted for", "polarity": "did_not", "targets": ["team quality"], "confidence": "high", "shares_lines_with": []}, {"id": 120, "kind": "claim", "lines": [[140, 140]], "assertion": "match importance was not adjusted for", "polarity": "did_not", "targets": ["match importance"], "confidence": "high", "shares_lines_with": []}, {"id": 121, "kind": "claim", "lines": [[141, 141]], "assertion": "historical referee-player reputation was not adjusted for", "polarity": "did_not", "targets": ["historical reputation"], "confidence": "high", "shares_lines_with": []}, {"id": 122, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[142, 142]], "note": "blank line"}, {"id": 123, "kind": "nonclaim", "subtype": "heading", "lines": [[143, 143]], "note": "subheading"}, {"id": 124, "kind": "claim", "lines": [[144, 144]], "assertion": "each player appears in ~71 dyads on average and each referee in ~46 dyads on average", "polarity": "found", "targets": ["players", "referees"], "confidence": "high", "shares_lines_with": []}, {"id": 125, "kind": "claim", "lines": [[145, 145]], "assertion": "two-way clustering (player + referee) would ideally have been used instead of single-level clustering, which would likely increase standard errors further", "polarity": "would_have", "targets": ["clustering", "standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 126, "kind": "nonclaim", "subtype": "hedging", "lines": [[146, 146]], "note": "caveat that dyadic dependencies aren't fully addressed by single-level clustering"}, {"id": 127, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[147, 147]], "note": "blank line"}, {"id": 128, "kind": "nonclaim", "subtype": "heading", "lines": [[148, 148]], "note": "subheading"}, {"id": 129, "kind": "claim", "lines": [[149, 149]], "assertion": "six different model specifications were tested without correction for multiple comparisons", "polarity": "did", "targets": ["model specifications"], "confidence": "high", "shares_lines_with": [130]}, {"id": 130, "kind": "claim", "lines": [[149, 149]], "assertion": "only 1 of 6 specifications reached p<0.05 (the continuous model), consistent with a chance occurrence of about 1 in 6", "polarity": "found", "targets": ["p-value", "model specifications"], "confidence": "high", "shares_lines_with": [129]}, {"id": 131, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[150, 150]], "note": "blank line"}, {"id": 132, "kind": "nonclaim", "subtype": "heading", "lines": [[151, 151]], "note": "subheading"}, {"id": 133, "kind": "claim", "lines": [[152, 152]], "assertion": "red cards occur in only 1.23% of dyads, making estimates less precise and more sensitive to specification/outliers", "polarity": "found", "targets": ["red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 134, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[153, 153]], "note": "blank line"}, {"id": 135, "kind": "nonclaim", "subtype": "heading", "lines": [[154, 154]], "note": "subheading"}, {"id": 136, "kind": "nonclaim", "subtype": "hedging", "lines": [[155, 155]], "note": "caveat that data are from 2012-2013 only and patterns may have changed"}, {"id": 137, "kind": "nonclaim", "subtype": "background", "lines": [[156, 156]], "note": "scope limited to four European leagues"}, {"id": 138, "kind": "nonclaim", "subtype": "background", "lines": [[157, 157]], "note": "sample limited to male players"}, {"id": 139, "kind": "nonclaim", "subtype": "background", "lines": [[158, 158]], "note": "sample limited to first divisions/elite level"}, {"id": 140, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[159, 159]], "note": "blank line"}, {"id": 141, "kind": "nonclaim", "subtype": "heading", "lines": [[160, 160]], "note": "subheading"}, {"id": 142, "kind": "nonclaim", "subtype": "hedging", "lines": [[161, 161]], "note": "caveat that causality cannot be established due to possible unmeasured confounding"}, {"id": 143, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[162, 164]], "note": "blank/separator/blank"}, {"id": 144, "kind": "nonclaim", "subtype": "heading", "lines": [[165, 165]], "note": "strengths section heading"}, {"id": 145, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[166, 166]], "note": "blank line"}, {"id": 146, "kind": "nonclaim", "subtype": "framing", "lines": [[167, 167]], "note": "transition sentence introducing list of strengths"}, {"id": 147, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[168, 168]], "note": "blank line"}, {"id": 148, "kind": "claim", "lines": [[169, 169]], "assertion": "the sample was large: 93,531 dyads from 1,141 players and 2,753 referees", "polarity": "found", "targets": ["dyads", "players", "referees"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "claim", "lines": [[170, 170]], "assertion": "exposure measurement was high quality: dual-rater skin-tone coding with excellent reliability (r=0.92)", "polarity": "found", "targets": ["inter-rater reliability", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 150, "kind": "claim", "lines": [[171, 171]], "assertion": "appropriate statistical methods were used: cluster-robust standard errors and adjustment for key confounders", "polarity": "did", "targets": ["standard errors", "confounders"], "confidence": "medium", "shares_lines_with": []}, {"id": 151, "kind": "claim", "lines": [[172, 172]], "assertion": "multiple specifications were tested and reported transparently", "polarity": "did", "targets": ["model specifications"], "confidence": "medium", "shares_lines_with": [152]}, {"id": 152, "kind": "claim", "lines": [[172, 172]], "assertion": "reporting was not selective", "polarity": "did_not", "targets": ["selective reporting"], "confidence": "medium", "shares_lines_with": [151]}, {"id": 153, "kind": "claim", "lines": [[173, 173]], "assertion": "the primary analysis used a conservative extreme-group comparison (light vs dark, excluding medium tones) to maximize contrast", "polarity": "did", "targets": ["light skin", "dark skin", "medium tones"], "confidence": "medium", "shares_lines_with": []}, {"id": 154, "kind": "claim", "lines": [[174, 174]], "assertion": "sensitivity analyses showed results were robust to clustering choice, position exclusions, and skin-tone operationalization", "polarity": "found", "targets": ["sensitivity analyses", "clustering", "position exclusions", "skin tone"], "confidence": "medium", "shares_lines_with": []}, {"id": 155, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[175, 177]], "note": "blank/separator/blank"}, {"id": 156, "kind": "nonclaim", "subtype": "heading", "lines": [[178, 178]], "note": "additional observations heading"}, {"id": 157, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[179, 179]], "note": "blank line"}, {"id": 158, "kind": "claim", "lines": [[180, 180]], "assertion": "dark-skinned players had fewer yellow cards on average (0.36 vs 0.41) than light-skinned players", "polarity": "found", "targets": ["yellow cards", "skin tone"], "confidence": "high", "shares_lines_with": [159]}, {"id": 159, "kind": "claim", "lines": [[180, 180]], "assertion": "this pattern would bias results against finding an effect, yet a positive (non-significant) association was still observed", "polarity": "found", "targets": ["yellow cards", "red card association"], "confidence": "medium", "shares_lines_with": [158]}, {"id": 160, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[181, 181]], "note": "blank line"}, {"id": 161, "kind": "claim", "lines": [[182, 182]], "assertion": "dark-skinned players are over-represented in some positions (wingers, forwards) and under-represented in others (midfielders), a pattern addressed via covariate adjustment", "polarity": "found", "targets": ["position", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 162, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[183, 183]], "note": "blank line"}, {"id": 163, "kind": "claim", "lines": [[184, 184]], "assertion": "dark-skinned players are more concentrated in England and France", "polarity": "found", "targets": ["league country", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[185, 185]], "note": "blank line"}, {"id": 165, "kind": "claim", "lines": [[186, 186]], "assertion": "neither implicit (IAT) nor explicit country-level bias scores were significant predictors in Model 3", "polarity": "found", "targets": ["implicit bias", "explicit bias", "Model 3"], "confidence": "high", "shares_lines_with": []}, {"id": 166, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[187, 189]], "note": "blank/separator/blank"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[190, 190]], "note": "recommendations heading"}, {"id": 168, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[191, 191]], "note": "blank line"}, {"id": 169, "kind": "nonclaim", "subtype": "other", "lines": [[192, 192]], "note": "recommends replicating with more recent/other-league data"}, {"id": 170, "kind": "nonclaim", "subtype": "other", "lines": [[193, 193]], "note": "recommends future studies be powered for ~0.2pp effects"}, {"id": 171, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "recommends investigating mechanisms behind any disparity"}, {"id": 172, "kind": "nonclaim", "subtype": "other", "lines": [[195, 195]], "note": "recommends full multilevel models with crossed random effects"}, {"id": 173, "kind": "nonclaim", "subtype": "other", "lines": [[196, 196]], "note": "recommends player-level aggregation analysis"}, {"id": 174, "kind": "nonclaim", "subtype": "other", "lines": [[197, 197]], "note": "recommends supplementing with qualitative research"}, {"id": 175, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[198, 200]], "note": "blank/separator/blank"}, {"id": 176, "kind": "nonclaim", "subtype": "heading", "lines": [[201, 201]], "note": "reproducibility heading"}, {"id": 177, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[202, 202]], "note": "blank line"}, {"id": 178, "kind": "claim", "lines": [[203, 209]], "assertion": "the reproducibility package (final_analysis.py plus soccer.csv) includes data loading/preparation, descriptive statistics, primary/secondary analyses, all sensitivity analyses, power calculations, and visualization code", "polarity": "did", "targets": ["script", "data file", "reproducibility"], "confidence": "high", "shares_lines_with": []}, {"id": 179, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[210, 210]], "note": "blank line"}, {"id": 180, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[211, 211]], "note": "reproduction command instruction"}, {"id": 181, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[212, 214]], "note": "blank/separator/blank"}, {"id": 182, "kind": "nonclaim", "subtype": "heading", "lines": [[215, 215]], "note": "references heading"}, {"id": 183, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[216, 216]], "note": "blank line"}, {"id": 184, "kind": "nonclaim", "subtype": "background", "lines": [[217, 217]], "note": "original data source description: 146,028 dyads, 2,053 players, 3,147 referees, four leagues, 2012-2013"}, {"id": 185, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[218, 218]], "note": "blank line"}, {"id": 186, "kind": "claim", "lines": [[219, 219]], "assertion": "the analysis used Python 3.11 with pandas, numpy, scipy, statsmodels, matplotlib, and seaborn", "polarity": "did", "targets": ["software", "packages"], "confidence": "low", "shares_lines_with": []}, {"id": 187, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[220, 222]], "note": "blank/separator/blank"}, {"id": 188, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[223, 224]], "note": "report metadata: prepared date and analyst"}, {"id": 189, "kind": "claim", "lines": [[225, 225]], "assertion": "hypothesis testing was pre-specified at alpha=0.05 before the analysis", "polarity": "did", "targets": ["hypothesis testing", "alpha", "pre-specification"], "confidence": "medium", "shares_lines_with": []}]}}