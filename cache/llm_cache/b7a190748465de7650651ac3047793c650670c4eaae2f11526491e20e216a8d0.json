rity": "found", "targets": ["absolute effect"], "confidence": "high", "shares_lines_with": [127]}, {"id": 127, "kind": "claim", "lines": [[196, 198]], "assertion": "the effect is judged meaningful given red cards' career and competitive consequences", "polarity": "found", "targets": ["substantive interpretation"], "confidence": "medium", "shares_lines_with": [126]}, {"id": 128, "kind": "nonclaim", "subtype": "other", "lines": [[199, 199]], "note": "blank line"}, {"id": 129, "kind": "claim", "lines": [[200, 202]], "assertion": "relative effect of 15.2% higher risk is described as substantial", "polarity": "found", "targets": ["relative effect"], "confidence": "high", "shares_lines_with": [130]}, {"id": 130, "kind": "claim", "lines": [[200, 202]], "assertion": "the effect is comparable to or larger than other documented biases in sports officiating", "polarity": "found", "targets": ["comparison to prior effects"], "confidence": "low", "shares_lines_with": [129]}, {"id": 131, "kind": "nonclaim", "subtype": "other", "lines": [[203, 203]], "note": "blank line"}, {"id": 132, "kind": "claim", "lines": [[204, 206]], "assertion": "population-level extrapolation of ~128 additional red cards among dark-skinned dyads and ~935 dark-skinned players affected, implying differential treatment across hundreds of careers", "polarity": "found", "targets": ["population-level impact"], "confidence": "medium", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "other", "lines": [[207, 207]], "note": "blank line"}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[208, 208]], "note": "Consistency with Prior Research heading"}, {"id": 135, "kind": "nonclaim", "subtype": "citation", "lines": [[209, 209]], "note": "references Silberzahn et al. 2018 and broader officiating bias literature"}, {"id": 136, "kind": "nonclaim", "subtype": "other", "lines": [[210, 210]], "note": "blank line"}, {"id": 137, "kind": "nonclaim", "subtype": "heading", "lines": [[211, 211]