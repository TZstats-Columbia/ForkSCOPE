dation for Future Research heading"}, {"id": 160, "kind": "claim", "lines": [[239, 239]], "assertion": "preregistered replication in the 2013-2014 season or other leagues would be needed but was not done", "polarity": "would_have", "targets": ["future replication"], "confidence": "high", "shares_lines_with": []}, {"id": 161, "kind": "claim", "lines": [[240, 240]], "assertion": "individual referee bias measures (not country aggregates) would be needed but were not obtained", "polarity": "would_have", "targets": ["referee bias measurement"], "confidence": "high", "shares_lines_with": []}, {"id": 162, "kind": "claim", "lines": [[241, 241]], "assertion": "a within-referee fixed-effects analysis would be needed but was not performed", "polarity": "would_have", "targets": ["within-referee analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[242, 242]], "assertion": "experimental or quasi-experimental designs would be needed but were not used", "polarity": "would_have", "targets": ["experimental design"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "claim", "lines": [[243, 243]], "assertion": "mechanism studies investigating mediation pathways would be needed but were not conducted", "polarity": "would_have", "targets": ["mechanism studies"], "confidence": "high", "shares_lines_with": []}, {"id": 165, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[244, 246]], "note": "section divider"}, {"id": 166, "kind": "nonclaim", "subtype": "heading", "lines": [[247, 248]], "note": "Reproducibility Statement heading"}, {"id": 167, "kind": "claim", "lines": [[249, 249]], "assertion": "the analysis is fully reproducible from the provided dataset and code", "polarity": "did", "targets": ["reproducibility"], "confidence": "medium", "shares_lines_with": []}, {"id": 168, "kind": "claim", "lines": [[250, 250]], "assertion": "data used was /workspace/data/soccer/soccer.csv (N=146,028 dyads)", "polarity": "did", "