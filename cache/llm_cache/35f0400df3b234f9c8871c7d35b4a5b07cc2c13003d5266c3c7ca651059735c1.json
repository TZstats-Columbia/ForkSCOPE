 "nonclaim", "subtype": "heading", "lines": [[149, 151]], "note": "Analytical Limitations heading"}, {"id": 97, "kind": "claim", "lines": [[152, 152]], "assertion": "only 200 bootstrap iterations were run due to computational constraints (~30-45s each), judged generally adequate for CI estimation despite standard practice being 1000+", "polarity": "did", "targets": ["bootstrap"], "confidence": "high", "shares_lines_with": []}, {"id": 98, "kind": "nonclaim", "subtype": "other", "lines": [[153, 153]], "note": "blank line"}, {"id": 99, "kind": "claim", "lines": [[154, 154]], "assertion": "the analysis did not account for clustering/correlation of dyads within the same player or referee", "polarity": "did_not", "targets": ["clustering", "standard errors"], "confidence": "high", "shares_lines_with": [100]}, {"id": 100, "kind": "claim", "lines": [[154, 154]], "assertion": "a multilevel model would have been more appropriate but was not feasible", "polarity": "would_have", "targets": ["multilevel model"], "confidence": "high", "shares_lines_with": [99]}, {"id": 101, "kind": "nonclaim", "subtype": "other", "lines": [[155, 155]], "note": "blank line"}, {"id": 102, "kind": "claim", "lines": [[156, 156]], "assertion": "no adjustment was made for multiple testing", "polarity": "did_not", "targets": ["multiple testing"], "confidence": "high", "shares_lines_with": [103]}, {"id": 103, "kind": "claim", "lines": [[156, 156]], "assertion": "the primary and secondary estimands were pre-specified", "polarity": "did", "targets": ["pre-specification"], "confidence": "high", "shares_lines_with": [102]}, {"id": 104, "kind": "nonclaim", "subtype": "other", "lines": [[157, 157]], "note": "blank line"}, {"id": 105, "kind": "claim", "lines": [[158, 158]], "assertion": "the medium skin tone category was excluded to maximize contrast between light and dark groups", "polarity": "did", "targets": ["medium skin tone"], "confidence": "high", "shares_lines_with": [106]}, {"id": 106, "kind": "claim", 