 "nonclaim", "subtype": "heading", "lines": [[186, 188]], "note": "External Validity heading"}, {"id": 116, "kind": "nonclaim", "subtype": "hedging", "lines": [[189, 192]], "note": "generalizability caveats: single season, four European leagues, male-only, professional-only"}, {"id": 117, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[193, 195]], "note": "section divider"}, {"id": 118, "kind": "nonclaim", "subtype": "heading", "lines": [[196, 197]], "note": "Descriptive Statistics heading"}, {"id": 119, "kind": "nonclaim", "subtype": "heading", "lines": [[198, 198]], "note": "Sample Composition heading"}, {"id": 120, "kind": "claim", "lines": [[199, 201]], "assertion": "the final analytic sample comprises 104,972 dyads: 89,107 (84.8%) light skin and 15,990 (15.2%) dark skin", "polarity": "found", "targets": ["sample composition"], "confidence": "high", "shares_lines_with": []}, {"id": 121, "kind": "nonclaim", "subtype": "other", "lines": [[202, 202]], "note": "blank line"}, {"id": 122, "kind": "nonclaim", "subtype": "heading", "lines": [[203, 203]], "note": "Red Card Rates heading"}, {"id": 123, "kind": "claim", "lines": [[204, 209]], "assertion": "unadjusted red card rates were 1.23% for light-skin and 1.41% for dark-skin dyads, an unadjusted risk difference of +0.18pp", "polarity": "found", "targets": ["red card rate", "unadjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 124, "kind": "nonclaim", "subtype": "other", "lines": [[210, 210]], "note": "blank line"}, {"id": 125, "kind": "nonclaim", "subtype": "heading", "lines": [[211, 211]], "note": "Player Characteristics heading"}, {"id": 126, "kind": "claim", "lines": [[212, 217]], "assertion": "light- and dark-skinned players had similar average games/dyad, age, height, and weight", "polarity": "found", "targets": ["player characteristics"], "confidence": "high", "shares_lines_with": []}, {"id": 127, "kind": "nonclaim", "subtype": "other", "lines": [[218, 218]], "note": "blank line"}, {"id": 128, "kind": "nonclaim", "subtype": "heading", "lines": [[219, 219]], "note": "Position Distribution heading"}, {"id": 129, "kind": "claim", "lines": [[220, 225]], "assertion": "position distribution differs by skin tone, e.g., forwards 12.6% (light) vs 23.5% (dark), goalkeepers 11.7% (light) vs 2.3% (dark)", "polarity": "found", "targets": ["position distribution"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "nonclaim", "subtype": "other", "lines": [[226, 226]], "note": "blank line"}, {"id": 131, "kind": "claim", "lines": [[227, 227]], "assertion": "dark-skinned players being more often forwards and less often goalkeepers could partly explain red-card-rate differences if not fully controlled", "polarity": "found", "targets": ["position", "confounding"], "confidence": "medium", "shares_lines_with": []}, {"id": 132, "kind": "nonclaim", "subtype": "other", "lines": [[228, 228]], "note": "blank line"}, {"id": 133, "kind": "nonclaim", "subtype": "heading", "lines": [[229, 229]], "note": "League Distribution heading"}, {"id": 134, "kind": "claim", "lines": [[230, 235]], "assertion": "league distribution differs by skin tone, e.g., England 24.0% (light) vs 37.8% (dark), Spain 28.2% (light) vs 13.2% (dark)", "polarity": "found", "targets": ["league distribution"], "confidence": "high", "shares_lines_with": []}, {"id": 135, "kind": "nonclaim", "subtype": "other", "lines": [[236, 236]], "note": "blank line"}, {"id": 136, "kind": "claim", "lines": [[237, 237]], "assertion": "dark-skinned players are more concentrated in the English and French leagues", "polarity": "found", "targets": ["league distribution"], "confidence": "high", "shares_lines_with": []}, {"id": 137, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[238, 240]], "note": "section divider"}, {"id": 138, "kind": "nonclaim", "subtype": "heading", "lines": [[241, 242]], "note": "Key Model Coefficients heading"}, {"id": 139, "kind": "nonclaim", "subtype": "framing", "lines": [[243, 243]], "note": "lead-in to coefficients table"}, {"id": 140, "kind": "nonclaim", "subtype": "other", "lines": [[244, 244]], "note": "blank line"}, {"id": 141, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[245, 246]], "note": "table header rows"}, {"id": 142, "kind": "claim", "lines": [[247, 247]], "assertion": "the dark-skin coefficient in the logistic model is 0.190 (SE 0.080, p=0.017), corresponding to +21% odds of red card", "polarity": "found", "targets": ["dark skin coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "claim", "lines": [[248, 259]], "assertion": "other coefficients found: games played strongly positive (p<.001); age/height not significant; weight borderline positive; defender strongly positive vs midfielder (p<.001); forward/goalkeeper not significant; France higher than Spain (p<.001); Germany not significant vs Spain; referee IAT positively associated (p=0.020); referee explicit bias borderline negative (p=0.070)", "polarity": "found", "targets": ["model coefficients"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "nonclaim", "subtype": "other", "lines": [[260, 260]], "note": "blank line"}, {"id": 145, "kind": "claim", "lines": [[261, 266]], "assertion": "key findings summarized: dark skin remains significant after adjustment, defenders receive more red cards, games played is the strongest predictor, referee implicit bias predicts red cards independent of skin tone, and physical characteristics are not strong predictors", "polarity": "found", "targets": ["model coefficients summary"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[267, 269]], "note": "section divider"}, {"id": 147, "kind": "nonclaim", "subtype": "heading", "lines": [[270, 271]], "note": "Summary of Evidence heading"}, {"id": 148, "kind": "claim", "lines": [[272, 277]], "assertion": "evidence is summarized as consistent direction of increased risk, modest absolute but meaningful relative magnitude, imprecise but nonzero-excluding CI, borderline-to-significant p-values, robustness to adjustment, and consistency of unadjusted/adjusted estimates", "polarity": "found", "targets": ["summary of evidence"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "nonclaim", "subtype": "other", "lines": [[278, 278]], "note": "blank line"}, {"id": 150, "kind": "claim", "lines": [[279, 279]], "assertion": "the overall conclusion is that the preponderance of evidence supports the hypothesis, though causal interpretation should be cautious given borderline significance and lack of behavioral controls, with implicit bias and unmeasured confounding both remaining possible explanations", "polarity": "found", "targets": ["hypothesis", "causal interpretation"], "confidence": "high", "shares_lines_with": []}, {"id": 151, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[280, 282]], "note": "section divider"}, {"id": 152, "kind": "nonclaim", "subtype": "heading", "lines": [[283, 284]], "note": "Reproducibility heading"}, {"id": 153, "kind": "claim", "lines": [[285, 285]], "assertion": "the analysis is claimed to be fully reproducible via the provided Python script and dataset", "polarity": "did", "targets": ["reproducibility"], "confidence": "medium", "shares_lines_with": []}, {"id": 154, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[286, 291]], "note": "list of script components"}, {"id": 155, "kind": "nonclaim", "subtype": "other", "lines": [[292, 292]], "note": "blank line"}, {"id": 156, "kind": "claim", "lines": [[293, 293]], "assertion": "the random seed was set to 42 for reproducibility of bootstrap results", "polarity": "did", "targets": ["random seed", "bootstrap"], "confidence": "high", "shares_lines_with": []}]}}