ts": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 44, "kind": "nonclaim", "subtype": "other", "lines": [[78, 78]], "note": "blank line"}, {"id": 45, "kind": "claim", "lines": [[79, 82]], "assertion": "the adjusted risk difference was estimated via g-computation (marginal standardization): predicting outcome probabilities under counterfactual all-dark-skin and all-light-skin scenarios and differencing the means", "polarity": "did", "targets": ["risk difference", "g-computation"], "confidence": "high", "shares_lines_with": []}, {"id": 46, "kind": "nonclaim", "subtype": "other", "lines": [[83, 83]], "note": "blank line"}, {"id": 47, "kind": "claim", "lines": [[84, 84]], "assertion": "standard errors and 95% CIs were obtained via nonparametric bootstrap with 200 resamples using the percentile method", "polarity": "did", "targets": ["bootstrap", "confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 48, "kind": "nonclaim", "subtype": "other", "lines": [[85, 85]], "note": "blank line"}, {"id": 49, "kind": "nonclaim", "subtype": "heading", "lines": [[86, 86]], "note": "Exclusions heading"}, {"id": 50, "kind": "nonclaim", "subtype": "other", "lines": [[87, 87]], "note": "blank line / lead-in restating total N"}, {"id": 51, "kind": "claim", "lines": [[88, 89]], "assertion": "21,407 dyads (14.7%) were excluded from the original 146,028 due to missing skin tone/photo data", "polarity": "did", "targets": ["exclusions", "missing skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 52, "kind": "claim", "lines": [[90, 90]], "assertion": "11,406 dyads (7.8%) were excluded for having medium skin tone, for clearer contrast", "polarity": "did", "targets": ["exclusions", "medium skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 53, "kind": "claim", "lines": [[91, 91]], "assertion": "8,118 dyads (5.6%) were excluded due to missing covariates (position, age, height, weight)", "polarity": "did", "targets": ["exclusions", "missing covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 54, "kind": "claim", "lines": [[92, 92]], "assertion": "the final analytical sample was 105,097 dyads, with 104,972 used in the model after also dropping 125 dyads with missing bias measures", "polarity": "did", "targets": ["final sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 55, "kind": "nonclaim", "subtype": "other", "lines": [[93, 93]], "note": "blank line"}, {"id": 56, "kind": "nonclaim", "subtype": "heading", "lines": [[94, 94]], "note": "Transformations heading"}, {"id": 57, "kind": "claim", "lines": [[95, 95]], "assertion": "skin tone ratings were averaged across the two raters", "polarity": "did", "targets": ["skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 58, "kind": "claim", "lines": [[96, 96]], "assertion": "skin tone was dichotomized into light vs. dark, excluding medium", "polarity": "did", "targets": ["skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 59, "kind": "claim", "lines": [[97, 97]], "assertion": "continuous covariates were standardized into z-scores", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 60, "kind": "claim", "lines": [[98, 98]], "assertion": "position categories were collapsed from 12 specific positions into 4 broad categories", "polarity": "did", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 61, "kind": "claim", "lines": [[99, 99]], "assertion": "player age was calculated from birthdate to the season midpoint of January 1, 2013", "polarity": "did", "targets": ["age"], "confidence": "high", "shares_lines_with": []}, {"id": 62, "kind": "nonclaim", "subtype": "other", "lines": [[100, 100]], "note": "blank line"}, {"id": 63, "kind": "nonclaim", "subtype": "heading", "lines": [[101, 101]], "note": "Model Diagnostics heading"}, {"id": 64, "kind": "claim", "lines": [[102, 105]], "assertion": "model diagnostics: log-likelihood -6593.80, pseudo R² 0.071, converged in 9 iterations with no convergence issues", "polarity": "found", "targets": ["model diagnostics"], "confidence": "high", "shares_lines_with": []}, {"id": 65, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[106, 108]], "note": "section divider"}, {"id": 66, "kind": "nonclaim", "subtype": "heading", "lines": [[109, 110]], "note": "Conclusion heading"}, {"id": 67, "kind": "claim", "lines": [[111, 111]], "assertion": "the hypothesis is concluded to be supported, though at the boundary of conventional statistical significance", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": []}, {"id": 68, "kind": "nonclaim", "subtype": "other", "lines": [[112, 112]], "note": "blank line"}, {"id": 69, "kind": "nonclaim", "subtype": "heading", "lines": [[113, 114]], "note": "Justification heading"}, {"id": 70, "kind": "claim", "lines": [[115, 115]], "assertion": "both the adjusted risk difference (+0.25pp) and odds ratio (1.21) point toward higher red card rates for dark-skinned players", "polarity": "found", "targets": ["risk difference", "odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 71, "kind": "nonclaim", "subtype": "other", "lines": [[116, 116]], "note": "blank line"}, {"id": 72, "kind": "claim", "lines": [[117, 120]], "assertion": "statistical significance is summarized as: RD p=0.050 exactly at the threshold, OR p=0.017 clearly significant, and the bootstrap CI for RD barely excludes zero", "polarity": "found", "targets": ["p-value", "confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 73, "kind": "nonclaim", "subtype": "other", "lines": [[121, 121]], "note": "blank line"}, {"id": 74, "kind": "claim", "lines": [[122, 122]], "assertion": "the absolute risk increase is judged modest but, relative to the low base rate, represents a meaningful ~20% relative increase", "polarity": "found", "targets": ["effect magnitude"], "confidence": "high", "shares_lines_with": []}, {"id": 75, "kind": "nonclaim", "subtype": "other", "lines": [[123, 123]], "note": "blank line"}, {"id": 76, "kind": "claim", "lines": [[124, 124]], "assertion": "the unadjusted risk difference (0.18pp) is similar to the adjusted estimate (0.25pp), suggesting the association is not driven by confounding", "polarity": "found", "targets": ["risk difference", "confounding"], "confidence": "high", "shares_lines_with": []}, {"id": 77, "kind": "nonclaim", "subtype": "other", "lines": [[125, 125]], "note": "blank line"}, {"id": 78, "kind": "claim", "lines": [[126, 126]], "assertion": "the finding is judged robust because it holds after controlling for games played, player characteristics, position, league, and referee country bias measures", "polarity": "found", "targets": ["robustness"], "confidence": "medium", "shares_lines_with": []}, {"id": 79, "kind": "nonclaim", "subtype": "heading", "lines": [[127, 129]], "note": "Caveats and Interpretation heading"}, {"id": 80, "kind": "claim", "lines": [[130, 130]], "assertion": "the bootstrap p-value of exactly 0.05 is treated as borderline/uncertain because only 200 bootstrap samples were used", "polarity": "found", "targets": ["p-value", "bootstrap"], "confidence": "medium", "shares_lines_with": [81]}, {"id": 81, "kind": "claim", "lines": [[130, 130]], "assertion": "a larger bootstrap (1000+ samples) would have been preferred for a more definitive result but was computationally prohibitive", "polarity": "would_have", "targets": ["bootstrap"], "confidence": "high", "shares_lines_with": [80]}, {"id": 82, "kind": "nonclaim", "subtype": "other", "lines": [[131, 131]], "note": "blank line"}, {"id": 83, "kind": "claim", "lines": [[132, 132]], "assertion": "the risk-difference CI's lower bound (0.016pp) being close to zero indicates substantial uncertainty about the effect's magnitude", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_