d": 136, "kind": "claim", "lines": [[157, 157]], "assertion": "adjustment was made for key observables (position, league, exposure) to address confounding", "polarity": "did", "targets": ["confounding"], "confidence": "medium", "shares_lines_with": []}, {"id": 137, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[158, 158]], "note": "blank line"}, {"id": 138, "kind": "claim", "lines": [[159, 159]], "assertion": "delta method SEs do not account for clustering within players or referees; a clustered bootstrap was not implemented due to computational intensity", "polarity": "did_not", "targets": ["clustered bootstrap"], "confidence": "high", "shares_lines_with": []}, {"id": 139, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[160, 160]], "note": "blank line"}, {"id": 140, "kind": "claim", "lines": [[161, 161]], "assertion": "players without photos (14.7%) were excluded from the sample", "polarity": "did", "targets": ["photo availability"], "confidence": "high", "shares_lines_with": [141]}, {"id": 141, "kind": "claim", "lines": [[161, 161]], "assertion": "an exploratory (unreported) check found players without photos have slightly lower red card rates (1.08% vs 1.26%), suggesting conservative bias", "polarity": "found", "targets": ["photo availability"], "confidence": "medium", "shares_lines_with": [140]}, {"id": 142, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[162, 162]], "note": "blank line"}, {"id": 143, "kind": "claim", "lines": [[163, 163]], "assertion": "two independent blind raters were used and averaged to mitigate skin tone measurement error", "polarity": "did", "targets": ["rater1", "rater2"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[164, 164]], "note": "blank line"}, {"id": 145, "kind": "claim", "lines": [[165, 165]], "assertion": "multiple specifications were explored but only the most supportive one is reported", "polarity": "did", "targets": ["specification search"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[166, 166]], "note": "blank line"}, {"id": 147, "kind": "nonclaim", "subtype": "heading", "lines": [[167, 167]], "note": "Most Favorable Assumptions subheading"}, {"id": 148, "kind": "claim", "lines": [[168, 168]], "assertion": "assumed no unmeasured confounding conditional on position, league, games, and referee bias", "polarity": "did", "targets": ["assumptions"], "confidence": "medium", "shares_lines_with": []}, {"id": 149, "kind": "claim", "lines": [[169, 169]], "assertion": "assumed no measurement error in skin tone ratings", "polarity": "did", "targets": ["assumptions"], "confidence": "medium", "shares_lines_with": []}, {"id": 150, "kind": "claim", "lines": [[170, 170]], "assertion": "assumed independent observations, i.e. no clustering", "polarity": "did", "targets": ["assumptions"], "confidence": "medium", "shares_lines_with": []}, {"id": 151, "kind": "claim", "lines": [[171, 171]], "assertion": "assumed linear effects of log(games) and continuous covariates", "polarity": "did", "targets": ["assumptions"], "confidence": "medium", "shares_lines_with": []}, {"id": 152, "kind": "claim", "lines": [[172, 172]], "assertion": "assumed no effect modification by league or position, i.e. an additive model on the log-odds scale", "polarity": "did", "targets": ["assumptions"], "confidence": "medium", "shares_lines_with": []}, {"id": 153, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[173, 173]], "note": "blank line"}, {"id": 154, "kind": "claim", "lines": [[174, 174]], "assertion": "violations of these assumptions would generally attenuate the estimated effect toward zero", "polarity": "found", "targets": ["assumptions"], "confidence": "low", "shares_lines_with": []}, {"id": 155, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[175, 177]], "note": "blank/separator/blank"}, {"id": 156, "kind": "nonclaim", "subtype": "heading", "lines": [[178, 179]], "note": "Section 6 heading + blank"}, {"id": 157, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[180, 181]], "note": "descriptive statistics table header/separator row"}, {"id": 158, "kind": "claim", "lines": [[182, 188]], "assertion": "descriptive statistics table: dark-skin (N=17,490) vs light-skin (N=90,116) groups compared on mean games, yellow cards, red cards, height, weight, and any-red-card percentage (1.418% vs 1.216%)", "polarity": "found", "targets": ["dark skin", "light skin"], "confidence": "high", "shares_lines_with": []}, {"id": 159, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[189, 189]], "note": "blank line"}, {"id": 160, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[190, 190]], "note": "\"Key observations:\" label"}, {"id": 161, "kind": "claim", "lines": [[191, 191]], "assertion": "dark-skinned players are more likely to play offensive positions (23% center forwards) vs light-skinned players, who are more often center backs and goalkeepers", "polarity": "found", "targets": ["player position"], "confidence": "high", "shares_lines_with": []}, {"id": 162, "kind": "claim", "lines": [[192, 192]], "assertion": "dark-skinned players are overrepresented in England and France; light-skinned players in Germany and Spain", "polarity": "found", "targets": ["league country"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[193, 193]], "assertion": "unadjusted red card rate is 0.20pp higher for dark-skinned players, adjusted rate is 0.29pp higher, indicating confounding by position/league attenuates the crude effect", "polarity": "found", "targets": ["red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[194, 196]], "note": "blank/separator/blank"}, {"id": 165, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 198]], "note": "Section 7 heading + blank"}, {"id": 166, "kind": "nonclaim", "subtype": "framing", "lines": [[199, 199]], "note": "framing statement introducing the conclusion basis"}, {"id": 167, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[200, 200]], "note": "blank line"}, {"id": 168, "kind": "claim", "lines": [[201, 201]], "assertion": "overall conclusion is that the hypothesis is SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 169, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[202, 202]], "note": "blank line"}, {"id": 170, "kind": "claim", "lines": [[203, 203]], "assertion": "the hypothesis that referees give more red cards to dark-skinned than light-skinned players is SUPPORTED by this in-sample, exploratory analysis", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 171, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[204, 204]], "note": "blank line"}, {"id": 172, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[205, 205]], "note": "\"Evidence summary:\" label"}, {"id": 173, "kind": "claim", "lines": [[206, 206]], "assertion": "primary analysis: adjusted risk difference 0.293pp [0.084,0.502], p=0.006, excludes zero", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[207, 207]], "assertion": "effect size is a 24% relative increase in red card probability", "polarity": "found", "targets": ["effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[208, 208]], "assertion": "robustness: consistent positive effects across 4 alternative specifications, all p<0.01", "polarity": "found", "targets": ["robustness checks"], "confidence": "high", "shares_lines_with": []}, {"id": 176, "kind": "claim", "lines": [[209, 209]], "assertion": "dose-response: monotone linear gradient with continuous skin tone, OR=1.36 per unit, p=0.001", "polarity": "found", "targets": ["dose-response"], "confidence": "high", "shares_lines_with": []}, {"id": 177, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[210, 210]], "note": "blank line"}, {"id": 178, "kind": "claim", "lines": [[211, 211]], "assertion": "strength of evidence is characterized as moderately strong and directionally consistent, small in absolute terms but meaningful in relative terms given the low red-card base rate", "polarity": "found", "targets": ["strength of evidence"], "confidence": "medium", "shares_lines_with": []}, {"id": 179, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[212, 212]], "note": "blank line"}, {"id": 180, "kind": "claim", "lines": [[213, 213]], "assertion": "the favorable modeling choices (extreme comparison, no clustering adjustment) were selected to maximize in-sample support and may overstate the true effect", "polarity": "did", "targets": ["modeling choices"], "confidence": "high", "shares_lines_with": []}, {"id": 181, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[214, 214]], "note": "blank line"}, {"id": 182, "kind": "claim", "lines": [[215, 215]], "assertion": "recommends preregistered confirmatory analysis, investigation of mechanisms, and policy discussion on referee bias training", "polarity": "did", "targets": ["recommendation"], "confidence": "medium", "shares_lines_with": []}, {"id": 183, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[216, 218]], "note": "blank/separator/blank"}, {"id": 184, "kind": "nonclaim", "subtype": "heading", "lines": [[219, 220]], "note": "Section 8 heading + blank"}, {"id": 185, "kind": "claim", "lines": [[221, 221]], "assertion": "all analyses are reproducible via the provided Python script (final_analysis.py), generating identical results with seed 42", "polarity": "did", "targets": ["reproducibility"], "confidence": "high", "shares_lines_with": []}, {"id": 186, "kind": "claim", "lines": [[222, 222]], "assertion": "script includes data loading and quality control with documented exclusions", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 187, "kind": "claim", "lines": [[223, 223]], "assertion": "script includes variable construction and transformations", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 188, "kind": "claim", "lines": [[224, 224]], "assertion": "script includes primary and robustness analyses with full model specifications", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 189, "kind": "claim", "lines": [[225, 225]], "assertion": "script includes delta method standard errors and confidence intervals", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 190, "kind": "claim", "lines": [[226, 226]], "assertion": "script includes comprehensive output with interpretation", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 191, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[227, 227]], "note": "blank line"}, {"id": 192, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 229]], "note": "reproduction instruction + blank line"}, {"id": 193, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[230, 231]], "note": "separator + blank line"}, {"id": 194, "kind": "nonclaim", "subtype": "heading", "lines": [[232, 233]], "note": "Appendix heading + blank"}, {"id": 195, "kind": "nonclaim", "subtype": "heading", "lines": [[234, 234]], "note": "Delta Method Details subheading"}, {"id": 196, "kind": "claim", "lines": [[235, 235]], "assertion": "the delta method approximates the variance of a nonlinear function of parameters using a first-order Taylor expansion", "polarity": "did", "targets": ["delta method"], "confidence": "low", "shares_lines_with": []}, {"id": 197, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[236, 236]], "note": "blank line"}, {"id": 198, "kind": "nonclaim", "subtype": "background", "lines": [[237, 237]], "note": "variance formula notation"}, {"id": 199, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[238, 238]], "note": "blank line"}, {"id": 200, "kind": "nonclaim", "subtype": "background", "lines": [[239, 239]], "note": "definition of g(theta) and theta"}, {"id": 201, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[240, 240]], "note": "blank line"}, {"id": 202, "kind": "claim", "lines": [[241, 241]], "assertion": "the gradient was computed numerically via finite differences (epsilon=10^-6) using the variance-covariance matrix from the MLE", "polarity": "did", "targets": ["delta method"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[242, 242]], "note": "blank line"}, {"id": 204, "kind": "nonclaim", "subtype": "heading", "lines": [[243, 243]], "note": "Why Not Clustering? subheading"}, {"id": 205, "kind": "claim", "lines": [[244, 244]], "assertion": "chose not to cluster standard errors despite correlation within players and within referees", "polarity": "did_not", "targets": ["clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 206, "kind": "claim", "lines": [[245, 245]], "assertion": "reason 1 for not clustering: exploratory framing aims to characterize in-sample support, not formal inference for a population", "polarity": "did_not", "targets": ["clustering rationale"], "confidence": "medium", "shares_lines_with": []}, {"id": 207, "kind": "claim", "lines": [[246, 246]], "assertion": "estimated clustering would increase SEs by ~30-50% and could make results non-significant, though it would not change the fundamental positive finding", "polarity": "found", "targets": ["clustering rationale"], "confidence": "medium", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[247, 247]], "note": "blank line"}, {"id": 209, "kind": "claim", "lines": [[24