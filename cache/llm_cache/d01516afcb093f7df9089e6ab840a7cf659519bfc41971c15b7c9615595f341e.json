e": "medium", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[227, 227]], "assertion": "all exclusions, transformations, and assumptions were transparently documented", "polarity": "did", "targets": ["reporting"], "confidence": "medium", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[228, 228]], "assertion": "red cards are objective events recorded in official match data", "polarity": "found", "targets": ["outcome measurement"], "confidence": "medium", "shares_lines_with": []}, {"id": 176, "kind": "claim", "lines": [[229, 229]], "assertion": "two independent skin tone raters were averaged for the exposure measure", "polarity": "did", "targets": ["skin tone raters"], "confidence": "high", "shares_lines_with": []}, {"id": 177, "kind": "claim", "lines": [[230, 230]], "assertion": "multiple potential confounders were controlled for, including implicit bias", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 178, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[231, 233]], "note": "separator"}, {"id": 179, "kind": "nonclaim", "subtype": "heading", "lines": [[234, 235]], "note": "Recommendations heading"}, {"id": 180, "kind": "nonclaim", "subtype": "other", "lines": [[236, 236]], "note": "forward-looking recommendation to analyze at match level instead of aggregated dyads, not a claim about this analysis"}, {"id": 181, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[237, 237]], "note": "blank line"}, {"id": 182, "kind": "nonclaim", "subtype": "other", "lines": [[238, 238]], "note": "recommendation for individual-level referee bias measurement"}, {"id": 183, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[239, 239]], "note": "blank line"}, {"id": 184, "kind": "nonclaim", "subtype": "other", "lines": [[240, 240]], "note": "recommendation to analyze infraction types/severity"}, {"id": 185, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[241, 241]], "note