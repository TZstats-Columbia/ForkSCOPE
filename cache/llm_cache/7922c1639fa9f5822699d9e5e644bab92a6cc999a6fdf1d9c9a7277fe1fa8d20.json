claim", "subtype": "hedging", "lines": [[174, 174]], "note": "effective α could exceed 0.05 if unreported analyses occurred"}, {"id": 159, "kind": "nonclaim", "subtype": "other", "lines": [[175, 175]], "note": "blank line"}, {"id": 160, "kind": "nonclaim", "subtype": "heading", "lines": [[176, 176]], "note": "Publication Bias subheading"}, {"id": 161, "kind": "nonclaim", "subtype": "other", "lines": [[177, 177]], "note": "blank line"}, {"id": 162, "kind": "nonclaim", "subtype": "hedging", "lines": [[178, 178]], "note": "unclear whether hypothesis was pre-registered or post-hoc"}, {"id": 163, "kind": "nonclaim", "subtype": "other", "lines": [[179, 179]], "note": "blank line"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[180, 180]], "note": "researcher degrees of freedom in thresholds/covariates/specification only partially addressed"}, {"id": 165, "kind": "nonclaim", "subtype": "other", "lines": [[181, 181]], "note": "blank line"}, {"id": 166, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[182, 183]], "note": "rule + blank"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[184, 185]], "note": "Discussion heading"}, {"id": 168, "kind": "nonclaim", "subtype": "heading", "lines": [[186, 187]], "note": "Interpretation and Context subheading"}, {"id": 169, "kind": "nonclaim", "subtype": "background", "lines": [[188, 188]], "note": "links finding to broader social science literature on implicit bias in subjective decisions"}, {"id": 170, "kind": "nonclaim", "subtype": "other", "lines": [[189, 189]], "note": "blank line"}, {"id": 171, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[190, 190]], "note": "\"Effect size in context:\" label"}, {"id": 172, "kind": "claim", "lines": [[191, 191]], "assertion": "the 0.25pp increase is small in absolute terms but meaningful in relative terms (21% increase)", "polarity": "found", "targets": ["effect size"], "confidence": "high"}, {"id": 173, "kind": "nonclaim", "subtype": "framing", "lines": [[192, 192]], "note": "reasoning that small absolute differences accumulate given rarity of red cards"}, {"id": 174, "kind": "nonclaim", "subtype": "framing", "lines": [[193, 193]], "note": "reasoning that red cards' high stakes make subtle biases matter"}, {"id": 175, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "blank line"}, {"id": 176, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[195, 195]], "note": "\"Alternative explanations:\" label"}, {"id": 177, "kind": "nonclaim", "subtype": "hedging", "lines": [[196, 196]], "note": "possible behavioral differences (fouls/dissent) independent of bias, not ruled out"}, {"id": 178, "kind": "nonclaim", "subtype": "hedging", "lines": [[197, 197]], "note": "position adjustment may be imperfect; residual confounding could remain"}, {"id": 179, "kind": "claim", "lines": [[198, 198]], "assertion": "dark-skinned players are more prevalent in the France and England leagues, which could confound the league-adjusted estimate", "polarity": "found", "targets": ["league", "dark-skinned players"], "confidence": "medium"}, {"id": 180, "kind": "nonclaim", "subtype": "other", "lines": [[199, 199]], "note": "blank line"}, {"id": 181, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[200, 200]], "note": "\"Consistency with implicit bias mechanism:\" label"}, {"id": 182, "kind": "claim", "lines": [[201, 201]], "assertion": "no interaction was found between country-level IAT scores and the skin-tone effect, which is surprising under an implicit-bias mechanism", "polarity": "found", "targets": ["country-level IAT scores"], "confidence": "high"}, {"id": 183, "kind": "nonclaim", "subtype": "hedging", "lines": [[202, 202]], "note": "country-level aggregates may not reflect individual referee bias"}, {"id": 184, "kind": "nonclaim", "subtype": "hedging", "lines": [[203, 203]], "note": "IAT scores may not predict behavior in specific contexts"}, {"id": 185, "kind": "nonclaim", "subtype": "hedging", "lines": [[204, 204]], "note": "other bias mechanisms could operate independently of IAT scores"}, {"id": 186, "kind": "nonclaim", "subtype": "other", "lines": [[205, 205]], "note": "blank line"}, {"id": 187, "kind": "nonclaim", "subtype": "heading", "lines": [[206, 207]], "note": "Recommendations for Future Research subheading"}, {"id": 188, "kind": "nonclaim", "subtype": "other", "lines": [[208, 213]], "note": "list of six suggested future studies; not claims about this analysis"}, {"id": 189, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[214, 216]], "note": "blank/rule/blank"}, {"id": 190, "kind": "nonclaim", "subtype": "heading", "lines": [[217, 218]], "note": "Methodological Strengths heading"}, {"id": 191, "kind": "nonclaim", "subtype": "framing", "lines": [[219, 220]], "note": "transition line into strengths list + blank"}, {"id": 192, "kind": "claim", "lines": [[221, 221]], "assertion": "the large sample size (107,606 dyads) provides high statistical power to detect small effects", "polarity": "found", "targets": ["sample size"], "confidence": "high"}, {"id": 193, "kind": "claim", "lines": [[222, 222]], "assertion": "the model controls for position, league, and exposure as key confounders", "polarity": "did", "targets": ["covariate adjustment"], "confidence": "high"}, {"id": 194, "kind": "claim", "lines": [[223, 223]], "assertion": "clustered standard errors were used, accounting for within-player correlation", "polarity": "did", "targets": ["standard errors"], "confidence": "high"}, {"id": 195, "kind": "claim", "lines": [[224, 224]], "assertion": "sensitivity analyses (continuous skin tone, implicit bias interactions) were conducted", "polarity": "did", "targets": ["sensitivity analyses"], "confidence": "high"}, {"id": 196, "kind": "claim", "lines": [[225, 225]], "assertion": "all exclusions, transformations, and modeling choices were documented for reproducibility", "polarity": "did", "targets": ["reporting"], "confidence": "high"}, {"id": 