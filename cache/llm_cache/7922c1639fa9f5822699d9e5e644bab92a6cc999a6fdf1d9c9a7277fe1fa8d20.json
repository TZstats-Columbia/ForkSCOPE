": "found", "targets": ["practical significance"], "confidence": "medium", "shares_lines_with": [130]}, {"id": 132, "kind": "nonclaim", "subtype": "other", "lines": [[148, 148]], "note": "blank line"}, {"id": 133, "kind": "claim", "lines": [[149, 149]], "assertion": "the effect is in the hypothesized direction, with dark-skinned players at higher risk", "polarity": "found", "targets": ["direction of effect"], "confidence": "high"}, {"id": 134, "kind": "nonclaim", "subtype": "other", "lines": [[150, 150]], "note": "blank line"}, {"id": 135, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[151, 152]], "note": "\"Skeptical Assessment:\" label + blank"}, {"id": 136, "kind": "nonclaim", "subtype": "framing", "lines": [[153, 153]], "note": "intro to caveats list"}, {"id": 137, "kind": "nonclaim", "subtype": "other", "lines": [[154, 154]], "note": "blank line"}, {"id": 138, "kind": "claim", "lines": [[155, 155]], "assertion": "the 0.25pp difference is modest in absolute terms though statistically significant given the large sample size", "polarity": "found", "targets": ["effect size"], "confidence": "high"}, {"id": 139, "kind": "nonclaim", "subtype": "other", "lines": [[156, 156]], "note": "blank line"}, {"id": 140, "kind": "nonclaim", "subtype": "hedging", "lines": [[157, 157]], "note": "residual confounding from unmeasured factors possible despite adjustment"}, {"id": 141, "kind": "nonclaim", "subtype": "other", "lines": [[158, 158]], "note": "blank line"}, {"id": 142, "kind": "nonclaim", "subtype": "hedging", "lines": [[159, 159]], "note": "subjective skin tone coding could introduce measurement error/bias"}, {"id": 143, "kind": "nonclaim", "subtype": "other", "lines": [[160, 160]], "note": "blank line"}, {"id": 144, "kind": "nonclaim", "subtype": "hedging", "lines": [[161, 161]], "note": "p-value near threshold; stricter α would flip significance"}, {"id": 145, "kind": "nonclaim", "subtype": "other", "lines": [[162, 162]], "note": "blank line"}, {"id": 146, "ki