im", "lines": [[82, 82]], "assertion": "maximum likelihood estimation with a robust (clustered) covariance matrix was used", "polarity": "did", "targets": ["estimation method"], "confidence": "high"}, {"id": 72, "kind": "nonclaim", "subtype": "other", "lines": [[83, 83]], "note": "blank line"}, {"id": 73, "kind": "nonclaim", "subtype": "heading", "lines": [[84, 84]], "note": "Covariates Included subheading"}, {"id": 74, "kind": "nonclaim", "subtype": "other", "lines": [[85, 85]], "note": "blank line"}, {"id": 75, "kind": "claim", "lines": [[86, 87]], "assertion": "player position (13 listed categories plus missing) was included as a covariate", "polarity": "did", "targets": ["position"], "confidence": "high"}, {"id": 76, "kind": "nonclaim", "subtype": "framing", "lines": [[88, 88]], "note": "rationale for including position: positions may differ in foul propensity"}, {"id": 77, "kind": "nonclaim", "subtype": "other", "lines": [[89, 89]], "note": "blank line"}, {"id": 78, "kind": "claim", "lines": [[90, 91]], "assertion": "league country (4 categories: England, France, Germany, Spain) was included as a covariate", "polarity": "did", "targets": ["league"], "confidence": "high"}, {"id": 79, "kind": "nonclaim", "subtype": "framing", "lines": [[92, 92]], "note": "rationale for including league: refereeing standards may vary by league"}, {"id": 80, "kind": "nonclaim", "subtype": "other", "lines": [[93, 93]], "note": "blank line"}, {"id": 81, "kind": "claim", "lines": [[94, 95]], "assertion": "log(games), continuous, was included as a covariate", "polarity": "did", "targets": ["log_games"], "confidence": "high"}, {"id": 82, "kind": "nonclaim", "subtype": "framing", "lines": [[96, 96]], "note": "rationale for log transform of games/exposure"}, {"id": 83, "kind": "nonclaim", "subtype": "other", "lines": [[97, 97]], "note": "blank line"}, {"id": 84, "kind": "nonclaim", "subtype": "heading", "lines": [[98, 98]], "note": "Skin Tone Definition subheading"}, {"id": 85, "kind": "n