ype": "heading", "lines": [[55, 55]], "note": "'Covariates:' label"}, {"id": 47, "kind": "claim", "lines": [[56, 56]], "assertion": "Position was included as a 4-category factor (Defender reference, Forward, Goalkeeper, Midfielder)", "polarity": "did", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 48, "kind": "claim", "lines": [[57, 57]], "assertion": "position categories were aggregated from 12 detailed positions to reduce sparsity", "polarity": "did", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 49, "kind": "claim", "lines": [[58, 58]], "assertion": "position strongly predicts red cards (defenders 1.97% vs attacking midfielders 0.71%)", "polarity": "found", "targets": ["position", "red cards"], "confidence": "high", "shares_lines_with": [50]}, {"id": 50, "kind": "claim", "lines": [[58, 58]], "assertion": "position varies by skin tone", "polarity": "found", "targets": ["position", "skin tone"], "confidence": "medium", "shares_lines_with": [49]}, {"id": 51, "kind": "claim", "lines": [[59, 59]], "assertion": "League was included as a 4-category factor (England reference, France, Germany, Spain)", "polarity": "did", "targets": ["league"], "confidence": "high", "shares_lines_with": []}, {"id": 52, "kind": "claim", "lines": [[60, 60]], "assertion": "league predicts red cards", "polarity": "found", "targets": ["league", "red cards"], "confidence": "high", "shares_lines_with": [53]}, {"id": 53, "kind": "claim", "lines": [[60, 60]], "assertion": "skin tone distribution varies by league (France 42% darker, Germany 21% darker)", "polarity": "found", "targets": ["league", "skin tone"], "confidence": "high", "shares_lines_with": [52]}, {"id": 54, "kind": "claim", "lines": [[61, 61]], "assertion": "Games (continuous number of games played in the dyad) was included as a covariate", "polarity": "did", "targets": ["games"], "confidence": "high", "shares_lines_with": []}, {"id": 55, "kind": "claim", "lines": [[62, 62]], "assertion": "games was included as an exposure variable on the rationale that more games means more opportunities for red cards", "polarity": "did", "targets": ["games"], "confidence": "medium", "shares_lines_with": []}, {"id": 56, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[63, 63]], "note": "blank line"}, {"id": 57, "kind": "nonclaim", "subtype": "heading", "lines": [[64, 65]], "note": "'Exclusions' subheading"}, {"id": 58, "kind": "claim", "lines": [[66, 66]], "assertion": "the original dataset contained 146,028 dyads", "polarity": "found", "targets": ["original dataset"], "confidence": "high", "shares_lines_with": []}, {"id": 59, "kind": "claim", "lines": [[67, 67]], "assertion": "45,501 dyads (31.2%) with medium skin tone were removed to create a clear light/dark contrast", "polarity": "did", "targets": ["medium skin tone dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 60, "kind": "claim", "lines": [[68, 68]], "assertion": "7,476 dyads (7.4%) were removed for missing position, height, or weight covariates", "polarity": "did", "targets": ["missing covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 61, "kind": "claim", "lines": [[69, 69]], "assertion": "the final sample of 93,051 dyads represents 63.7% of the original dataset", "polarity": "found", "targets": ["final sample"], "confidence": "high", "shares_lines_with": []}, {"id": 62, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[70, 70]], "note": "blank line"}, {"id": 63, "kind": "claim", "lines": [[71, 71]], "assertion": "the 14.7% of dyads with missing skin tone ratings were already excluded by virtue of requiring skin tone data", "polarity": "did", "targets": ["missing skin tone ratings"], "confidence": "high", "shares_lines_with": []}, {"id": 64, "kind": "nonclaim", "subtype": "heading", "lines": [[72, 74]], "note": "blank, 'Statistical Methods' subheading, blank"}, {"id": 65, "kind": "claim", "lines": [[75, 75]], "assertion": "the primary model was logistic regression estimated via maximum likelihood", "polarity": "did", "targets": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 66, "kind": "claim", "lines": [[76, 76]], "assertion": "the model formula was logit(P(red card)) = β0 + β1(dark skin) + β2(position) + β3(league) + β4(games)", "polarity": "did", "targets": ["model formula"], "confidence": "high", "shares_lines_with": []}, {"id": 67, "kind": "claim", "lines": [[77, 77]], "assertion": "the risk difference was estimated using marginal standardization (g-computation)", "polarity": "did", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 68, "kind": "claim", "lines": [[78, 78]], "assertion": "predicted P(red card) was computed for each dyad as if the player had dark skin", "polarity": "did", "targets": ["predicted probability"], "confidence": "high", "shares_lines_with": []}, {"id": 69, "kind": "claim", "lines": [[79, 79]], "assertion": "predicted P(red card) was computed for each dyad as if the player had light skin", "polarity": "did", "targets": ["predicted probability"], "confidence": "high", "shares_lines_with": []}, {"id": 70, "kind": "claim", "lines": [[80, 80]], "assertion": "the risk difference was computed as mean(predicted dark) minus mean(predicted light)", "polarity": "did", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 71, "kind": "claim", "lines": [[81, 81]], "assertion": "standard errors were computed via asymptotic normal approximation from maximum likelihood", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 72, "kind": "claim", "lines": [[82, 82]], "assertion": "confidence intervals were computed via parametric bootstrap with 5,000 simulations drawn from the multivariate normal distribution of parameter estimates", "polarity": "did", "targets": ["confidence intervals"], "confidence": "high", "shares_lines_with": []},