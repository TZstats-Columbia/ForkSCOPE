": "the final analytic sample size is N=93,051 dyads", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 27, "kind": "claim", "lines": [[34, 34]], "assertion": "light-skinned players account for 83,655 dyads (89.9%)", "polarity": "found", "targets": ["light-skinned players"], "confidence": "high", "shares_lines_with": []}, {"id": 28, "kind": "claim", "lines": [[35, 35]], "assertion": "dark-skinned players account for 9,396 dyads (10.1%)", "polarity": "found", "targets": ["dark-skinned players"], "confidence": "high", "shares_lines_with": []}, {"id": 29, "kind": "claim", "lines": [[36, 36]], "assertion": "there are 1,129 unique players in the sample", "polarity": "found", "targets": ["players"], "confidence": "high", "shares_lines_with": []}, {"id": 30, "kind": "claim", "lines": [[37, 37]], "assertion": "there are 2,739 unique referees in the sample", "polarity": "found", "targets": ["referees"], "confidence": "high", "shares_lines_with": []}, {"id": 31, "kind": "claim", "lines": [[38, 38]], "assertion": "1,148 dyads had at least one red card, a 1.23% event rate", "polarity": "found", "targets": ["red card events"], "confidence": "high", "shares_lines_with": []}, {"id": 32, "kind": "nonclaim", "subtype": "heading", "lines": [[39, 41]], "note": "blank, subheading, blank"}, {"id": 33, "kind": "nonclaim", "subtype": "heading", "lines": [[42, 42]], "note": "'Outcome:' label"}, {"id": 34, "kind": "claim", "lines": [[43, 43]], "assertion": "the outcome was operationalized as a binary indicator of whether the player received any red card from that referee", "polarity": "did", "targets": ["outcome variable"], "confidence": "high", "shares_lines_with": []}, {"id": 35, "kind": "claim", "lines": [[44, 44]], "assertion": "the outcome was derived from the count of red cards across all games in the dyad", "polarity": "did", "targets": ["outcome variable"], "confidence": "high", "shares_lines_with": []}, {"id": 36, "kind": "nonc