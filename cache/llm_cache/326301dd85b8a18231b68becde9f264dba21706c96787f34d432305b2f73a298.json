posure Variable subheading"}, {"id": 43, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[45, 45]], "note": "'Dark skin (binary):' scaffolding label"}, {"id": 44, "kind": "claim", "lines": [[46, 46]], "assertion": "light skin tone was defined as average rating ≤0.25", "polarity": "did", "targets": ["skin tone", "light"], "confidence": "high", "shares_lines_with": [45]}, {"id": 45, "kind": "claim", "lines": [[46, 46]], "assertion": "83,977 dyads (75.9%) were classified as light", "polarity": "found", "targets": ["dyads", "light"], "confidence": "high", "shares_lines_with": [44]}, {"id": 46, "kind": "claim", "lines": [[47, 47]], "assertion": "dark skin tone was defined as average rating ≥0.5", "polarity": "did", "targets": ["skin tone", "dark"], "confidence": "high", "shares_lines_with": [47]}, {"id": 47, "kind": "claim", "lines": [[47, 47]], "assertion": "26,600 dyads (24.1%) were classified as dark", "polarity": "found", "targets": ["dyads", "dark"], "confidence": "high", "shares_lines_with": [46]}, {"id": 48, "kind": "claim", "lines": [[48, 48]], "assertion": "skin tone was rated independently by two raters based on player profile photos", "polarity": "did", "targets": ["skin tone", "raters"], "confidence": "high", "shares_lines_with": []}, {"id": 49, "kind": "claim", "lines": [[49, 49]], "assertion": "a descriptive 0-1 scale was defined for skin tone ratings (0=very light ... 1.0=very dark)", "polarity": "did", "targets": ["skin tone scale"], "confidence": "high", "shares_lines_with": []}, {"id": 50, "kind": "claim", "lines": [[50, 50]], "assertion": "the average of the two raters' scores was used as the skin tone measure", "polarity": "did", "targets": ["skin tone", "raters"], "confidence": "high", "shares_lines_with": [51]}, {"id": 51, "kind": "claim", "lines": [[50, 50]], "assertion": "dyads with middle-range skin tone (0.25–0.5) were excluded to obtain a clear light/dark contrast", "polarity": "did", "targets": ["skin tone", "exclusion"], "confidence":