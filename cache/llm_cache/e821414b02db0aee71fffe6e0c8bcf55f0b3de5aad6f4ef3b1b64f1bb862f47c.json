d": "claim", "lines": [[124, 124]], "assertion": "the overall effect is said to be driven primarily by the English and German leagues", "polarity": "found", "targets": ["league country"], "confidence": "medium", "shares_lines_with": []}, {"id": 120, "kind": "nonclaim", "subtype": "other", "lines": [[125, 125]], "note": "blank line"}, {"id": 121, "kind": "nonclaim", "subtype": "heading", "lines": [[126, 126]], "note": "Excluding High-Exposure Dyads sub-subheading"}, {"id": 122, "kind": "claim", "lines": [[127, 127]], "assertion": "high-exposure dyads (>10 games) were found to have a much higher red card rate (5.7%) than low-exposure dyads (1.1% for 1-2 games)", "polarity": "found", "targets": ["games", "red cards"], "confidence": "high", "shares_lines_with": [123]}, {"id": 123, "kind": "claim", "lines": [[127, 127]], "assertion": "high-exposure dyads were excluded to test for outlier influence", "polarity": "did", "targets": ["games", "exclusions"], "confidence": "high", "shares_lines_with": [122]}, {"id": 124, "kind": "nonclaim", "subtype": "other", "lines": [[128, 128]], "note": "blank line"}, {"id": 125, "kind": "claim", "lines": [[129, 129]], "assertion": "restricting to ≤10 games (n = 109,876) gave a risk difference of 0.157 pp (95% CI -0.005, 0.319), p = 0.058", "polarity": "found", "targets": ["risk difference", "games"], "confidence": "high", "shares_lines_with": []}, {"id": 126, "kind": "nonclaim", "subtype": "other", "lines": [[130, 130]], "note": "blank line"}, {"id": 127, "kind": "claim", "lines": [[131, 131]], "assertion": "the effect is said to remain consistent in magnitude and borderline significant, indicating robustness to high-leverage observations", "polarity": "found", "targets": ["risk difference"], "confidence": "medium", "shares_lines_with": []}, {"id": 128, "kind": "nonclaim", "subtype": "other", "lines": [[132, 132]], "note": "blank line"}, {"id": 129, "kind": "nonclaim", "subtype": "heading", "lines": [[133, 133]], "note": "Implicit Bias Interaction sub-subheading"}, {"id": 130, "kind": "claim", "lines": [[134, 134]], "assertion": "the analysis tested whether referee-country implicit bias (IAT scores) moderated the skin tone effect", "polarity": "did", "targets": ["implicit bias", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 131, "kind": "nonclaim", "subtype": "other", "lines": [[135, 135]], "note": "blank line"}, {"id": 132, "kind": "claim", "lines": [[136, 136]], "assertion": "the interaction coefficient was -0.036 (SE = 0.063), p = 0.563", "polarity": "found", "targets": ["implicit bias"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "other", "lines": [[137, 137]], "note": "blank line"}, {"id": 134, "kind": "claim", "lines": [[138, 138]], "assertion": "no evidence was found that country-level implicit bias strengthens the skin-tone association; the direction of potential bias is described as unclear (text appears truncated/garbled at this line)", "polarity": "found", "targets": ["implicit bias"], "confidence": "low", "shares_lines_with": []}, {"id": 135, "kind": "claim", "lines": [[139, 139]], "assertion": "6.8% of dyads were excluded for missing position data, and since position relates to both skin tone and red cards, complete-case analysis may be biased if this missingness is non-random", "polarity": "found", "targets": ["position", "exclusions"], "confidence": "low", "shares_lines_with": []}, {"id": 136, "kind": "nonclaim", "subtype": "other", "lines": [[140, 140]], "note": "blank line"}, {"id": 137, "kind": "nonclaim", "subtype": "heading", "lines": [[141, 141]], "note": "Measurement Error sub-subheading"}, {"id": 138, "kind": "claim", "lines": [[142, 142]], "assertion": "classical measurement error in the skin-tone rating is said to bias effects toward zero, implying the true effect may be larger than estimated", "polarity": "found", "targets": ["skin tone", "measurement error"], "confidence": "low", "shares_lines_with": []}, {"id": 139, "kind": "claim", "lines": [[143, 143]], "assertion": "the continuous specification (sensitivity analysis B) is said to have yielded similar results despite the power loss from dichotomization", "polarity": "found", "targets": ["skin tone"], "confidence": "medium", "shares_lines_with": []}, {"id": 140, "kind": "nonclaim", "subtype": "other", "lines": [[144, 144]], "note": "blank line"}, {"id": 141, "kind": "nonclaim", "subtype": "heading", "lines": [[145, 145]], "note": "Reverse Causation sub-subheading"}, {"id": 142, "kind": "claim", "lines": [[146, 146]], "assertion": "reverse causation is rejected as a concern because skin tone is fixed and precedes red card decisions", "polarity": "did_not", "targets": ["skin tone", "red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "nonclaim", "subtype": "other", "lines": [[147, 147]], "note": "blank line"}, {"id": 144, "kind": "nonclaim", "subtype": "heading", "lines": [[148, 149]], "note": "Key Assumptions subheading"}, {"id": 145, "kind": "claim", "lines": [[150, 150]], "assertion": "the outcome was defined as \"any red card in dyad,\" treating dyads equally regardless of number of games, with log(games) controlled to address exposure", "polarity": "did", "targets": ["red cards", "games"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "nonclaim", "subtype": "other", "lines": [[151, 151]], "note": "blank line"}, {"id": 147, "kind": "claim", "lines": [[152, 152]], "assertion": "the 0.5 dichotomization cutpoint was chosen as a theoretically motivated (though acknowledged as arbitrary) midpoint of the scale", "polarity": "did", "targets": ["skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "nonclaim", "subtype": "other", "lines": [[153, 153]], "note": "blank line"}, {"id": 149, "kind": "claim", "lines": [[154, 154]], "assertion": "standard errors were clustered at the player level", "polarity": "did", "targets": ["standard errors", "players"], "confidence": "high", "shares_lines_with": [150, 151]}, {"id": 150, "kind": "claim", "lines": [[154, 154]], "assertion": "standard errors were not clustered at the referee level", "polarity": "did_not", "targets": ["standard errors", "referees"], "confidence": "high", "shares_lines_with": [149, 151]}, {"id": 151, "kind": "claim", "lines": [[154, 154]], "assertion": "two-way clustering (player + referee) would have been more conservative but was not used because it is computationally complex with this many clusters", "polarity": "would_have", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": [149, 150]}, {"id": 152, "kind": "nonclaim", "subtype": "other", "lines": [[155, 155]], "note": "blank line"}, {"id": 153, "kind": "claim", "lines": [[156, 156]], "assertion": "logistic regression was chosen, which assumes a log-linear relationship between covariates and log-odds", "polarity": "did", "targets": ["model"], "confidence": "high", "shares_lines_with": [154]}, {"id": 154, "kind": "claim", "lines": [[156, 156]], "assertion": "results are said to be consistent across specifications despite this potential functional-form misspecification", "polarity": "found", "targets": ["model"], "confidence": "medium", "shares_lines_with": [153]}, {"id": 155, "kind": "nonclaim", "subtype": "other", "lines": [[157, 157]], "note": "blank line"}, {"id": 156, "kind": "claim", "lines": [[158, 158]], "assertion": "the main model assumes the skin-tone effect is constant across positions and leagues, i.e. no interaction terms", "polarity": "did", "targets": ["model", "skin tone"], "confidence": "high", "shares_lines_with": [157]}, {"id": 157, "kind": "claim", "lines": [[158, 158]], "assertion": "league subgroup analyses are said to reveal heterogeneity, suggesting interaction effects exist", "polarity": "found", "targets": ["league country"], "confidence": "medium", "shares_lines_with": [156]}, {"id": 158, "kind": "nonclaim", "subtype": "other", "lines": [[159, 159]], "note": "blank line"}, {"id": 159, "kind": "nonclaim", "subtype": "heading", "lines": [[160, 161]], "note": "Robustness and Reproducibility subheading"}, {"id": 160, "kind": "nonclaim", "subtype": "framing", "lines": [[162, 162]], "note": "list intro label: Strengths"}, {"id": 161, "kind": "claim", "lines": [[163, 163]], "assertion": "the large sample size (>115,000 dyads) is said to provide adequate statistical power", "polarity": "found", "targets": ["sample size"], "confidence": "medium", "shares_lines_with": []}, {"id": 162, "kind": "claim", "lines": [[164, 164]], "assertion": "cluster-robust standard errors account for dependence within players", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[165, 165]], "assertion": "multiple sensitivity analyses are said to converge on similar conclusions", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "medium", "shares_lines_with": []}, {"id": 164, "kind": "claim", "lines": [[166, 166]], "assertion": "all analyses are fully reproducible from the provided code (final_analysis.py)", "polarity": "did", "targets": ["reproducibility"], "confidence": "high", "shares_lines_with": []}, {"id": 165, "kind": "nonclaim", "subtype": "other", "lines": [[167, 167]], "note": "blank line"}, {"id": 166, "kind": "nonclaim", "subtype": "framing", "lines": [[168, 168]], "note": "list intro label: Limitations"}, {"id": 167, "kind": "claim", "lines": [[169, 169]], "assertion": "borderline significance in the primary analysis (p = 0.059) means the result is sensitive to the chosen alpha threshold", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": [168]}, {"id": 168, "kind": "claim", "lines": [[169, 169]], "assertion": "the borderline significance is attributed partly to conservative dichotomization, since the continuous specification is clearly significant (p = 0.024)", "polarity": "found", "targets": ["skin tone", "p-value"], "confidence": "medium", "shares_lines_with": [167]}, {"id": 169, "kind": "claim", "lines": [[170, 170]], "assertion": "subgroup heterogeneity (significant in England/Germany, not Spain/France) is said to raise questions about generalizability", "polarity": "found", "targets": ["league country"], "confidence": "medium", "shares_lines_with": []}, {"id": 170, "kind": "claim", "lines": [[171, 171]], "assertion": "unmeasured confounding cannot be definitively ruled out, even though major known confounders were controlled for", "polarity": "did_not", "targets": ["confounding"], "confidence": "medium", "shares_lines_with": []}, {"id": 171, "kind": "nonclaim", "subtype": "other", "lines": [[172, 172]], "note": "blank line"}, {"id": 172, "kind": "nonclaim", "subtype": "heading", "lines": [[173, 174]], "note": "Missing Data Handling subheading"}, {"id": 173, "kind": "claim", "lines": [[175, 175]], "assertion": "complete case analysis (listwise deletion) was used, assuming data are missing completely at random (MCAR)", "polarity": "did", "targets": ["missing data"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[176, 176]], "assertion": "most missingness (14.7%) is attributed to lack of player photos, plausibly related to player prominence but less clearly to referee behavior", "polarity": "found", "targets": ["missing data"], "confidence": "medium", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[177, 177]], "assertion": "sensitivity analyses excluding high-exposure dyads, where data are more complete, are said to show consistent results", "polarity": "found", "targets": ["missing data", "games"], "confidence": "medium", "shares_lines_with": []}, {"id": 176, "kind": "nonclaim", "subtype": "other", "lines": [[178, 178]], "note": "blank line"}, {"id": 177, "kind": "claim", "lines": [[179, 179]], "assertion": "multiple imputation would have been preferable if missingness mechanisms could be modeled, but was not used because it was beyond scope", "polarity": "would_have", "targets": ["missing data"], "confidence": "high", "shares_lines_with": []}, {"id": 178, "kind": "nonclaim", "subtype": "heading", "lines": [[180, 184]], "note": "Conclusion heading"}, {"id": 179, "kind": "claim", "lines": [[185, 185]], "assertion": "the hypothesis that referees give more red cards to dark-skinned players is concluded to be supported by the data", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": []}, {"id": 180, "kind": "nonclaim", "subtype": "other", "lines": [[186, 186]], "note": "blank line"}, {"id": 181, "kind": "claim", "lines": [[187, 187]], "assertion": "the 0.179 pp risk difference, though modest and marginally significant, is said to be substantiated by multiple lines of evidence", "polarity": "found", "targets": ["risk difference"], "confidence": "medium", "shares_lines_with": []}, {"id": 182, "kind": "nonclaim", "subtype": "other", "lines": [[188, 188]], "note": "blank line"}, {"id": 183, "kind": "claim", "lines": [[189, 189]], "assertion": "all point estimates across specifications were positive (range 0.08 to 0.42 pp), indicating a consistent direction of effect", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 184, "kind": "nonclaim", "subtype": "other", "lines": [[190, 190]], "note": "blank line"}, {"id": 185, "kind": "nonclaim", "subtype": "framing", "lines": [[191, 191]], "note": "list item label, no new assertion beyond bullets below"}, {"id": 186, "kind": "claim", "lines": [[192, 192]], "assertion": "the extreme comparison (p = 0.008) and continuous specification (p = 0.024) are clearly significant", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 187, "kind": "claim", "lines": [[193, 193]], "assertion": "the England (p = 0.025) and Germany (p = 0.001) subgroup analyses are significant", "polarity": "found", "targets": ["England subgroup", "Germany subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 188, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "blank line"}, {"id": 189, "kind": "claim", "lines": [[195, 195]], "assertion": "the effect persists when excluding high-exposure dyads (p = 0.058), taken as robustness to methodological choices", "polarity": "found", "targets": ["games", "risk difference"], "confidence": "medium", "shares_lines_with": []}, {"id": 190, "kind": "nonclaim", "subtype": "other", "lines": [[196, 196]], "note": "blank line"}, {"id": 191, "kind": "claim", "lines": [[197, 197]], "assertion": "a 0.18 pp increase represents a 14.7% relative increase over the baseline rate", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": [192]}, {"id": 192, "kind": "claim", "lines": [[197, 197]], "assertion": "this translates to approximately 18 additional red cards per 10,000 dyads, described as a small but non-trivial population-level impact", "polarity": "found", "targets": ["red cards"], "confidence": "medium", "shares_lines_with": [191]}, {"id": 193, "kind": "nonclaim", "subtype": "other", "lines": [[198, 198]], "note": "blank line"}, {"id": 194, "kind": "claim", "lines": [[199, 199]], "assertion": "the effect is claimed to be consistent with implicit-bias literature on unconscious threat/aggression associations influencing split-second refereeing decisions", "polarity": "found", "targets": ["implicit bias"], "confidence": "low", "shares_lines_with": []}, {"id": 195, "kind": "nonclaim", "subtype": "other", "lines": [[200, 200]], "note": "blank line"}, {"id": 196, "kind": "claim", "lines": [[201, 201]], "assertion": "despite borderline significance, heterogeneous subgroup effects, and unruled-out confounding, the weight of evidence (especially significant sensitivity analyses) is said to provide convincing support for the hypothesis", "polarity": "found", "targets": ["hypothesis"], "confidence": "medium", "shares_lines_with": []}, {"id": 197, "kind": "nonclaim", "subtype": "other", "lines": [[202, 202]], "note": "blank line"}, {"id": 198, "kind": "claim", "lines": [[203, 203]], "assertion": "even a small bias in red card decisions is claimed to meaningfully affect players' careers and team outcomes, motivating referee bias-awareness training and continued monitoring", "polarity": "found", "targets": ["red cards"], "confidence": "low", "shares_lines_with": []}, {"id": 199, "kind": "nonclaim", "subtype": "heading", "lines": [[204, 208]], "note": "Reproducibility Statement heading"}, {"id": 200, "kind": "claim", "lines": [[209, 215]], "assertion": "all analyses are fully reproducible using the provided script (final_analysis.py) and dataset (soccer.csv), which includes data loading/preparation, descriptive statistics, primary and secondary analyses, sensitivity analyses, model diagnostics, and visualizations", "polarity": "did", "targets": ["reproducibility"], "confidence": "high", "shares_lines_with": []}, {"id": 201, "kind": "nonclaim", "subtype": "other", "lines": [[216, 216]], "note": "blank line"}, {"id": 202, "kind": "claim", "lines": [[217, 217]], "assertion": "running the script will regenerate all reported results and save figures to /workspace/", "polarity": "did", "targets": ["reproducibility"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "nonclaim", "subtype": "other", "lines": [[218, 218]], "note": "blank line"}, {"id": 204, "kind": "nonclaim", "subtype": "framing", "lines": [[219, 219]], "note": "list intro label: Key Software"}, {"id": 205, "kind": "claim", "lines": [[220, 223]], "assertion": "the software stack used was Python 3.11, pandas 2.x, statsmodels 0.14, and numpy/scipy/matplotlib/seaborn", "polarity": "did", "targets": ["software"], "confidence": "high", "shares_lines_with": []}, {"id": 206, "kind": "nonclaim", "subtype": "heading", "lines": [[224, 228]], "note": "Tables and Figures heading"}, {"id": 207, "kind": "claim", "lines": [[229, 229]], "assertion": "Figure 1 shows risk differences across specifications, league-specific subgroup effects, the distribution of skin tone ratings, and red card rates by position and skin tone", "polarity": "did", "targets": ["figures"], "confidence": "high", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "other", "lines": [[230, 230]], "note": "blank line"}, {"id": 209, "kind": "nonclaim", "subtype": "framing", "lines": [[231, 231]], "note": "Table 1 label"}, {"id": 210, "kind": "nonclaim", "subtype": "other", "lines": [[232, 232]], "note": "blank line"}, {"id": 211, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[233, 234]], "note": "table header and divider row"}, {"id": 212, "kind": "claim", "lines": [[235, 235]], "assertion": "the unadjusted risk difference was 0.120 pp (95% CI -0.037, 0.277), p = 0.133", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 213, "kind": "claim", "lines": [[236, 236]], "assertion": "the adjusted primary analysis (N = 115,603) gave 0.179 pp (95% CI -0.007, 0.365), p = 0.059", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 214, "kind": "claim", "lines": [[237, 237]], "assertion": "the adjusted extreme analysis (N = 64,281) gave 0.343 pp (95% CI 0.090, 0.597), p = 0.008", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 215, "kind": "claim", "lines": [[238, 238]], "assertion": "the adjusted continuous analysis (N = 115,603) gave 0.315 pp (95% CI 0.041, 0.589), p = 0.024", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 216, "kind": "claim", "lines": [[239, 239]], "assertion": "the England subgroup (N = 31,145) gave 0.352 pp (95% CI 0.043, 0.660), p = 0.025", "polarity": "found", "targets": ["England subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 217, "kind": "claim", "lines": [[240, 240]], "assertion": "the Germany subgroup (N = 38,453) gave 0.422 pp (95% CI 0.165, 0.679), p = 0.001", "polarity": "found", "targets": ["Germany subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 218, "kind": "claim", "lines": [[241, 241]], "assertion": "the Spain subgroup (N = 29,606) gave 0.083 pp (95% CI -0.387, 0.553), p = 0.729", "polarity": "found", "targets": ["Spain subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 219, "kind": "claim", "lines": [[242, 242]], "assertion": "the France subgroup (N = 16,399) gave -0.358 pp (95% CI -0.862, 0.146), p = 0.164", "polarity": "found", "targets": ["France subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 220, "kind": "claim", "lines": [[243, 243]], "assertion": "the low-exposure robustness analysis (N = 109,876) gave 0.157 pp (95% CI -0.005, 0.319), p = 0.058", "polarity": "found", "targets": ["risk difference", "games"], "confidence": "high", "shares_lines_with": []}, {"id": 221, "kind": "nonclaim", "subtype": "other", "lines": [[244, 244]], "note": "blank line"}, {"id": 222, "kind": "claim", "lines": [[245, 245]], "assertion": "the table note states adjusted models control for position, log(games), height, weight, yellow cards, and league country (except subgroups), with primary using ≥0.5 vs. <0.5, extreme using ≥0.75 vs. <0.25, and continuous using the 0-1 scale", "polarity": "did", "targets": ["covariates", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 223, "kind": "nonclaim", "subtype": "heading", "lines": [[246, 248]], "note": "section divider before closing metadata"}, {"id": 224, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[249, 250]], "note": "report completion date and code reference"}, {"id": 225, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[251, 252]], "note": "blank line and end tool-output tag"}]}}