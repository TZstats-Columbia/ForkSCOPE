, "assertion": "referee implicit bias IAT scores were available but not used in the primary model", "polarity": "did_not", "targets": ["IAT scores", "implicit bias"], "confidence": "high", "shares_lines_with": []}, {"id": 100, "kind": "claim", "lines": [[161, 161]], "assertion": "socioeconomic factors correlated with skin tone were not controlled for", "polarity": "did_not", "targets": ["socioeconomic factors"], "confidence": "high", "shares_lines_with": []}, {"id": 101, "kind": "claim", "lines": [[162, 163]], "assertion": "nationality/origin, confounded with skin tone, was not controlled for", "polarity": "did_not", "targets": ["nationality"], "confidence": "high", "shares_lines_with": []}, {"id": 102, "kind": "nonclaim", "subtype": "heading", "lines": [[164, 165]], "note": "Section 6.3 subheading"}, {"id": 103, "kind": "nonclaim", "subtype": "heading", "lines": [[166, 166]], "note": "'Addressed' label"}, {"id": 104, "kind": "claim", "lines": [[167, 167]], "assertion": "player-clustered standard errors were used to account for within-player correlation", "polarity": "did", "targets": ["clustering", "standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 105, "kind": "claim", "lines": [[168, 169]], "assertion": "each player appears in ~82 dyads and each referee in ~38 dyads on average", "polarity": "found", "targets": ["players", "referees", "dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 106, "kind": "nonclaim", "subtype": "heading", "lines": [[170, 170]], "note": "'Not Fully Addressed' label"}, {"id": 107, "kind": "claim", "lines": [[171, 171]], "assertion": "two-way clustering (player and referee simultaneously) was not implemented", "polarity": "did_not", "targets": ["clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 108, "kind": "claim", "lines": [[172, 172]], "assertion": "temporal correlation within games was not accounted for, since data was aggregated to the dyad level", "polarity": "did_not", "targets": ["temporal correlation"], "confidence": "high", "shares_lines_with": []}, {"id": 109, "kind": "claim", "lines": [[173, 174]], "assertion": "league/country-level clustering was not modeled", "polarity": "did_not", "targets": ["clustering", "league"], "confidence": "high", "shares_lines_with": []}, {"id": 110, "kind": "nonclaim", "subtype": "heading", "lines": [[175, 176]], "note": "Section 6.4 subheading"}, {"id": 111, "kind": "claim", "lines": [[177, 177]], "assertion": "the analysis used data from the 2012-2013 season only", "polarity": "did", "targets": ["season"], "confidence": "high", "shares_lines_with": []}, {"id": 112, "kind": "claim", "lines": [[178, 178]], "assertion": "the analysis covered four European leagues only", "polarity": "did", "targets": ["leagues"], "confidence": "high", "shares_lines_with": []}, {"id": 113, "kind": "claim", "lines": [[179, 179]], "assertion": "the analysis included male players only", "polarity": "did", "targets": ["players"], "confidence": "high", "shares_lines_with": []}, {"id": 114, "kind": "claim", "lines": [[180, 181]], "assertion": "the analysis included elite professional (first-division) soccer only", "polarity": "did", "targets": ["league level"], "confidence": "high", "shares_lines_with": []}, {"id": 115, "kind": "nonclaim", "subtype": "heading", "lines": [[182, 183]], "note": "Section 6.5 subheading"}, {"id": 116, "kind": "claim", "lines": [[184, 184]], "assertion": "the primary analysis was pre-specified as the player-clustered LPM", "polarity": "did", "targets": ["primary analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 117, "kind": "claim", "lines": [[185, 185]], "assertion": "sensitivity analyses (referee clustering, continuous skin tone) were presented for robustness, not as confirmatory tests", "polarity": "did_not", "targets": ["sensitivity analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 118, "kind": "claim", "lines": [[186, 187]], "assertion": "no formal adjustment for multiple comparisons was made", "polarity": "did_not", "targets": ["multiple comparisons"], "confidence": "high", "shares_lines_with": []}, {"id": 119, "kind": "nonclaim", "subtype": "heading", "lines": [[188, 189]], "note": "Section 6.6 subheading"}, {"id": 120, "kind": "claim", "lines": [[190, 191]], "assertion": "with 1,374 red card events and ~24% dark-skinned sample, the study had ~80% power to detect an absolute risk difference of ~0.4pp", "polarity": "found", "targets": ["statistical power"], "confidence": "high", "shares_lines_with": []}, {"id": 121, "kind": "claim", "lines": [[192, 192]], "assertion": "the observed 0.18pp effect is below the detectable threshold, contributing to non-significance", "polarity": "found", "targets": ["statistical power", "risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 122, "kind": "claim", "lines": [[193, 194]], "assertion": "the low event rate (1.25%) limits precision", "polarity": "found", "targets": ["event rate"], "confidence": "high", "shares_lines_with": []}, {"id": 123, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[195, 196]], "note": "section divider"}, {"id": 124, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 198]], "note": "Section 7 heading"}, {"id": 125, "kind": "nonclaim", "subtype": "heading", "lines": [[199, 200]], "note": "Section 7.1 subheading"}, {"id": 126, "kind": "claim", "lines": [[201, 202]], "assertion": "with low outcome prevalence, predicted probabilities from the LPM stayed within [0,1] bounds for all observations (verified)", "polarity": "found", "targets": ["linear probability model"], "confidence": "high", "shares_lines_with": []}, {"id": 127, "kind": "claim", "lines": [[203, 204]], "assertion": "homoscedasticity was not assumed, due to use of robust/clustered standard errors", "polarity": "did_not", "targets": ["homoscedasticity"], "confidence": "high", "shares_lines_with": []}, {"id": 128, "kind": "claim", "lines": [[205, 206]], "assertion": "independence was addressed through player-level clustering", "polarity": "did", "targets": ["independence assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 129, "kind": "claim", "lines": [[207, 208]], "assertion": "no perfect multicollinearity was found; VIF values were below 5 for all predictors", "polarity": "found", "targets": ["multicollinearity", "VIF"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "nonclaim", "subtype": "heading", "lines": [[209, 210]], "note": "Section 7.2 subheading"}, {"id": 131, "kind": "claim", "lines": [[211, 212]], "assertion": "the logistic regression model converged successfully in 9 iterations", "polarity": "found", "targets": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 132, "kind": "claim", "lines": [[213, 214]], "assertion": "no evidence of non-linear log-odds patterns was found for the standardized continuous predictors", "polarity": "found", "targets": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "claim", "lines": [[215, 216]], "assertion": "no complete separation was present in the logistic model", "polarity": "found", "targets": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[217, 218]], "note": "Section 7.3 subheading"}, {"id": 135, "kind": "claim", "lines": [[219, 220]], "assertion": "LPM residuals are non-normal by design but this does not affect coefficient estimates or cluster-robust inference", "polarity": "found", "targets": ["residuals"], "confidence": "high", "shares_lines_with": []}, {"id": 136, "kind": "claim", "lines": [[221, 222]], "assertion": "25 dyads (0.02%) had 2 red cards, and excluding them gave virtually identical results in an unshown sensitivity check", "polarity": "found", "targets": ["influential observations"], "confidence": "high", "shares_lines_with": []}, {"id": 137, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[223, 224]], "note": "section divider"}, {"id": 138, "kind": "nonclaim", "subtype": "heading", "lines": [[225, 226]], "note": "Section 8 heading"}, {"id": 139, "kind": "nonclaim", "subtype": "heading", "lines": [[227, 228]], "note": "Section 8.1 subheading"}, {"id": 140, "kind": "claim", "lines": [[229, 230]], "assertion": "the baseline red card rate for light-skinned players is 1.21%", "polarity": "found", "targets": ["baseline red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "claim", "lines": [[231, 231]], "assertion": "the baseline red card rate for dark-skinned players is 1.35%", "polarity": "found", "targets": ["baseline red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "claim", "lines": [[232, 233]], "assertion": "the unadjusted difference is 0.13pp (p=0.163 with clustering)", "polarity": "found", "targets": ["unadjusted difference"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "nonclaim", "subtype": "heading", "lines": [[234, 234]], "note": "'Position effects' label"}, {"id": 144, "kind": "claim", "lines": [[235, 235]], "assertion": "Center Back position shows +1.28pp red card probability vs Attacking Midfielder reference", "polarity": "found", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "claim", "lines": [[236, 236]], "assertion": "Goalkeeper position shows +0.63pp vs reference", "polarity": "found", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "claim", "lines": [[237, 237]], "assertion": "Defensive Midfielder position shows +0.52pp vs reference", "polarity": "found", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 147, "kind": "claim", "lines": [[238, 239]], "assertion": "Winger positions show +0.04 to +0.54pp vs reference", "polarity": "found", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "nonclaim", "subtype": "heading", "lines": [[240, 240]], "note": "'Exposure effects' label"}, {"id": 149, "kind": "claim", "lines": [[241, 242]], "assertion": "each additional SD of games played (~3.7 games) increases red card probability by 1.33pp", "polarity": "found", "targets": ["games played"], "confidence": "high", "shares_lines_with": []}, {"id": 150, "kind": "nonclaim", "subtype": "heading", "lines": [[243, 243]], "note": "'League effects' label"}, {"id": 151, "kind": "claim", "lines": [[244, 244]], "assertion": "Spain shows +0.47pp vs England reference", "polarity": "found", "targets": ["league"], "confidence": "high", "shares_lines_with": []}, {"id": 152, "kind": "claim", "lines": [[245, 245]], "assertion": "France shows +0.45pp vs England reference", "polarity": "found", "targets": ["league"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[246, 247]], "assertion": "Germany shows -0.07pp vs England reference", "polarity": "found", "targets": ["league"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "nonclaim", "subtype": "heading", "lines": [[248, 249]], "note": "Section 8.2 subheading"}, {"id": 155, "kind": "nonclaim", "subtype": "heading", "lines": [[250, 250]], "note": "'Position distribution differs by skin tone' label"}, {"id": 156, "kind": "claim", "lines": [[251, 251]], "assertion": "dark-skinned players are 20% Center Forward, 17% Center Back", "polarity": "found", "targets": ["position", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 157, "kind": "claim", "lines": [[252, 253]], "assertion": "light-skinned players are 12% Center Forward, 18% Center Back, 12% Goalkeeper", "polarity": "found", "targets": ["position", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "heading", "lines": [[254, 254]], "note": "'League distribution differs by skin tone' label"}, {"id": 159, "kind": "claim", "lines": [[255, 255]], "assertion": "dark-skinned players are more concentrated in England (37%) and France (26%)", "polarity": "found", "targets": ["league", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 160, "kind": "claim", "lines": [[256, 257]], "assertion": "light-skinned players are more concentrated in Germany (38%) and Spain (26%)", "polarity": "found", "targets": ["league", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 161, "kind": "nonclaim", "subtype": "heading", "lines": [[258, 258]], "note": "'Physical characteristics' label"}, {"id": 162, "kind": "claim", "lines": [[259, 260]], "assertion": "height (182.3 vs 181.6cm) and weight (76.6 vs 76.0kg) differ minimally by skin tone group", "polarity": "found", "targets": ["height", "weight"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[261, 262]], "assertion": "these distributional differences are said to justify covariate adjustment in the analysis", "polarity": "did", "targets": ["covariate adjustment"], "confidence": "medium", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[263, 264]], "note": "section divider"}, {"id": 165, "kind": "nonclaim", "subtype": "heading", "lines": [[265, 266]], "note": "Section 9 heading"}, {"id": 166, "kind": "nonclaim", "subtype": "heading", "lines": [[267, 268]], "note": "Section 9.1 subheading"}, {"id": 167, "kind": "claim", "lines": [[269, 269]], "assertion": "all sensitivity analyses show positive associations, a consistent direction", "polarity": "found", "targets": ["sensitivity analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 168, "kind": "claim", "lines": [[270, 270]], "assertion": "p-values across specifications are near the threshold: 0.076 primary, 0.084 OR, 0.058 continuous", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 169, "kind": "claim", "lines": [[271, 271]], "assertion": "the result is significant with referee clustering (p=0.029)", "polarity": "found", "targets": ["p-value", "clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "nonclaim", "subtype": "framing", "lines": [[272, 272]], "note": "interpretive argument that implicit bias is a plausible mechanism, citing availability of IAT data for referee countries"}, {"id": 171, "kind": "nonclaim", "subtype": "citation", "lines": [[273, 274]], "note": "references prior literature reporting racial bias in referee decisions in other contexts"}, {"id": 172, "kind": "nonclaim", "subtype": "heading", "lines": [[275, 276]], "note": "Section 9.2 subheading"}, {"id": 173, "kind": "claim", "lines": [[277, 277]], "assertion": "the CI includes zero, so no effect cannot be ruled out", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[278, 278]], "assertion": "the small absolute magnitude (0.18pp) is about 1/7 of the baseline rate", "polarity": "found", "targets": ["risk difference", "baseline rate"], "confidence": "high", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[279, 279]], "assertion": "multiple potential confounders (playing style, reputation, nationality) were not fully controlled for", "polarity": "did_not", "targets": ["confounders"], "confidence": "high", "shares_lines_with": []}, {"id": 176, "kind": "nonclaim", "subtype": "hedging", "lines": [[280, 280]], "note": "caveat that photo-based skin-tone ratings may not capture in-game perceptions"}, {"id": 177, "kind": "nonclaim", "subtype": "hedging", "lines": [[281, 282]], "note": "caveat that missing photos (~15%) could introduce selection bias if non-random"}, {"id": 178, "kind": "nonclaim", "subtype": "heading", "lines": [[283, 284]], "note": "Section 9.3 subheading"}, {"id": 179, "kind": "claim", "lines": [[285, 286]], "assertion": "a 0.18pp increase corresponds to going from 1.21% to 1.39% in absolute red card rate", "polarity": "found", "targets": ["red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 180, "kind": "claim", "lines": [[287, 287]], "assertion": "this represents a relative increase of ~15%", "polarity": "found", "targets": ["relative increase"], "confidence": "high", "shares_lines_with": []}, {"id": 181, "kind": "claim", "lines": [[288, 289]], "assertion": "the number needed to treat is approximately 556 dyads for one additional red card", "polarity": "found", "targets": ["number needed to treat"], "confidence": "high", "shares_lines_with": []}, {"id": 182, "kind": "nonclaim", "subtype": "other", "lines": [[290, 291]], "note": "interpretive comment that practical significance is debatable and depends on normative fairness standards"}, {"id": 183, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[292, 293]], "note": "section divider"}, {"id": 184, "kind": "nonclaim", "subtype": "heading", "lines": [[294, 295]], "note": "Section 10 heading"}, {"id": 185, "kind": "nonclaim", "subtype": "other", "lines": [[296, 304]], "note": "list of 8 recommendations for future research (larger sample, within-referee analysis, video analysis, implicit-bias linkage, longitudinal design, experimental approach, two-way clustering, mediation analysis); forward-looking suggestions, not assertions about this analysis"}, {"id": 186, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[305, 306]], "note": "section divider"}, {"id": 187, "kind": "nonclaim", "subtype": "heading", "lines": [[307, 308]], "note": "Section 11 heading"}, {"id": 188, "kind": "nonclaim", "subtype": "heading", "lines": [[309, 309]], "note": "Strengths subheading"}, {"id": 189, "kind": "claim", "lines": [[310, 310]], "assertion": "the sample size (146,028 dyads) is large", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 190, "kind": "claim", "lines": [[311, 311]], "assertion": "the data provides complete coverage of four major European leagues", "polarity": "found", "targets": ["leagues"], "confidence": "high", "shares_lines_with": []}, {"id": 191, "kind": "claim", "lines": [[312, 312]], "assertion": "skin tone was independently double-coded with high inter-rater reliability (r=0.92)", "polarity": "found", "targets": ["inter-rater reliability"], "confidence": "high", "shares_lines_with": []}, {"id": 192, "kind": "claim", "lines": [[313, 313]], "assertion": "rich covariate data is available (position, physical characteristics, games, league)", "polarity": "found", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 193, "kind": "claim", "lines": [[314, 315]], "assertion": "the data is administrative rather than self-reported", "polarity": "found", "targets": ["data source"], "confidence": "high", "shares_lines_with": []}, {"id": 194, "kind": "nonclaim", "subtype": "heading", "lines": [[316, 316]], "note": "Weaknesses subheading"}, {"id": 195, "kind": "claim", "lines": [[317, 317]], "assertion": "15% of photos are missing, a potential selection bias", "polarity": "found", "targets": ["missing photos"], "confidence": "high", "shares_lines_with": []}, {"id": 196, "kind": "claim", "lines": [[318, 318]], "assertion": "the data covers a single season only, so trends cannot be assessed", "polarity": "found", "targets": ["season"], "confidence": "high", "shares_lines_with": []}, {"id": 197, "kind": "claim", "lines": [[319, 319]], "assertion": "dyad-level aggregation loses game-specific context", "polarity": "found", "targets": ["dyad-level aggregation"], "confidence": "high", "shares_lines_with": []}, {"id": 198, "kind": "claim", "lines": [[320, 320]], "assertion": "no data exists on foul severity, game stakes, or score differentials", "polarity": "found", "targets": ["foul severity"], "confidence": "high", "shares_lines_with": []}, {"id": 199, "kind": "claim", "lines": [[321, 322]], "assertion": "implicit bias measures exist only at the country level, not the individual referee level", "polarity": "found", "targets": ["IAT scores"], "confidence": "high", "shares_lines_with": []}, {"id": 200, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[323, 324]], "note": "section divider"}, {"id": 201, "kind": "nonclaim", "subtype": "heading", "lines": [[325, 326]], "note": "Technical Appendix heading"}, {"id": 202, "kind": "claim", "lines": [[327, 333]], "assertion": "all analyses were conducted in Python 3.11 using pandas, numpy, statsmodels 0.14, scipy, and sklearn", "polarity": "did", "targets": ["software"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "claim", "lines": [[334, 335]], "assertion": "complete code is provided in final_analysis.py for full reproducibility", "polarity": "did", "targets": ["code"], "confidence": "high", "shares_lines_with": []}, {"id": 204, "kind": "claim", "lines": [[336, 337]], "assertion": "the data source is /workspace/data/soccer/soccer.csv (33.3MB, 146,028 rows, 28 columns)", "polarity": "found", "targets": ["data source"], "confidence": "high", "shares_lines_with": []}, {"id": 205, "kind": "claim", "lines": [[338, 339]], "assertion": "a codebook with variable definitions is provided at /workspace/data/soccer/codebook.txt", "polarity": "did", "targets": ["codebook"], "confidence": "high", "shares_lines_with": []}, {"id": 206, "kind": "claim", "lines": [[340, 341]], "assertion": "no random seed was used or applicable, since the analysis is deterministic", "polarity": "did_not", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 207, "kind": "claim", "lines": [[342, 343]], "assertion": "computation took under 30 seconds on standard hardware", "polarity": "found", "targets": ["computation time"], "confidence": "high", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[344, 345]], "note": "section divider"}, {"id": 209, "kind": "nonclaim", "subtype": "heading", "lines": [[346, 347]], "note": "Summary heading"}, {"id": 210, "kind": "claim", "lines": [[348, 348]], "assertion": "the analysis of 110,151 dyads found a small, non-significant association between darker skin tone and red card probability (adjusted RD=0.177pp, 95% CI [-0.018,0.372], p=0.076)", "polarity": "found", "targets": ["risk difference", "conclusion"], "confidence": "high", "shares_lines_with": [211, 212]}, {"id": 211, "kind": "claim", "lines": [[348, 349]], "assertion": "the finding would benefit from replication with larger samples and more granular foul-circumstance data", "polarity": "would_have", "targets": ["replication"], "confidence": "medium", "shares_lines_with": [210, 212]}, {"id": 212, "kind": "claim", "lines": [[348, 348]], "assertion": "the finding is sensitive to clustering choices", "polarity": "found", "targets": ["clustering", "sensitivity"], "confidence": "high", "shares_lines_with": [210, 211]}, {"id": 213, "kind": "claim", "lines": [[350, 351]], "assertion": "the final determination is stated as NOT SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 214, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[352, 352]], "note": "tool-output wrapper closing tag"}]}}