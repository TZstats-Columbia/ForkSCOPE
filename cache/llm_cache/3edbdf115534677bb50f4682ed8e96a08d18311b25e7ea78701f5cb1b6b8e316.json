ines": [[146, 147]], "note": "section divider"}, {"id": 98, "kind": "nonclaim", "subtype": "heading", "lines": [[148, 149]], "note": "limitations section heading"}, {"id": 99, "kind": "nonclaim", "subtype": "heading", "lines": [[150, 151]], "note": "study design limitations subheading"}, {"id": 100, "kind": "nonclaim", "subtype": "hedging", "lines": [[152, 153]], "note": "generic observational/cross-sectional confounding caveat, no specific action named"}, {"id": 101, "kind": "nonclaim", "subtype": "hedging", "lines": [[154, 155]], "note": "generic caveat about photo-based measurement and dichotomization tradeoff"}, {"id": 102, "kind": "claim", "lines": [[156, 157]], "assertion": "red cards were pooled/aggregated across all games within a dyad", "polarity": "did", "targets": ["red card", "dyad aggregation"], "confidence": "low", "shares_lines_with": [103]}, {"id": 103, "kind": "claim", "lines": [[156, 157]], "assertion": "within-game dynamics such as score, timing, and opponent were not captured in the analysis", "polarity": "did_not", "targets": ["within-game dynamics"], "confidence": "high", "shares_lines_with": [102]}, {"id": 104, "kind": "nonclaim", "subtype": "heading", "lines": [[158, 159]], "note": "analytic choices favoring hypothesis subheading"}, {"id": 105, "kind": "claim", "lines": [[160, 161]], "assertion": "the minimum-3-games threshold substantially increases the effect (0.72pp vs 0.27pp at minimum 1 game)", "polarity": "found", "targets": ["minimum games threshold", "effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 106, "kind": "claim", "lines": [[162, 163]], "assertion": "goalkeeper exclusion increases the effect by about 0.2pp", "polarity": "found", "targets": ["goalkeepers", "effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 107, "kind": "claim", "lines": [[164, 165]], "assertion": "the 0.25 skin-tone threshold was selected via specification search as optimal, with higher thresholds (0.375, 0.5) yielding smaller effects", "polarity": "did", "targets": ["skin tone threshold", "effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 108, "kind": "claim", "lines": [[166, 167]], "assertion": "the quadratic games term marginally improves the effect versus a linear term", "polarity": "found", "targets": ["games functional form", "effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 109, "kind": "claim", "lines": [[168, 169]], "assertion": "no holdout validation, cross-validation, or multiplicity adjustment was used", "polarity": "did_not", "targets": ["holdout validation", "cross-validation", "multiplicity adjustment"], "confidence": "high", "shares_lines_with": [110]}, {"id": 110, "kind": "claim", "lines": [[168, 169]], "assertion": "all data were used for both model selection and inference, maximizing apparent support for the hypothesis", "polarity": "did", "targets": ["model selection", "inference"], "confidence": "high", "shares_lines_with": [109]}, {"id": 111, "kind": "nonclaim", "subtype": "heading", "lines": [[170, 171]], "note": "most favorable assumptions subheading"}, {"id": 112, "kind": "claim", "lines": [[172, 172]], "assertion": "assumes position and games exposure capture the key confounders (no unobserved confounding)", "polarity": "did", "targets": ["confounding", "assumptions"], "confidence": "high", "shares_lines_with": [113]}, {"id": 113, "kind": "claim", "lines": [[172, 172]], "assertion": "player behavior, referee strictness, and team effects are not fully controlled for", "polarity": "did_not", "targets": ["player behavior", "referee strictness", "team effects"], "confidence": "high", "shares_lines_with": [112]}, {"id": 114, "kind": "claim", "lines": [[173, 173]], "assertion": "assumes linear additivity on the logit scale, i.e. no complex interactions between dark skin, position, and games", "polarity": "did", "targets": ["model assumptions", "interactions"], "confidence": "high", "shares_lines_with": []}, {"id": 115, "kind": "claim", "lines": [[174, 175]], "assertion": "assumes cluster-robust SEs by player are sufficient", "polarity": "did", "targets": ["standard errors", "assumptions"], "confidence": "high", "shares_lines_with": [116]}, {"id": 116, "kind": "claim", "lines": [[174, 175]], "assertion": "did not use multilevel modeling for additional clustering by referee, team, or league", "polarity": "did_not", "targets": ["multilevel modeling", "referee", "team", "league"], "confidence": "high", "shares_lines_with": [115]}, {"id": 117, "kind": "claim", "lines": [[176, 177]], "assertion": "explicitly states these assumptions favor hypothesis support", "polarity": "found", "targets": ["assumptions"], "confidence": "high", "shares_lines_with": [118]}, {"id": 118, "kind": "claim", "lines": [[176, 177]], "assertion": "asserts violations of these assumptions would likely attenuate the effect, and the result represents an upper bound of support under favorable conditions", "polarity": "found", "targets": ["overall result"], "confidence": "low", "shares_lines_with": [117]}, {"id": 119, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[178, 179]], "note": "section divider"}, {"id": 120, "kind": "nonclaim", "subtype": "heading", "lines": [[180, 181]], "note": "conclusion heading"}, {"id": 121, "kind": "claim", "lines": [[182, 183]], "assertion": "states the overall conclusion as SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 122, "kind": "claim", "lines": [[184, 185]], "assertion": "the hypothesis is strongly supported by this exploratory in-sample analysis", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 123, "kind": "nonclaim", "subtype": "heading", "lines": [[186, 186]], "note": "evidence summary label"}, {"id": 124, "kind": "claim", "lines": [[187, 187]], "assertion": "magnitude: 0.715 percentage-point increase in red card probability, a 31% relative increase", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 125, "kind": "claim", "lines": [[188, 188]], "assertion": "precision: the 95% CI (0.300,1.131pp) excludes zero", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 126, "kind": "claim", "lines": [[189, 189]], "assertion": "significance: two-sided p=0.0007, highly significant at α=0.05", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 127, "kind": "claim", "lines": [[190, 190]], "assertion": "consistency: effect positive and mostly significant across all sensitivity analyses", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "high", "shares_lines_with": []}, {"id": 128, "kind": "claim", "lines": [[191, 192]], "assertion": "claims a dose-response relationship: the effect monotonically increases with skin tone darkness", "polarity": "found", "targets": ["dose-response", "skin tone"], "confidence": "low", "shares_lines_with": []}, {"id": 129, "kind": "claim", "lines": [[193, 194]], "assertion": "interpretation: dark-skinned players face a substantively meaningful, statistically significant, directionally consistent elevation in red card risk that is robust across specifications and exceeds significance thresholds comfortably", "polarity": "found", "targets": ["conclusion", "robustness"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "claim", "lines": [[195, 195]], "assertion": "restates that an exploratory advocacy framework was used to identify the strongest in-sample evidence, whose findings are said to motivate future confirmatory analysis", "polarity": "did", "targets": ["analytic framework"], "confidence": "high", "shares_lines_with": []}, {"id": 131, "kind": "claim", "lines": [[196, 201]], "assertion": "lists hold-out validation/cross-validation, stricter control of researcher degrees of freedom, multilevel modeling, mediation analysis, and randomization inference as methods that would strengthen a future confirmatory analysis but were not used here", "polarity": "would_have", "targets": ["holdout validation", "multilevel modeling", "mediation analysis", "randomization inference"], "confidence": "medium", "shares_lines_with": []}, {"id": 132, "kind": "claim", "lines": [[202, 203]], "assertion": "the current results represent the upper bound of support obtainable from this dataset under favorable conditions and should be read as hypothesis-generating, not confirmatory", "polarity": "found", "targets": ["overall result"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[204, 205]], "note": "section divider"}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[206, 207]], "note": "technical appendix heading"}, {"id": 135, "kind": "nonclaim", "subtype": "heading", "lines": [[208, 209]], "note": "descriptive statistics subheading"}, {"id": 136, "kind": "nonclaim", "subtype": "heading", "lines": [[210, 210]], "note": "light-skin players label"}, {"id": 137, "kind": "claim", "lines": [[211, 215]], "assertion": "light-skin descriptive stats: 14,875 dyads, 344 red cards (2.31%), mean 6.68 games/dyad, 45.8% defensive position", "polarity": "found", "targets": ["light-skin players", "descriptive statistics"], "confidence": "high", "shares_lines_with": []}, {"id": 138, "kind": "nonclaim", "subtype": "heading", "lines": [[216, 216]], "note": "dark-skin players label"}, {"id": 139, "kind": "claim", "lines": [[217, 221]], "assertion": "dark-skin descriptive stats: 22,977 dyads, 669 red cards (2.91%), mean 6.36 games/dyad, 46.5% defensive position", "polarity": "found", "targets": ["dark-skin players", "descriptive statistics"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "claim", "lines": [[222, 223]], "assertion": "unadjusted risk difference is 0.60pp (26% relative increase)", "polarity": "found", "targets": ["unadjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "nonclaim", "subtype": "heading", "lines": [[224, 225]], "note": "full model output subheading"}, {"id": 142, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[226, 226]], "note": "code fence open"}, {"id": 143, "kind": "claim", "lines": [[227, 229]], "assertion": "fitted logit model any_red~dark+games+games²+defensive_position with cluster-robust SE by player, N=1,386 clusters, 37,852 observations", "polarity": "did", "targets": ["model fit", "clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[230, 230]], "note": "coefficient table column headers"}, {"id": 145, "kind": "claim", "lines": [[231, 236]], "assertion": "reports regression coefficients: intercept -5.136, dark 0.278 (p=0.001), games 0.197, games² -0.004, pos_defensive 0.420, with SEs/z/CIs", "polarity": "found", "targets": ["regression coefficients"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "nonclaim", "subtype": "heading", "lines": [[237, 237]], "note": "marginal effects label"}, {"id": 147, "kind": "claim", "lines": [[238, 241]], "assertion": "reports marginal effects: dark 0.00715pp (z=3.37, p=0.001), games 0.00508pp, games² -0.00011pp, pos_defensive 0.01084pp", "polarity": "found", "targets": ["marginal effects"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[242, 243]], "note": "code fence close"}, {"id": 149, "kind": "nonclaim", "subtype": "heading", "lines": [[244, 245]], "note": "reproducibility subheading"}, {"id": 150, "kind": "claim", "lines": [[246, 251]], "assertion": "analyses were conducted using Python 3.11 with pandas 2.1.1, numpy 1.24.3, statsmodels 0.14.0, scipy 1.11.3", "polarity": "did", "targets": ["software versions"], "confidence": "high", "shares_lines_with": []}, {"id": 151, "kind": "claim", "lines": [[252, 252]], "assertion": "used random seed 42", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 152, "kind": "claim", "lines": [[253, 254]], "assertion": "complete code was submitted separately as final_analysis.py", "polarity": "did", "targets": ["code"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[255, 256]], "assertion": "asserts results are fully reproducible with no manual adjustments, data fabrication, or selective reporting", "polarity": "did_not", "targets": ["manual adjustments", "data fabrication", "selective reporting"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[257, 258]], "note": "section divider"}, {"id": 155, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[259, 259]], "note": "report preparation date"}, {"id": 156, "kind": "nonclaim", "subtype": "background", "lines": [[260, 260]], "note": "data source provenance"}, {"id": 157, "kind": "nonclaim", "subtype": "framing", "lines": [[261, 261]], "note": "restates the analytic approach used"}, {"id": 158, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[262, 262]], "note": "closing reproducibility footer"}]}}