im", "subtype": "boilerplate", "lines": [[169, 169]], "note": "blank line"}, {"id": 137, "kind": "nonclaim", "subtype": "heading", "lines": [[170, 170]], "note": "subheading: Assumption 6 - Positivity"}, {"id": 138, "kind": "claim", "lines": [[171, 171]], "assertion": "the positivity (overlap) assumption is met", "polarity": "found", "targets": ["positivity assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 139, "kind": "claim", "lines": [[172, 172]], "assertion": "both skin tone groups are represented across positions, leagues, and games played, with no perfect predictors", "polarity": "found", "targets": ["overlap"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "claim", "lines": [[173, 173]], "assertion": "dark-skinned goalkeepers are rare (2.1% of dark-skinned players vs 11% of light-skinned), though not absent", "polarity": "found", "targets": ["goalkeeper overlap"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[174, 176]], "note": "blank lines and divider"}, {"id": 142, "kind": "nonclaim", "subtype": "heading", "lines": [[177, 177]], "note": "section heading: Discussion and Interpretation"}, {"id": 143, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[178, 178]], "note": "blank line"}, {"id": 144, "kind": "claim", "lines": [[179, 179]], "assertion": "the adjusted risk difference (0.32pp, 29% relative increase) translates to approximately 73 excess red cards among the 17,309 dark-skinned dyads", "polarity": "found", "targets": ["excess red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[180, 180]], "note": "blank line"}, {"id": 146, "kind": "nonclaim", "subtype": "heading", "lines": [[181, 181]], "note": "subheading: Contextual Magnitude"}, {"id": 147, "kind": "nonclaim", "subtype": "framing", "lines": [[182, 182]], "note": "lead-in sentence introducing contextualization"}, {"id": 148, "kind": "claim", "lines": [[183, 183]], "assertion": "the baseline risk is 1.11% of light-skinned player-referee dyads resulting in a red card", "polarity": "found", "targets": ["baseline risk"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "nonclaim", "subtype": "framing", "lines": [[184, 184]], "note": "lead-in acknowledging the effect seems small"}, {"id": 150, "kind": "nonclaim", "subtype": "background", "lines": [[185, 185]], "note": "general context that red cards are rare, high-stakes events"}, {"id": 151, "kind": "nonclaim", "subtype": "framing", "lines": [[186, 186]], "note": "editorial framing about cumulative disadvantage over a career"}, {"id": 152, "kind": "claim", "lines": [[187, 187]], "assertion": "a dark-skinned player with 50 career referee encounters would be expected to receive 0.71 red cards vs 0.55 for a light-skinned peer (29% more)", "polarity": "found", "targets": ["projected red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[188, 188]], "note": "blank line"}, {"id": 154, "kind": "nonclaim", "subtype": "heading", "lines": [[189, 189]], "note": "subheading: Comparison to Prior Literature"}, {"id": 155, "kind": "nonclaim", "subtype": "framing", "lines": [[190, 190]], "note": "lead-in claiming alignment with prior research on implicit bias"}, {"id": 156, "kind": "nonclaim", "subtype": "citation", "lines": [[191, 191]], "note": "cites Price & Wolfers 2010 and Parsons et al. 2011 on foul call rates"}, {"id": 157, "kind": "claim", "lines": [[192, 192]], "assertion": "the analysis extends prior work by examining the most severe disciplinary outcome (red cards) rather than yellow cards or fouls", "polarity": "did", "targets": ["outcome choice"], "confidence": "low", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "background", "lines": [[193, 193]], "note": "notes the analysis contributes European evidence to a North-American-dominated literature"}, {"id": 159, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[194, 194]], "note": "blank line"}, {"id": 160, "kind": "nonclaim", "subtype": "heading", "lines": [[195, 195]], "note": "subheading: Practical Implications"}, {"id": 161, "kind": "nonclaim", "subtype": "framing", "lines": [[196, 199]], "note": "forward-looking recommendations (referee training, VAR, monitoring, further research) not actions taken by this analysis"}, {"id": 162, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[200, 200]], "note": "blank line"}, {"id": 163, "kind": "nonclaim", "subtype": "heading", "lines": [[201, 201]], "note": "subheading: Alternative Explanations"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[202, 205]], "note": "acknowledges cannot definitively rule out alternative explanations (playing style, reputation effects, player-referee interaction differences)"}, {"id": 165, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[206, 206]], "note": "blank line"}, {"id": 166, "kind": "nonclaim", "subtype": "heading", "lines": [[207, 207]], "note": "subheading: Strengths of the Analysis"}, {"id": 167, "kind": "nonclaim", "subtype": "framing", "lines": [[208, 213]], "note": "self-assessed list of methodological strengths, restating earlier design choices editorially"}, {"id": 168, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[214, 216]], "note": "blank lines and divider"}, {"id": 169, "kind": "nonclaim", "subtype": "heading", "lines": [[217, 217]], "note": "section heading: Recommendations for Future Research"}, {"id": 170, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[218, 218]], "note": "blank line"}, {"id": 171, "kind": "nonclaim", "subtype": "framing", "lines": [[219, 225]], "note": "recommendations for future research not performed in this analysis"}, {"id": 172, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[226, 228]], "note": "blank lines and divider"}, {"id": 173, "kind": "nonclaim", "subtype": "heading", "lines": [[229, 229]], "note": "section heading: Conclusion"}, {"id": 174, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[230, 230]], "note": "blank line"}, {"id": 175, "kind": "claim", "lines": [[231, 231]], "assertion": "referees are more likely to give red cards to dark-skinned players even after accounting for games played, position, league, and physical characteristics; the hypothesis is SUPPORTED", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": []}, {"id": 176, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[232, 232]], "note": "blank line"}, {"id": 177, "kind": "claim", "lines": [[233, 233]], "assertion": "dark-skinned players face a 0.32 percentage point higher probability of a red card (95% CI 0.07-0.57, p=0.011), a 29% relative increase", "polarity": "found", "targets": ["primary finding"], "confidence": "high", "shares_lines_with": []}, {"id": 178, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[234, 234]], "note": "blank line"}, {"id": 179, "kind": "claim", "lines": [[235, 235]], "assertion": "odds of a red card are 32.7% higher for dark-skinned players (OR=1.33, 95% CI 1.07-1.65, p=0.012)", "polarity": "found", "targets": ["secondary finding"], "confidence": "high", "shares_lines_with": []}, {"id": 180, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[236, 236]], "note": "blank line"}, {"id": 181, "kind": "nonclaim", "subtype": "hedging", "lines": [[237, 237]], "note": "caveats that the observational design cannot establish causality, unmeasured confounding is possible, and generalizability beyond 2012-13 Europe is uncertain, alongside editorializing that evidence is convincing"}, {"id": 182, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[238, 238]], "note": "blank line"}, {"id": 183, "kind": "nonclaim", "subtype": "framing", "lines": [[239, 239]], "note": "broader editorial framing about implicit bias and value of training/monitoring/technology"}, {"id": 184, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[240, 242]], "note": "blank lines and divider"}, {"id": 185, "kind": "nonclaim", "subtype": "heading", "lines": [[243, 243]], "note": "section heading: Appendix Technical Details"}, {"id": 186, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[244, 244]], "note": "blank line"}, {"id": 187, "kind": "nonclaim", "subtype": "heading", "lines": [[245, 245]], "note": "subheading: Data Source"}, {"id": 188, "kind": "nonclaim", "subtype": "background", "lines": [[246, 246]], "note": "restates dataset description (player-referee dyad data from European leagues)"}, {"id": 189, "kind": "nonclaim", "subtype": "background", "lines": [[247, 247]], "note": "data file path"}, {"id": 190, "kind": "nonclaim", "subtype": "background", "lines": [[248, 248]], "note": "codebook file path"}, {"id": 191, "kind": "nonclaim", "subtype": "background", "lines": [[249, 249]], "note": "dataset provenance: collected by a sports statistics company covering 2012-2013"}, {"id": 192, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[250, 250]], "note": "blank line"}, {"id": 193, "kind": "nonclaim", "subtype": "heading", "lines": [[251, 251]], "note": "subheading: Reproducibility"}, {"id": 194, "kind": "nonclaim", "subtype": "background", "lines": [[252, 252]], "note": "analysis code file path"}, {"id": 195, "kind": "nonclaim", "subtype": "background", "lines": [[253, 253]], "note": "figures file path"}, {"id": 196, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[254, 254]], "note": "list of software versions used"}, {"id": 197, "kind": "claim", "lines": [[255, 255]], "assertion": "a random seed of 42 was set for any stochastic procedures", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 198, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[256, 256]], "note": "runtime note: under 1 minute on standard hardware"}, {"id": 199, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[257, 257]], "note": "blank line"}, {"id": 200, "kind": "nonclaim", "subtype": "heading", "lines": [[258, 258]], "note": "subheading: Complete Variable List Used"}, {"id": 201, "kind": "claim", "lines": [[259, 259]], "assertion": "the outcome was coded as anyRedCard (binary: 1 if redCards>0, else 0)", "polarity": "did", "targets": ["outcome coding"], "confidence": "high", "shares_lines_with": []}, {"id": 202, "kind": "claim", "lines": [[260, 260]], "assertion": "the exposure was coded as darkSkin (binary: 1 if skinTone>=0.75, 0 if skinTone<=0.125)", "polarity": "did", "targets": ["exposure coding"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "claim", "lines": [[261, 261]], "assertion": "the final covariate set used was games_std, position dummies (Defender/Forward/Midfielder/Missing), league dummies (England/France/Spain), height_std, and weight_std", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 204, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[262, 262]], "note": "blank line"}, {"id": 205, "kind": "nonclaim", "subtype": "heading", "lines": [[263, 263]], "note": "subheading: Model Diagnostics"}, {"id": 206, "kind": "claim", "lines": [[264, 264]], "assertion": "the model converged successfully in 9 iterations", "polarity": "found", "targets": ["convergence"], "confidence": "high", "shares_lines_with": []}, {"id": 207, "kind": "claim", "lines": [[265, 265]], "assertion": "the pseudo R-squared of 0.0739 indicates covariates explain about 7.4% of deviance", "polarity": "found", "targets": ["pseudo R-squared"], "confidence": "high", "shares_lines_with": []}, {"id": 208, "kind": "claim", "lines": [[266, 266]], "assertion": "all variance inflation factors are below 3, indicating no concerning multicollinearity", "polarity": "found", "targets": ["VIF"], "confidence": "high", "shares_lines_with": []}, {"id": 209, "kind": "claim", "lines": [[267, 267]], "assertion": "sample size is adequate: 814 events with 11 parameters yields 74 events per variable, exceeding the 10 EPV guideline", "polarity": "found", "targets": ["events per variable"], "confidence": "high", "shares_lines_with": []}, {"id": 210, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[268, 268]], "note": "blank line"}, {"id": 211, "kind": "nonclaim", "subtype": "heading", "lines": [[269, 269]], "note": "subheading: Statistical Software Citations"}, {"id": 212, "kind": "nonclaim", "subtype": "citation", "lines": [[270, 270]], "note": "McKinney 2010 citation"}, {"id": 213, "kind": "nonclaim", "subtype": "citation", "lines": [[271, 271]], "note": "Seabold & Perktold 2010 citation"}, {"id": 214, "kind": "nonclaim", "subtype": "citation", "lines": [[272, 272]], "note": "Harris et al. 2020 citation"}, {"id": 215, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[273, 274]], "note": "blank line and end-of-tool-output marker"}]}}