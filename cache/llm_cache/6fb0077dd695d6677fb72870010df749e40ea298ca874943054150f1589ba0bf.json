], "assertion": "a sensitivity analysis was run treating skin tone as continuous rather than binary", "polarity": "did", "targets": ["skin tone"], "confidence": "high", "shares_lines_with": [148]}, {"id": 148, "kind": "claim", "lines": [[153, 153]], "assertion": "the continuous-skin-tone analysis found OR=1.088 per 0.25-unit increase, p=0.0041", "polarity": "found", "targets": ["odds ratio", "skin tone"], "confidence": "high", "shares_lines_with": [147]}, {"id": 149, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[154, 154]], "note": "blank line"}, {"id": 150, "kind": "claim", "lines": [[155, 155]], "assertion": "all sensitivity analyses support the same directional conclusion, though effect sizes vary with sample composition and exposure contrast", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "high", "shares_lines_with": []}, {"id": 151, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[156, 156]], "note": "blank line"}, {"id": 152, "kind": "nonclaim", "subtype": "heading", "lines": [[157, 157]], "note": "Interpretation heading"}, {"id": 153, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[158, 158]], "note": "blank line"}, {"id": 154, "kind": "claim", "lines": [[159, 159]], "assertion": "after adjustment, dark-skinned field players face a significantly higher probability of receiving red cards", "polarity": "found", "targets": ["red card", "skin tone"], "confidence": "high", "shares_lines_with": [155]}, {"id": 155, "kind": "claim", "lines": [[159, 159]], "assertion": "the adjusted effect cannot be explained by confounding from measured covariates", "polarity": "found", "targets": ["risk difference"], "confidence": "medium", "shares_lines_with": [154]}, {"id": 156, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[160, 160]], "note": "blank line"}, {"id": 157, "kind": "nonclaim", "subtype": "heading", "lines": [[161, 161]], "note": "Limitations and Caveats heading"}, {"id": 158, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[162, 162]], "note": "blank line"}, {"id": 159, "kind": "claim", "lines": [[163, 163]], "assertion": "the analytic choices (exclusions, thresholds, model specification) were informed by preliminary exploration of the data and selected to maximize signal while remaining defensible", "polarity": "did", "targets": ["analytic choices"], "confidence": "high", "shares_lines_with": [160]}, {"id": 160, "kind": "claim", "lines": [[163, 163]], "assertion": "confirmatory testing in independent data with preregistered methods was not conducted as part of this analysis", "polarity": "did_not", "targets": ["confirmatory testing"], "confidence": "medium", "shares_lines_with": [159]}, {"id": 161, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[164, 164]], "note": "blank line"}, {"id": 162, "kind": "nonclaim", "subtype": "hedging", "lines": [[165, 165]], "note": "general caveat that unmeasured confounders may remain"}, {"id": 163, "kind": "claim", "lines": [[166, 166]], "assertion": "the analysis did not capture player behavior/aggression beyond yellow cards and goals", "polarity": "did_not", "targets": ["yellowCards", "goals"], "confidence": "medium", "shares_lines_with": []}, {"id": 164, "kind": "claim", "lines": [[167, 167]], "assertion": "the analysis did not account for player quality/star status as a potential confounder", "polarity": "did_not", "targets": ["player quality"], "confidence": "medium", "shares_lines_with": []}, {"id": 165, "kind": "claim", "lines": [[168, 168]], "assertion": "the analysis did not measure context of play such as score differential or match importance", "polarity": "did_not", "targets": ["context of play"], "confidence": "medium", "shares_lines_with": []}, {"id": 166, "kind": "claim", "lines": [[169, 169]], "assertion": "the analysis did not include referee-specific effects beyond country-level bias measures", "polarity": "did_not", "targets": ["referee effects", "meanIAT", "meanExp"], "confidence": "medium", "shares_lines_with": []}, {"id": 167, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[170, 170]], "note": "blank line"}, {"id": 168, "kind": "nonclaim", "subtype": "hedging", "lines": [[171, 171]], "note": "caveat that excluding 76% of dyads may introduce selection bias, noting a ≥2-games sensitivity check for robustness"}, {"id": 169, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[172, 172]], "note": "blank line"}, {"id": 170, "kind": "nonclaim", "subtype": "hedging", "lines": [[173, 173]], "note": "caveat about subjective measurement error in skin tone rating and its likely bias direction"}, {"id": 171, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[174, 174]], "note": "blank line"}, {"id": 172, "kind": "nonclaim", "subtype": "hedging", "lines": [[175, 175]], "note": "caveat about generalizability limits of the male, four-league, 2012-2013 sample"}, {"id": 173, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[176, 176]], "note": "blank line"}, {"id": 174, "kind": "nonclaim", "subtype": "hedging", "lines": [[177, 177]], "note": "caveat that dyad-level aggregation may obscure within-dyad heterogeneity"}, {"id": 175, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[178, 178]], "note": "blank line"}, {"id": 176, "kind": "claim", "lines": [[179, 179]], "assertion": "no adjustment for multiple comparisons was made across the reported sensitivity analyses", "polarity": "did_not", "targets": ["multiple comparisons"], "confidence": "high", "shares_lines_with": [177]}, {"id": 177, "kind": "claim", "lines": [[179, 179]], "assertion": "the primary analysis specification was selected a priori as the most supportive of the hypothesis", "polarity": "did", "targets": ["primary analysis specification"], "confidence": "high", "shares_lines_with": [176]}, {"id": 178, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[180, 180]], "note": "blank line"}, {"id": 179, "kind": "nonclaim", "subtype": "heading", "lines": [[181, 181]], "note": "Why This Specification Is Defensible heading"}, {"id": 180, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[182, 182]], "note": "blank line"}, {"id": 181, "kind": "nonclaim", "subtype": "framing", "lines": [[183, 183]], "note": "intro sentence to defensibility list"}, {"id": 182, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[184, 184]], "note": "blank line"}, {"id": 183, "kind": "claim", "lines": [[185, 185]], "assertion": "excluding goalkeepers is justified as widely accepted practice in soccer analytics", "polarity": "did", "targets": ["goalkeepers"], "confidence": "high", "shares_lines_with": []}, {"id": 184, "kind": "claim", "lines": [[186, 186]], "assertion": "requiring ≥3 games is justified as standard practice for improving measurement reliability in repeated-measures designs", "polarity": "did", "targets": ["games"], "confidence": "high", "shares_lines_with": []}, {"id": 185, "kind": "claim", "lines": [[187, 187]], "assertion": "the median split for exposure is justified as a natural, pre-specified threshold that maximizes power", "polarity": "did", "targets": ["skin tone", "threshold"], "confidence": "high", "shares_lines_with": []}, {"id": 186, "kind": "claim", "lines": [[188, 188]], "assertion": "covariate selection is justified as based on established confounders in the sports bias literature", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 187, "kind": "claim", "lines": [[189, 189]], "assertion": "logistic regression is justified as the gold-standard method for binary outcomes in observational studies", "polarity": "did", "targets": ["logistic regression"], "confidence": "high", "shares_lines_with": []}, {"id": 188, "kind": "claim", "lines": [[190, 190]], "assertion": "marginal standardization is justified as the recommended method for computing risk differences from logistic models", "polarity": "did", "targets": ["marginal standardization"], "confidence": "high", "shares_lines_with": []}, {"id": 189, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[191, 191]], "note": "blank line"}, {"id": 190, "kind": "nonclaim", "subtype": "heading", "lines": [[192, 192]], "note": "Implications for Future Research heading"}, {"id": 191, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[193, 193]], "note": "blank line"}, {"id": 192, "kind": "claim", "lines": [[194, 194]], "assertion": "the analysis establishes proof of concept that a measurable skin-tone/red-card association exists in this dataset, modest but substantively important given the high-stakes context", "polarity": "found", "targets": ["skin tone", "red card"], "confidence": "high", "shares_lines_with": []}, {"id": 193, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[195, 195]], "note": "blank line"}, {"id": 194, "kind": "nonclaim", "subtype": "framing", "lines": [[196, 201]], "note": "recommended future-research next steps (preregistered replication, match-level analysis, referee heterogeneity, experimental designs, mechanism exploration) — not actions taken in this analysis"}, {"id": 195, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[202, 202]], "note": "blank line"}, {"id": 196, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[203, 203]], "note": "divider"}, {"id": 197, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[204, 204]], "note": "blank line"}, {"id": 198, "kind": "nonclaim", "subtype": "heading", "lines": [[205, 205]], "note": "Reproducibility Statement heading"}, {"id": 199, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[206, 206]], "note": "blank line"}, {"id": 200, "kind": "claim", "lines": [[207, 207]], "assertion": "the complete analysis script is provided and generates identical results when run with the provided data and codebook", "polarity": "did", "targets": ["final_analysis.py", "soccer.csv", "codebook.txt"], "confidence": "high", "shares_lines_with": []}, {"id": 201, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[208, 208]], "note": "blank line"}, {"id": 202, "kind": "nonclaim", "subtype": "heading", "lines": [[209, 209]], "note": "Software label"}, {"id": 203, "kind": "claim", "lines": [[210, 214]], "assertion": "the analysis used Python 3.11.0, pandas 2.1.3, numpy 1.26.2, statsmodels 0.14.0, and scipy 1.11.4", "polarity": "did", "targets": ["software versions"], "confidence": "high", "shares_lines_with": []}, {"id": 204, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[215, 215]], "note": "blank line"}, {"id": 205, "kind": "claim", "lines": [[216, 216]], "assertion": "a random seed of 42 was set for the parametric bootstrap", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 206, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[217, 217]], "note": "blank line"}, {"id": 207, "kind": "claim", "lines": [[218, 218]], "assertion": "the analysis runtime was approximately 15 seconds on standard hardware", "polarity": "found", "targets": ["runtime"], "confidence": "medium", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[219, 219]], "note": "blank line"}, {"id": 209, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[220, 220]], "note": "divider"}, {"id": 210, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[221, 221]], "note": "blank line"}, {"id": 211, "kind": "nonclaim", "subtype": "heading", "lines": [[222, 222]], "note": "Summary Table heading"}, {"id": 212, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[223, 223]], "note": "blank line"}, {"id": 213, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[224, 224]], "note": "table header row"}, {"id": 214, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[225, 225]], "note": "table divider row"}, {"id": 215, "kind": "claim", "lines": [[226, 226]], "assertion": "table restates the risk difference result: 0.55pp, 95% CI [0.21,0.88], p=0.0019", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 216, "kind": "claim", "lines": [[227, 227]], "assertion": "table restates the odds ratio result: 1.243, 95% CI [1.079,1.433], p=0.0026", "polarity": "found", "targets": ["odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 217, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 228]], "note": "blank line"}, {"id": 218, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[229, 229]], "note": "divider"}, {"id": 219, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[230, 230]], "note": "blank line"}, {"id": 220, "kind": "nonclaim", "subtype": "heading", "lines": [[231, 231]], "note": "Data Quality and Transparency heading"}, {"id": 221, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[232, 232]], "note": "blank line"}, {"id": 222, "kind": "claim", "lines": [[233, 233]], "assertion": "the original dataset had 146,028 dyads", "polarity": "found", "targets": ["dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 223, "kind": "claim", "lines": [[234, 234]], "assertion": "35,228 dyads (24.1%) remained after exclusions", "polarity": "found", "targets": ["dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 224, "kind": "claim", "lines": [[235, 235]], "assertion": "exclusion criteria are documented with counts and rationales", "polarity": "did", "targets": ["exclusion criteria"], "confidence": "medium", "shares_lines_with": []}, {"id": 225, "kind": "claim", "lines": [[236, 236]], "assertion": "missing data was handled via median imputation for height/weight and complete-case analysis otherwise", "polarity": "did", "targets": ["height", "weight", "missing data"], "confidence": "high", "shares_lines_with": []}, {"id": 226, "kind": "claim", "lines": [[237, 237]], "assertion": "skin tone was transformed by averaging raters and binarizing exposure at threshold 0.25", "polarity": "did", "targets": ["skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 227, "kind": "claim", "lines": [[238, 238]], "assertion": "the full reproducible analysis script is available", "polarity": "did", "targets": ["final_analysis.py"], "confidence": "medium", "shares_lines_with": []}, {"id": 228, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[239, 239]], "note": "blank line"}, {"id": 229, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[240, 240]], "note": "divider"}, {"id": 230, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[241, 241]], "note": "blank line"}, {"id": 231, "kind": "nonclaim", "subtype": "heading", "lines": [[242, 242]], "note": "Conclusion Statement heading"}, {"id": 232, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[243, 243]], "note": "blank line"}, {"id": 233, "kind": "claim", "lines": [[244, 244]], "assertion": "the hypothesis is supported: dark-skinned players had significantly higher red card probability (RD=0.55pp, 95% CI [0.21,0.88], p=0.0019) after covariate adjustment", "polarity": "found", "targets": ["risk difference", "red card"], "confidence": "high", "shares_lines_with": [234]}, {"id": 234, "kind": "claim", "lines": [[244, 244]], "assertion": "the effect is robust to alternative specifications and represents a substantively meaningful disparity in referee treatment", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": [233]}, {"id": 235, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[245, 245]], "note": "blank line"}, {"id": 236, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[246, 246]], "note": "divider"}, {"id": 237, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[247, 247]], "note": "blank line"}, {"id": 238, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[248, 248]], "note": "END OF REPORT marker"}]}}