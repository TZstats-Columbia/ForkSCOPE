", "lines": [[145, 145]], "assertion": "the point estimate is positive but the CI width indicates substantial uncertainty about direction, insufficient to conclude systematic bias", "polarity": "found", "targets": ["direction", "confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 138, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[146, 146]], "note": "blank line"}, {"id": 139, "kind": "claim", "lines": [[147, 147]], "assertion": "the 0.17pp difference is within a range plausibly explained by sampling variability, unmeasured confounding, or model specification uncertainty", "polarity": "found", "targets": ["risk difference", "effect size"], "confidence": "low", "shares_lines_with": []}, {"id": 140, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[148, 148]], "note": "blank line"}, {"id": 141, "kind": "nonclaim", "subtype": "heading", "lines": [[149, 149]], "note": "subheading"}, {"id": 142, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[150, 150]], "note": "blank line"}, {"id": 143, "kind": "claim", "lines": [[151, 151]], "assertion": "the analysis adjusted for games, position, physical characteristics, league, referee bias, and clustered by player and referee", "polarity": "did", "targets": ["covariates", "clustering"], "confidence": "high", "shares_lines_with": [144]}, {"id": 144, "kind": "claim", "lines": [[151, 151]], "assertion": "a small positive but statistically non-significant association was found, CI includes zero, p>0.05, effect substantively small, hypothesis not supported", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [143]}, {"id": 145, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[152, 152]], "note": "blank line"}, {"id": 146, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[153, 153]], "note": "horizontal rule"}, {"id": 147, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[154, 154]], "note": "blank line"}, {"id": 148, "kind"