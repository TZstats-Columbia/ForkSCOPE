o sparsity", "polarity": "did_not", "targets": ["referee fixed effects"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "nonclaim", "subtype": "hedging", "lines": [[162, 163]], "note": "team effects and match importance as unmeasured confounders"}, {"id": 131, "kind": "nonclaim", "subtype": "heading", "lines": [[164, 165]], "note": "6.5 sub-heading"}, {"id": 132, "kind": "nonclaim", "subtype": "hedging", "lines": [[166, 168]], "note": "observational design cannot establish causation, no randomization, selection concerns"}, {"id": 133, "kind": "claim", "lines": [[169, 169]], "assertion": "dark-skinned players are disproportionately represented in the England/France leagues", "polarity": "found", "targets": ["league distribution by skin tone"], "confidence": "medium", "shares_lines_with": []}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[170, 171]], "note": "6.6 sub-heading"}, {"id": 135, "kind": "nonclaim", "subtype": "hedging", "lines": [[172, 175]], "note": "measurement limitations: photo-based rating, binary exposure, rare outcome, dyad-level unit"}, {"id": 136, "kind": "nonclaim", "subtype": "heading", "lines": [[176, 177]], "note": "6.7 sub-heading"}, {"id": 137, "kind": "nonclaim", "subtype": "hedging", "lines": [[178, 179]], "note": "restates missing-data percentages as a limitation"}, {"id": 138, "kind": "claim", "lines": [[180, 180]], "assertion": "missingness was slightly higher for dark-skinned players", "polarity": "found", "targets": ["missingness by skin tone"], "confidence": "medium", "shares_lines_with": []}, {"id": 139, "kind": "nonclaim", "subtype": "hedging", "lines": [[181, 181]], "note": "complete case analysis may introduce selection bias if not MCAR"}, {"id": 140, "kind": "nonclaim", "subtype": "heading", "lines": [[182, 183]], "note": "6.8 sub-heading"}, {"id": 141, "kind": "nonclaim", "subtype": "hedging", "lines": [[184, 184]], "note": "notes LPM's constant-additive-effect assumption"}, {"id": 142, "