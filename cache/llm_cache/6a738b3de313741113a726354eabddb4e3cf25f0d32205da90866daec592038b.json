129, "kind": "nonclaim", "subtype": "heading", "lines": [[161, 163]], "note": "subsection heading + blank"}, {"id": 130, "kind": "claim", "lines": [[164, 164]], "assertion": "the outcome was defined as any red card across all games between a player-referee pair, a choice acknowledged to collapse temporal and contextual variation", "polarity": "did", "targets": ["outcome aggregation"], "confidence": "medium", "shares_lines_with": []}, {"id": 131, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[165, 165]], "note": "blank line"}, {"id": 132, "kind": "claim", "lines": [[166, 166]], "assertion": "the analysis did not distinguish between direct red cards and second yellow cards (yellow-reds)", "polarity": "did_not", "targets": ["red card type"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[167, 167]], "note": "blank line"}, {"id": 134, "kind": "claim", "lines": [[168, 168]], "assertion": "skin tone was dichotomized into light vs dark, a choice acknowledged to discard information and possibly obscure non-linear relationships", "polarity": "did", "targets": ["skin tone dichotomization"], "confidence": "medium", "shares_lines_with": [135]}, {"id": 135, "kind": "claim", "lines": [[168, 168]], "assertion": "a continuous skin-tone analysis was conducted that partially addressed the dichotomization issue", "polarity": "did", "targets": ["continuous analysis"], "confidence": "medium", "shares_lines_with": [134]}, {"id": 136, "kind": "nonclaim", "subtype": "heading", "lines": [[169, 171]], "note": "subsection heading + blank"}, {"id": 137, "kind": "claim", "lines": [[172, 172]], "assertion": "the causal interpretation of the risk difference assumes no unmeasured confounding, which the authors note is untestable and unlikely to be fully met", "polarity": "did", "targets": ["unmeasured confounding assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 138, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[173, 173]], "note": "blank line"}, {"id": 139, "kind": "claim", "lines": [[174, 174]], "assertion": "a logistic model with linear effects of standardized continuous variables and additive covariate effects was assumed", "polarity": "did", "targets": ["model specification assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[175, 175]], "note": "blank line"}, {"id": 141, "kind": "claim", "lines": [[176, 176]], "assertion": "standard errors were clustered by player, assuming independence of observations across players", "polarity": "did", "targets": ["clustering assumption"], "confidence": "medium", "shares_lines_with": [142]}, {"id": 142, "kind": "claim", "lines": [[176, 176]], "assertion": "the analysis did not account for referee-level clustering despite the cross-classified structure, which could underestimate standard errors", "polarity": "did_not", "targets": ["referee clustering"], "confidence": "high", "shares_lines_with": [141]}, {"id": 143, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[177, 177]], "note": "blank line"}, {"id": 144, "kind": "claim", "lines": [[178, 178]], "assertion": "the analysis did not test for interactions/effect modification between skin tone and other variables such as position or league", "polarity": "did_not", "targets": ["effect modification"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "nonclaim", "subtype": "heading", "lines": [[179, 181]], "note": "subsection heading + blank"}, {"id": 146, "kind": "nonclaim", "subtype": "hedging", "lines": [[182, 182]], "note": "generalizability caveat re: single season/leagues"}, {"id": 147, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[183, 183]], "note": "blank line"}, {"id": 148, "kind": "nonclaim", "subtype": "hedging", "lines": [[184, 184]], "note": "cultural-context generalizability caveat"}, {"id": 149, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[185, 185]], "note": "blank line"}, {"id": 150, "kind": "claim", "lines": [[186, 186]], "assertion": "the light/dark cutpoints (0.0-0.25 / 0.75-1.0) were chosen to maximize contrast, an acknowledged somewhat arbitrary choice", "polarity": "did", "targets": ["skin tone cutpoints"], "confidence": "medium", "shares_lines_with": []}, {"id": 151, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[187, 187]], "note": "blank line"}, {"id": 152, "kind": "nonclaim", "subtype": "heading", "lines": [[188, 189]], "note": "subsection heading + blank"}, {"id": 153, "kind": "nonclaim", "subtype": "hedging", "lines": [[190, 190]], "note": "speculative power discussion, no specific action"}, {"id": 154, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[191, 191]], "note": "blank line"}, {"id": 155, "kind": "claim", "lines": [[192, 192]], "assertion": "a post-hoc power calculation estimated approximately 40-50% power to detect an effect of this magnitude at α=0.05", "polarity": "found", "targets": ["statistical power"], "confidence": "high", "shares_lines_with": []}, {"id": 156, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[193, 195]], "note": "blank/divider/blank"}, {"id": 157, "kind": "nonclaim", "subtype": "heading", "lines": [[196, 197]], "note": "section 7 heading + blank"}, {"id": 158, "kind": "nonclaim", "subtype": "heading", "lines": [[198, 198]], "note": "subsection heading"}, {"id": 159, "kind": "claim", "lines": [[199, 199]], "assertion": "the study's findings of a small, non-significant, positive association are judged broadly consistent with the mixed prior literature on referee racial bias (citing Parsons et al. 2011)", "polarity": "found", "targets": ["prior literature comparison"], "confidence": "medium", "shares_lines_with": []}, {"id": 160, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[200, 200]], "note": "blank line"}, {"id": 161, "kind": "nonclaim", "subtype": "heading", "lines": [[201, 201]], "note": "subsection heading"}, {"id": 162, "kind": "nonclaim", "subtype": "framing", "lines": [[202, 202]], "note": "sets up hypothetical alternative-explanations discussion"}, {"id": 163, "kind": "nonclaim", "subtype": "hedging", "lines": [[203, 203]], "note": "stereotype-threat speculation"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[204, 204]], "note": "media-attention speculation"}, {"id": 165, "kind": "nonclaim", "subtype": "hedging", "lines": [[205, 205]], "note": "referee-heterogeneity speculation"}, {"id": 166, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[206, 206]], "note": "blank line"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[207, 207]], "note": "subsection heading"}, {"id": 168, "kind": "claim", "lines": [[208, 208]], "assertion": "the consistent effect direction across models and a significant association between referee-country implicit bias and red cards are interpreted as suggesting bias may operate systemically even though not detectable at the individual player-referee level in this sample", "polarity": "found", "targets": ["referee country implicit bias", "systemic bias"], "confidence": "medium", "shares_lines_with": []}, {"id": 169, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[209, 211]], "note": "blank/divider/blank"}, {"id": 170, "kind": "nonclaim", "subtype": "heading", "lines": [[212, 213]], "note": "'METHODOLOGICAL SUMMARY' heading + blank"}, {"id": 171, "kind": "nonclaim", "subtype": "framing", "lines": [[214, 214]], "note": "self-assessment lead-in, no specific new action"}, {"id": 172, "kind": "claim", "lines": [[215, 215]], "assertion": "the light vs dark skin contrast was pre-specified a priori based on the scale structure", "polarity": "did", "targets": ["pre-specified contrast"], "confidence": "high", "shares_lines_with": []}, {"id": 173, "kind": "claim", "lines": [[216, 216]], "assertion": "theoretically motivated covariates were included for confounding adjustment", "polarity": "did", "targets": ["covariate selection"], "confidence": "low", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[217, 217]], "assertion": "cluster-robust standard errors and bootstrap confidence intervals were used for uncertainty quantification", "polarity": "did", "targets": ["standard errors", "bootstrap CIs"], "confidence": "low", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[218, 218]], "assertion": "sensitivity analyses were used to test robustness to modeling choices", "polarity": "did", "targets": ["sensitivity analyses"], "confidence": "low", "shares_lines_with": []}, {"id": 176, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[219, 219]], "note": "self-assessment claim about reporting transparency, not a data operation"}, {"id": 177, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[220, 220]], "note": "blank line"}, {"id": 178, "kind": "claim", "lines": [[221, 221]], "assertion": "the non-significant result is interpreted as reflecting genuine data uncertainty rather than methodological shortcomings; the hypothesis is judged not supported but not definitively refuted", "polarity": "found", "targets": ["overall conclusion"], "confidence": "medium", "shares_lines_with": []}, {"id": 179, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[222, 224]], "note": "blank/divider/blank"}, {"id": 180, "kind": "nonclaim", "subtype": "heading", "lines": [[225, 226]], "note": "'DATA AND CODE AVAILABILITY' heading + blank"}, {"id": 181, "kind": "claim", "lines": [[227, 227]], "assertion": "the analyses are stated to be fully reproducible from the provided dataset and code (final_analysis.py)", "polarity": "did", "targets": ["reproducibility", "code"], "confidence": "high", "shares_lines_with": []}, {"id": 182, "kind": "claim", "lines": [[228, 230]], "assertion": "key results are restated: primary adjusted risk difference +0.171pp (95% CI -0.059 to 0.431, p=0.172); secondary adjusted odds ratio 1.147 (95% CI 0.908-1.4