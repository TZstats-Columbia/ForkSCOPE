]], "assertion": "missing covariate data appears minimal and likely missing at random", "polarity": "found", "targets": ["missing covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 87, "kind": "claim", "lines": [[110, 110]], "assertion": "a sensitivity analysis including medium skin tone yielded similar results to the primary analysis", "polarity": "found", "targets": ["sensitivity analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 88, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[111, 111]], "note": "blank line"}, {"id": 89, "kind": "nonclaim", "subtype": "heading", "lines": [[112, 112]], "note": "subsection heading"}, {"id": 90, "kind": "claim", "lines": [[113, 113]], "assertion": "continuous variables were standardized to mean=0, SD=1", "polarity": "did", "targets": ["continuous variables"], "confidence": "high", "shares_lines_with": []}, {"id": 91, "kind": "claim", "lines": [[114, 114]], "assertion": "categorical variables were entered as dummy variables with reference categories Attacking Midfielder (position) and England (league)", "polarity": "did", "targets": ["categorical variables"], "confidence": "high", "shares_lines_with": []}, {"id": 92, "kind": "claim", "lines": [[115, 115]], "assertion": "skin tone was averaged across the two raters", "polarity": "did", "targets": ["skin tone", "raters"], "confidence": "high", "shares_lines_with": [93]}, {"id": 93, "kind": "claim", "lines": [[115, 115]], "assertion": "the averaged skin tone score was then dichotomized into light vs dark for the primary analysis", "polarity": "did", "targets": ["skin tone", "primary analysis"], "confidence": "high", "shares_lines_with": [92]}, {"id": 94, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[116, 118]], "note": "blank/divider/blank"}, {"id": 95, "kind": "nonclaim", "subtype": "heading", "lines": [[119, 120]], "note": "section 4 heading + blank"}, {"id": 96, "kind": "claim", "lines": [[121, 121]], "assertion": "three sensi