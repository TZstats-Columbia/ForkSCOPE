strap"], "confidence": "high", "shares_lines_with": []}, {"id": 82, "kind": "claim", "lines": [[93, 93]], "assertion": "the p-value was obtained via normal approximation using the z-statistic from the bootstrap standard error", "polarity": "did", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 83, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[94, 94]], "note": "blank line"}, {"id": 84, "kind": "nonclaim", "subtype": "heading", "lines": [[95, 95]], "note": "Exclusions heading"}, {"id": 85, "kind": "claim", "lines": [[96, 96]], "assertion": "21,407 dyads (14.66%) were excluded due to missing skin tone rater information", "polarity": "did", "targets": ["exclusions", "skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 86, "kind": "claim", "lines": [[97, 97]], "assertion": "467 of 2,053 players lacked available photos", "polarity": "found", "targets": ["missing photos"], "confidence": "high", "shares_lines_with": []}, {"id": 87, "kind": "claim", "lines": [[98, 98]], "assertion": "excluded dyads had slightly lower red card rates (1.14% vs 1.28%), suggesting potential selection bias toward more prominent players", "polarity": "found", "targets": ["excluded dyads", "selection bias"], "confidence": "high", "shares_lines_with": []}, {"id": 88, "kind": "claim", "lines": [[99, 99]], "assertion": "missing anthropometrics (46 height, 753 weight) were imputed with median values", "polarity": "did", "targets": ["anthropometrics", "imputation"], "confidence": "high", "shares_lines_with": []}, {"id": 89, "kind": "claim", "lines": [[100, 100]], "assertion": "no other exclusions were applied beyond the ones described", "polarity": "did_not", "targets": ["exclusions"], "confidence": "high", "shares_lines_with": []}, {"id": 90, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[101, 101]], "note": "blank line"}, {"id": 91, "kind": "nonclaim", "subtype": "heading", "lines": [[102, 102]], "note": "Transformations heading"}, {