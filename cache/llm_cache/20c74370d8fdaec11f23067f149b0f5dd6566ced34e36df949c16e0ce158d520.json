], "note": "blank line"}, {"id": 33, "kind": "claim", "lines": [[38, 38]], "assertion": "the odds ratio result is not statistically significant (p=0.069>0.05), CI barely includes 1.0", "polarity": "found", "targets": ["statistical significance"], "confidence": "high", "shares_lines_with": []}, {"id": 34, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[39, 39]], "note": "blank line"}, {"id": 35, "kind": "claim", "lines": [[40, 40]], "assertion": "the adjusted odds of a red card are 14.5% higher for dark-skinned players but this estimate is less precise and not conventionally significant", "polarity": "found", "targets": ["odds ratio"], "confidence": "high", "shares_lines_with": [36]}, {"id": 36, "kind": "claim", "lines": [[40, 40]], "assertion": "the discrepancy between the risk-difference and odds-ratio results is explained by the rare-event nature of red cards and the nonlinear odds-ratio scale", "polarity": "found", "targets": ["odds ratio", "risk difference"], "confidence": "medium", "shares_lines_with": [35]}, {"id": 37, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[41, 43]], "note": "blank + divider + blank"}, {"id": 38, "kind": "nonclaim", "subtype": "heading", "lines": [[44, 46]], "note": "section 3 and subsection heading"}, {"id": 39, "kind": "claim", "lines": [[47, 47]], "assertion": "the unit of analysis is the player-referee dyad, representing all encounters between one player and one referee", "polarity": "did", "targets": ["unit of analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 40, "kind": "claim", "lines": [[48, 48]], "assertion": "the sample size is 124,621 dyads", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 41, "kind": "claim", "lines": [[49, 49]], "assertion": "the sample contains 1,585 unique players", "polarity": "found", "targets": ["players"], "confidence": "high", "shares_lines_with": []}, {"id": 42, "kind": "claim", "lines": [[50, 50]], "asserti