]], "assertion": "the hypothesis is SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[155, 155]], "note": "blank"}, {"id": 134, "kind": "claim", "lines": [[156, 156]], "assertion": "the hypothesis that referees give more red cards to dark-skinned players is supported by the data", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [135]}, {"id": 135, "kind": "claim", "lines": [[156, 156]], "assertion": "the adjusted risk difference (0.185pp, CI 0.025-0.358, p=0.030) is significant and represents a 15% relative increase", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": [134]}, {"id": 136, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[157, 157]], "note": "blank"}, {"id": 137, "kind": "nonclaim", "subtype": "heading", "lines": [[158, 158]], "note": "Magnitude and Practical Significance subheading"}, {"id": 138, "kind": "claim", "lines": [[159, 159]], "assertion": "the absolute effect is small (<0.2pp) but non-trivial", "polarity": "found", "targets": ["effect magnitude"], "confidence": "medium", "shares_lines_with": []}, {"id": 139, "kind": "claim", "lines": [[160, 160]], "assertion": "baseline red card rate is 1.23% for light-skinned players", "polarity": "found", "targets": ["baseline rate"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "claim", "lines": [[161, 161]], "assertion": "elevated rate is 1.40% for dark-skinned players, all else equal", "polarity": "found", "targets": ["elevated rate"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "claim", "lines": [[162, 162]], "assertion": "relative increase is approximately 15%", "polarity": "found", "targets": ["relative increase"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "claim", "lines": [[163, 163]], "assertion": "a number-needed-to-harm style statistic is asserted (text is garbled/truncated), implying roughly one additional red card per some number of dark- vs light-skin dyads", "polarity": "found", "targets": ["number needed to harm"], "confidence": "low", "shares_lines_with": []}, {"id": 143, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[164, 164]], "note": "blank"}, {"id": 144, "kind": "claim", "lines": [[165, 165]], "assertion": "the difference accumulates across careers and could affect disciplinary records, suspensions, and reputations of darker-skinned players", "polarity": "found", "targets": ["career impact"], "confidence": "medium", "shares_lines_with": []}, {"id": 145, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[166, 166]], "note": "blank"}, {"id": 146, "kind": "nonclaim", "subtype": "heading", "lines": [[167, 167]], "note": "Direction and Uncertainty subheading"}, {"id": 147, "kind": "claim", "lines": [[168, 168]], "assertion": "the direction of effect is consistently positive (higher risk for dark skin) across all models", "polarity": "found", "targets": ["direction of effect"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "claim", "lines": [[169, 169]], "assertion": "the confidence interval excludes zero, indicating statistical significance", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "claim", "lines": [[170, 170]], "assertion": "effect size is small but robust", "polarity": "found", "targets": ["effect size"], "confidence": "medium", "shares_lines_with": []}, {"id": 150, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[171, 171]], "note": "blank"}, {"id": 151, "kind": "nonclaim", "subtype": "heading", "lines": [[172, 172]], "note": "Strength of Evidence subheading"}, {"id": 152, "kind": "claim", "lines": [[173, 173]], "assertion": "statistical significance: p=0.030 < 0.05", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[174, 174]], "assertion": "result is consistent across 4 model specifications", "polarity": "found", "targets": ["robustness"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "claim", "lines": [[175, 175]], "assertion": "there is a dose-response pattern: larger effect comparing extreme skin tone groups", "polarity": "found", "targets": ["dose-response"], "confidence": "medium", "shares_lines_with": []}, {"id": 155, "kind": "claim", "lines": [[176, 176]], "assertion": "the sample is large: 115,603 dyads and 1,455 events", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 156, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[177, 179]], "note": "separator/blank"}, {"id": 157, "kind": "nonclaim", "subtype": "heading", "lines": [[180, 181]], "note": "section 7 heading"}, {"id": 158, "kind": "nonclaim", "subtype": "heading", "lines": [[182, 182]], "note": "Missing Data subheading"}, {"id": 159, "kind": "claim", "lines": [[183, 183]], "assertion": "20.8% of the original sample was excluded due to missing skin tone (14.7%) or covariates (6.2%)", "polarity": "did", "targets": ["exclusions"], "confidence": "high", "shares_lines_with": []}, {"id": 160, "kind": "nonclaim", "subtype": "hedging", "lines": [[184, 184]], "note": "speculation that players without photos may differ systematically"}, {"id": 161, "kind": "nonclaim", "subtype": "hedging", "lines": [[185, 185]], "note": "bias direction from missingness called unclear/likely minimal"}, {"id": 162, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[186, 186]], "note": "blank"}, {"id": 163, "kind": "nonclaim", "subtype": "heading", "lines": [[187, 187]], "note": "Measurement of Skin Tone subheading"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[188, 188]], "note": "ratings are subjective, based on static photos not in-person observation"}, {"id": 165, "kind": "nonclaim", "subtype": "hedging", "lines": [[189, 189]], "note": "lighting/photo quality may affect perceived skin tone"}, {"id": 166, "kind": "nonclaim", "subtype": "hedging", "lines": [[190, 190]], "note": "dichotomization loses information from the continuous scale"}, {"id": 167, "kind": "claim", "lines": [[191, 191]], "assertion": "high inter-rater reliability (r=0.92) suggests the skin tone measurement is reliable", "polarity": "found", "targets": ["measurement reliability"], "confidence": "medium", "shares_lines_with": []}, {"id": 168, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[192, 192]], "note": "blank"}, {"id": 169, "kind": "nonclaim", "subtype": "heading", "lines": [[193, 193]], "note": "Residual Confounding subheading"}, {"id": 170, "kind": "claim", "lines": [[194, 194]], "assertion": "yellow cards were controlled for in the sensitivity analysis as a playing-style proxy, though unmeasured aggression may still remain", "polarity": "did", "targets": ["yellow cards", "confounding"], "confidence": "medium", "shares_lines_with": []}, {"id": 171, "kind": "claim", "lines": [[195, 195]], "assertion": "country-level referee bias measures were available but not included, due to high correlation with league", "polarity": "did_not", "targets": ["referee bias measures"], "confidence": "high", "shares_lines_with": []}, {"id": 172, "kind": "nonclaim", "subtype": "hedging", "lines": [[196, 196]], "note": "player reputation/disciplinary history unavailable, could confound"}, {"id": 173, "kind": "claim", "lines": [[197, 197]], "assertion": "match context variables (home/away, score differential, match importance) were not controlled for", "polarity": "did_not", "targets": ["match context covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[198, 198]], "note": "blank"}, {"id": 175, "kind": "nonclaim", "subtype": "heading", "lines": [[199, 199]], "note": "Unit of Analysis (limitations) subheading"}, {"id": 176, "kind": "nonclaim", "subtype": "hedging", "lines": [[200, 200]], "note": "dyadic structure creates potential clustering"}, {"id": 177, "kind": "nonclaim", "subtype": "hedging", "lines": [[201, 201]], "note": "independence assumption may cause underestimated SEs"}, {"id": 178, "kind": "claim", "lines": [[202, 202]], "assertion": "the low event rate likely limits clustering impact, and bootstrap may partially address it", "polarity": "found", "targets": ["clustering mitigation"], "confidence": "low", "shares_lines_with": []}, {"id": 179, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[203, 203]], "note": "blank"}, {"id": 180, "kind": "nonclaim", "subtype": "heading", "lines": [[204, 204]], "note": "Temporal Scope subheading"}, {"id": 181, "kind": "claim", "lines": [[205, 205]], "assertion": "data is from the 2012-2013 season only", "polarity": "found", "targets": ["temporal scope"], "confidence": "high", "shares_lines_with": []}, {"id": 182, "kind": "nonclaim", "subtype": "hedging", "lines": [[206, 206]], "note": "findings may not generalize to other periods/leagues/levels"}, {"id": 183, "kind": "nonclaim", "subtype": "hedging", "lines": [[207, 207]], "note": "trend over time is unclear"}, {"id": 184, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[208, 208]], "note": "blank"}, {"id": 185, "kind": "nonclaim", "subtype": "heading", "lines": [[209, 209]], "note": "Causality subheading"}, {"id": 186, "kind": "nonclaim", "subtype": "hedging", "lines": [[210, 210]], "note": "observational design cannot establish causal discrimination"}, {"id": 187, "kind": "nonclaim", "subtype": "hedging", "lines": [[211, 211]], "note": "alternative mechanisms may mediate the relationship"}, {"id": 188, "kind": "claim", "lines": [[212, 212]], "assertion": "the association is clear, though causal inference would require stronger assumptions", "polarity": "found", "targets": ["causal interpretation"], "confidence": "low", "shares_lines_with": []}, {"id": 189, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[213, 213]], "note": "blank"}, {"id": 190, "kind": "nonclaim", "subtype": "heading", "lines": [[214, 214]], "note": "Model Assumptions subheading"}, {"id": 191, "kind": "nonclaim", "subtype": "hedging", "lines": [[215, 215]], "note": "logistic regression assumes linearity on the logit scale"}, {"id": 192, "kind": "claim", "lines": [[216, 216]], "assertion": "no interaction terms were included; the main model assumes a constant skin tone effect across positions, leagues, etc.", "polarity": "did_not", "targets": ["interaction terms"], "confidence": "high", "shares_lines_with": []}, {"id": 193, "kind": "nonclaim", "subtype": "hedging", "lines": [[217, 217]], "note": "some referee-player combinations may be structurally impossible (positivity)"}, {"id": 194, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[218, 220]], "note": "separator/blank"}, {"id": 195, "kind": "nonclaim", "subtype": "heading", "lines": [[221, 222]], "note": "section 8 heading"}, {"id": 196, "kind": "nonclaim", "subtype": "heading", "lines": [[223, 223]], "note": "Primary Analysis Assumptions subheading"}, {"id": 197, "kind": "claim", "lines": [[224, 224]], "assertion": "the no-unmeasured-confounding assumption is likely violated", "polarity": "found", "targets": ["confounding assumption"], "confidence": "low", "shares_lines_with": []}, {"id": 198, "kind": "nonclaim", "subtype": "hedging", "lines": [[225, 225]], "note": "assumes logistic link and linear covariates are appropriate"}, {"id": 199, "kind": "claim", "lines": [[226, 226]], "assertion": "the independence-of-observations assumption is questionable given clustering", "polarity": "found", "targets": ["independence assumption"], "confidence": "low", "shares_lines_with": []}, {"id": 200, "kind": "nonclaim", "subtype": "hedging", "lines": [[227, 227]], "note": "assumes missing data mechanism is MAR conditional on observed variables"}, {"id": 201, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 228]], "note": "blank"}, {"id": 202, "kind": "nonclaim", "subtype": "heading", "lines": [[229, 229]], "note": "Assessment subheading"}, {"id": 203, "kind": "claim", "lines": [[230, 230]], "assertion": "exchangeability is likely not fully met; residual confounding remains possible and could bias the effect in either direction", "polarity": "found", "targets": ["exchangeability assumption"], "confidence": "low", "shares_lines_with": []}, {"id": 204, "kind": "claim", "lines": [[231, 231]], "assertion": "the logistic specification was tested with alternative specifications", "polarity": "did", "targets": ["model specification"], "confidence": "medium", "shares_lines_with": []}, {"id": 205, "kind": "claim", "lines": [[232, 232]], "assertion": "the independence assumption is violated by the dyadic data structure", "polarity": "found", "targets": ["independence assumption"], "confidence": "medium", "shares_lines_with": [206]}, {"id": 206, "kind": "claim", "lines": [[232, 232]], "assertion": "clustered standard errors would have been more appropriate but were not feasible with the dyadic data", "polarity": "would_have", "targets": ["clustered standard errors"], "confidence": "high", "shares_lines_with": [205]}, {"id": 207, "kind": "claim", "lines": [[233, 233]], "assertion": "the MAR assumption has partial support since missingness relates to photo availability, which may be conditionally random", "polarity": "found", "targets": ["MAR assumption"], "confidence": "low", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[234, 234]], "note": "blank"}, {"id": 209, "kind": "claim", "lines": [[235, 235]], "assertion": "key assumptions are only partially met; the effect estimate is likely attenuated toward null by confounding/measurement error, but SEs may be underestimated by clustering", "polarity": "found", "targets": ["overall assumption assessment"], "confidence": "low", "shares_lines_with": []}, {"id": 210, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[236, 238]], "note": "separator/blank"}, {"id": 211, "kind": "nonclaim", "subtype": "heading", "lines": [[239, 240]], "note": "section 9 heading"}, {"id": 212, "kind": "nonclaim", "subtype": "heading", "lines": [[241, 241]], "note": "Why Risk Difference subheading"}, {"id": 213, "kind": "claim", "lines": [[242, 242]], "assertion": "risk difference was chosen as the primary estimand in preference to the odds ratio", "polarity": "did", "targets": ["estimand choice"], "confidence": "high", "shares_lines_with": []}, {"id": 214, "kind": "claim", "lines": [[243, 243]], "assertion": "RD was preferred for clinical/practical interpretability, directly communicating absolute impact", "polarity": "found", "targets": ["RD rationale"], "confidence": "medium", "shares_lines_with": []}, {"id": 215, "kind": "claim", "lines": [[244, 244]], "assertion": "RD was preferred because the additive scale is more natural for public health significance", "polarity": "found", "targets": ["RD rationale"], "confidence": "medium", "shares_lines_with": []}, {"id": 216, "kind": "claim", "lines": [[245, 245]], "assertion": "RD was preferred because for a rare outcome, OR approximates the risk ratio but RD is more intuitive", "polarity": "found", "targets": ["RD rationale"], "confidence": "medium", "shares_lines_with": []}, {"id": 217, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[246, 246]], "note": "blank"}, {"id": 218, "kind": "nonclaim", "subtype": "heading", "lines": [[247, 247]], "note": "Marginal Standardization Approach subheading"}, {"id": 219, "kind": "claim", "lines": [[248, 248]], "assertion": "g-computation (predictive margins) was used to estimate the adjusted risk difference", "polarity": "did", "targets": ["g-computation"], "confidence": "high", "shares_lines_with": []}, {"id": 220, "kind": "claim", "lines": [[249, 249]], "assertion": "a logistic model with all covariates was fit", "polarity": "did", "targets": ["model fitting"], "confidence": "high", "shares_lines_with": []}, {"id": 221, "kind": "claim", "lines": [[250, 250]], "assertion": "predicted outcomes for all observations under the 'all dark-skinned' scenario", "polarity": "did", "targets": ["g-computation step"], "confidence": "high", "shares_lines_with": []}, {"id": 222, "kind": "claim", "lines": [[251, 251]], "assertion": "predicted outcomes for all observations under the 'all light-skinned' scenario", "polarity": "did", "targets": ["g-computation step"], "confidence": "high", "shares_lines_with": []}, {"id": 223, "kind": "claim", "lines": [[252, 252]], "assertion": "averaged predictions across all observations to get marginal probabilities", "polarity": "did", "targets": ["g-computation step"], "confidence": "high", "shares_lines_with": []}, {"id": 224, "kind": "claim", "lines": [[253, 253]], "assertion": "computed the difference of marginal probabilities as the adjusted risk difference", "polarity": "did", "targets": ["g-computation step"], "confidence": "high", "shares_lines_with": []}, {"id": 225, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[254, 254]], "note": "blank"}, {"id": 226, "kind": "claim", "lines": [[255, 255]], "assertion": "this approach accounts for covariate distributions and nonlinearity in the logistic model", "polarity": "found", "targets": ["g-computation properties"], "confidence": "medium", "shares_lines_with": []}, {"id": 227, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[256, 256]], "note": "blank"}, {"id": 228, "kind": "nonclaim", "subtype": "heading", "lines": [[257, 257]], "note": "Bootstrap Procedure subheading"}, {"id": 229, "kind": "claim", "lines": [[258, 258]], "assertion": "used 200 bootstrap iterations due to computational constraints with 115k observations", "polarity": "did", "targets": ["bootstrap iterations"], "confidence": "high", "shares_lines_with": []}, {"id": 230, "kind": "claim", "lines": [[259, 259]], "assertion": "sampling with replacement was done at the dyad level", "polarity": "did", "targets": ["bootstrap sampling"], "confidence": "high", "shares_lines_with": []}, {"id": 231, "kind": "claim", "lines": [[260, 260]], "assertion": "the percentile method was used for the 95% CI", "polarity": "did", "targets": ["bootstrap CI method"], "confidence": "high", "shares_lines_with": []}, {"id": 232, "kind": "claim", "lines": [[261, 261]], "assertion": "a normal approximation was used for the p-value using the bootstrap SE", "polarity": "did", "targets": ["bootstrap p-value method"], "confidence": "high", "shares_lines_with": []}, {"id": 233, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[262, 264]], "note": "separator/blank"}, {"id": 234, "kind": "nonclaim", "subtype": "heading", "lines": [[265, 266]], "note": "section 10 heading"}, {"id": 235, "kind": "nonclaim", "subtype": "heading", "lines": [[267, 267]], "note": "Dataset subheading"}, {"id": 236, "kind": "nonclaim", "subtype": "background", "lines": [[268, 268]], "note": "data source: a professional soccer statistics company"}, {"id": 237, "kind": "nonclaim", "subtype": "background", "lines": [[269, 269]], "note": "scope: all players/referees in 4 leagues, 2012-13 season"}, {"id": 238, "kind": "nonclaim", "subtype": "background", "lines": [[270, 270]], "note": "raw dataset has 146,028 player-referee combinations"}, {"id": 239, "kind": "nonclaim", "subtype": "background", "lines": [[271, 271]], "note": "skin tone ratings available for 1,586 players"}, {"id": 240, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[272, 272]], "note": "blank"}, {"id": 241, "kind": "nonclaim", "subtype": "heading", "lines": [[273, 273]], "note": "Key Variables subheading"}, {"id": 242, "kind": "nonclaim", "subtype": "background", "lines": [[274, 281]], "note": "codebook variable definitions (playerShort, refNum, rater1/2, redCards, games, position, leagueCountry, height/weight/age)"}, {"id": 243, "kind": "nonclaim", "subtype": "boilerp