, 32]}, {"id": 30, "kind": "claim", "lines": [[42, 43]], "assertion": "inter-rater correlation between the two raters was r=0.923", "polarity": "found", "targets": ["inter-rater correlation"], "confidence": "high", "shares_lines_with": [29, 31, 32]}, {"id": 31, "kind": "claim", "lines": [[42, 43]], "assertion": "raters used a 5-point scale from 0 (very light) to 1 (very dark)", "polarity": "did", "targets": ["skin tone scale"], "confidence": "high", "shares_lines_with": [29, 30, 32]}, {"id": 32, "kind": "claim", "lines": [[42, 43]], "assertion": "the average of both raters' scores was used as the skin tone measure", "polarity": "did", "targets": ["skin tone score"], "confidence": "high", "shares_lines_with": [29, 30, 31]}, {"id": 33, "kind": "claim", "lines": [[44, 44]], "assertion": "light skin was defined as average rating ≤ 0.25", "polarity": "did", "targets": ["light skin threshold"], "confidence": "high", "shares_lines_with": []}, {"id": 34, "kind": "claim", "lines": [[45, 45]], "assertion": "dark skin was defined as average rating ≥ 0.75", "polarity": "did", "targets": ["dark skin threshold"], "confidence": "high", "shares_lines_with": []}, {"id": 35, "kind": "claim", "lines": [[46, 47]], "assertion": "the middle skin-tone range (0.25-0.75) was excluded to create clearer comparison groups", "polarity": "did", "targets": ["skin tone classification"], "confidence": "high", "shares_lines_with": []}, {"id": 36, "kind": "nonclaim", "subtype": "heading", "lines": [[48, 49]], "note": "Outcome subheading"}, {"id": 37, "kind": "claim", "lines": [[50, 51]], "assertion": "outcome was defined as binary receipt of any red card from that referee across all encounters", "polarity": "did", "targets": ["red card outcome"], "confidence": "high", "shares_lines_with": []}, {"id": 38, "kind": "nonclaim", "subtype": "heading", "lines": [[52, 53]], "note": "Covariates Adjusted For subheading"}, {"id": 39, "kind": "nonclaim", "subtype": "framing", "lines": [[54, 55]], "note": "lead-in to covariate list"}, {"id": 40, "kind": "claim", "lines": [[56, 56]], "assertion": "number of games in the dyad was included as a covariate", "polarity": "did", "targets": ["covariates", "games"], "confidence": "high", "shares_lines_with": []}, {"id": 41, "kind": "claim", "lines": [[57, 57]], "assertion": "player position (4 categories, reference Attacking) was included as a covariate", "polarity": "did", "targets": ["covariates", "player position"], "confidence": "high", "shares_lines_with": []}, {"id": 42, "kind": "claim", "lines": [[58, 58]], "assertion": "league country (4 countries, reference England) was included as a covariate", "polarity": "did", "targets": ["covariates", "league country"], "confidence": "high", "shares_lines_with": []}, {"id": 43, "kind": "claim", "lines": [[59, 59]], "assertion": "player age, computed as 2012 minus birth year, was included as a covariate", "polarity": "did", "targets": ["covariates", "player age"], "confidence": "high", "shares_lines_with": []}, {"id": 44, "kind": "claim", "lines": [[60, 60]], "assertion": "number of yellow cards was included as a covariate proxying aggressive play style", "polarity": "did", "targets": ["covariates", "yellow cards"], "confidence": "high", "shares_lines_with": []}, {"id": 45, "kind": "claim", "lines": [[61, 63]], "assertion": "covariates were chosen because they are plausible confounders of both skin tone composition and red card rates", "polarity": "did", "targets": ["covariate selection rationale"], "confidence": "medium", "shares_lines_with": [46, 47]}, {"id": 46, "kind": "claim", "lines": [[61, 63]], "assertion": "defensive positions receive more cards, cited as an example confounding pathway", "polarity": "found", "targets": ["player position", "red cards"], "confidence": "medium", "shares_lines_with": [45, 47]}, {"id": 47, "kind": "claim", "lines": [[61, 63]], "assertion": "league composition differs by skin tone: France has 35% dark-skinned players vs 9% in Germany/Spain", "polarity": "found", "targets": ["league country", "skin tone composition"], "confidence": "high", "shares_lines_with": [45, 46]}, {"id": 48, "kind": "nonclaim", "subtype": "heading", "lines": [[64, 65]], "note": "Statistical Methods subheading"}, {"id": 49, "kind": "claim", "lines": [[66, 66]], "assertion": "a logistic regression model with binary red card outcome was fitted", "polarity": "did", "targets": ["logistic regression model"], "confidence": "high", "shares_lines_with": []}, {"id": 50, "kind": "claim", "lines": [[67, 67]], "assertion": "cluster-robust standard errors (clustered by player ID) were used to account for non-independence of dyads", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 51, "kind": "claim", "lines": [[68, 71]], "assertion": "the risk difference was estimated via marginal standardization (g-computation), differencing predicted probabilities under universal dark vs light exposure", "polarity": "did", "targets": ["risk difference estimation"], "confidence": "high", "shares_lines_with": []}, {"id": 52, "kind": "claim", "lines": [[72, 72]], "assertion": "confidence intervals were obtained via parametric bootstrap based on the asymptotic normal distribution of the darkSkin coefficient, 2,000 simulations", "polarity": "did", "targets": ["confidence intervals", "bootstrap"], "confidence": "high", "shares_lines_with": []}, {"id": 53, "kind": "claim", "lines": [[73, 74]], "assertion": "the p-value came from a two-sided test based on the simulated sampling distribution", "polarity": "did", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 54, "kind": "nonclaim", "subtype": "heading", "lines": [[75, 76]], "note": "Variable Transformations subheading"}, {"id": 55, "kind": "claim", "lines": [[77, 78]], "assertion": "no transformations were applied to continuous variables (games, age, yellow cards); they entered the model in original scale", "polarity": "did_not", "targets": ["variable transformations"], "confidence": "high", "shares_lines_with": []}, {"id": 56, "kind": "nonclaim", "subtype": "heading", "lines": [[79, 80]], "note": "Exclusions subheading"}, {"id": 57, "kind": "claim", "lines": [[81, 81]], "assertion": "21,407 dyads (14.7%) were excluded for missing skin tone ratings", "polarity": "did", "targets": ["exclusions", "missing skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 58, "kind": "claim", "lines": [[82, 82]], "assertion": "17,015 dyads (13.7% of rated) were excluded for being in the middle skin tone range", "polarity": "did", "targets": ["exclusions", "middle skin tone"], "confidence": "high", "shares_lines_with": []}, {"id": 59, "kind": "claim", "lines": [[83, 83]], "assertion": "7,471 dyads (6.9%) were excluded for missing position information", "polarity": "did", "targets": ["exclusions", "missing position"], "confidence": "high", "shares_lines_with": []}, {"id": 60, "kind": "claim", "lines": [[84, 85]], "assertion": "final retention was 100,135 dyads, 68.6% of the original 146,028", "polarity": "found", "targets": ["sample retention"], "confidence": "high", "shares_lines_with": []}, {"id": 61, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[86, 87]], "note": "section separator"}, {"id": 62, "kind": "nonclaim", "subtype": "heading", "lines": [[88, 89]], "note": "Section 4 heading"}, {"id": 63, "kind": "nonclaim", "subtype": "heading", "lines": [[90, 91]], "note": "Full Logistic Regression Model subheading"}, {"id": 64, "kind": "claim", "lines": [[92, 105]], "assertion": "the darkSkin coefficient in the full model is 0.207 (SE 0.098, z=2.11, p=0.034, CI [0.015,0.398])", "polarity": "found", "targets": ["darkSkin coefficient"], "confidence": "high", "shares_lines_with": [65]}, {"id": 65, "kind": "claim", "lines": [[92, 105]], "assertion": "the full model table also reports coefficients for the intercept, games, age, yellowCards, position, and league dummy variables", "polarity": "found",