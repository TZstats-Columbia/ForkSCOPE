ope of results"}, {"id": 160, "kind": "nonclaim", "subtype": "hedging", "lines": [[182, 187]], "note": "caveat list of generalizability limits"}, {"id": 161, "kind": "nonclaim", "subtype": "other", "lines": [[188, 188]], "note": "blank line"}, {"id": 162, "kind": "nonclaim", "subtype": "heading", "lines": [[189, 189]], "note": "5.6 subheading"}, {"id": 163, "kind": "nonclaim", "subtype": "hedging", "lines": [[190, 190]], "note": "caveat about cluster-robust SE independence assumption"}, {"id": 164, "kind": "nonclaim", "subtype": "hedging", "lines": [[191, 191]], "note": "caveat about logistic functional-form assumption"}, {"id": 165, "kind": "nonclaim", "subtype": "hedging", "lines": [[192, 192]], "note": "caveat about missing-at-random assumption"}, {"id": 166, "kind": "claim", "lines": [[193, 193]], "assertion": "interaction effects were not examined", "polarity": "did_not", "targets": ["interaction effects"], "confidence": "high", "shares_lines_with": []}, {"id": 167, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "blank line"}, {"id": 168, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[195, 196]], "note": "separator and blank"}, {"id": 169, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 198]], "note": "section 6 heading"}, {"id": 170, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[199, 199]], "note": "table header row"}, {"id": 171, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[200, 200]], "note": "table separator row"}, {"id": 172, "kind": "claim", "lines": [[201, 201]], "assertion": "table restates the primary adjusted risk difference (0.138pp, CI, p=0.198) as not significant", "polarity": "found", "targets": ["risk difference"], "confidence": "low", "shares_lines_with": []}, {"id": 173, "kind": "claim", "lines": [[202, 202]], "assertion": "table restates the secondary adjusted odds ratio (1.121, CI, p=0.198) as not significant", "polarity": "found", "targets": ["odds ratio"], "confidence": "low