plete in the final sample", "polarity": "did_not", "targets": ["exclusions", "missing covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 78, "kind": "nonclaim", "subtype": "other", "lines": [[117, 117]], "note": "blank line"}, {"id": 79, "kind": "claim", "lines": [[118, 118]], "assertion": "the final analysis sample was 107,606 dyads, 73.7% of the original dataset", "polarity": "found", "targets": ["final sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 80, "kind": "nonclaim", "subtype": "other", "lines": [[119, 119]], "note": "blank line"}, {"id": 81, "kind": "nonclaim", "subtype": "heading", "lines": [[120, 120]], "note": "subsection heading: Transformations"}, {"id": 82, "kind": "claim", "lines": [[121, 121]], "assertion": "the two raters' skin-tone scores were averaged", "polarity": "did", "targets": ["skin tone score", "raters"], "confidence": "high", "shares_lines_with": [83]}, {"id": 83, "kind": "claim", "lines": [[121, 121]], "assertion": "the averaged skin-tone score was then dichotomized", "polarity": "did", "targets": ["skin tone score", "dichotomization"], "confidence": "high", "shares_lines_with": [82]}, {"id": 84, "kind": "claim", "lines": [[122, 122]], "assertion": "the red card count was dichotomized into any vs. none", "polarity": "did", "targets": ["outcome", "red card count"], "confidence": "high", "shares_lines_with": []}, {"id": 85, "kind": "claim", "lines": [[123, 123]], "assertion": "detailed player positions were collapsed into 6 categories", "polarity": "did", "targets": ["position categories"], "confidence": "high", "shares_lines_with": []}, {"id": 86, "kind": "claim", "lines": [[124, 124]], "assertion": "covariates were entered on their original scale, with no centering or standardization", "polarity": "did_not", "targets": ["covariate scaling"], "confidence": "high", "shares_lines_with": []}, {"id": 87, "kind": "nonclaim", "subtype": "other", "lines": [[125, 125]], "note": "blank line"}, {"id": 88, "