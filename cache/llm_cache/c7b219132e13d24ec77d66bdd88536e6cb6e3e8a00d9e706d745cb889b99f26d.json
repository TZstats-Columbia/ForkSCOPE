74, 174]], "note": "blank line"}, {"id": 134, "kind": "nonclaim", "subtype": "framing", "lines": [[175, 175]], "note": "lead-in: ecological measure of referee bias"}, {"id": 135, "kind": "nonclaim", "subtype": "background", "lines": [[176, 176]], "note": "dataset contains country-level, not referee-level, bias scores"}, {"id": 136, "kind": "claim", "lines": [[177, 177]], "assertion": "the country-level bias scores were not used in the primary analysis", "polarity": "did_not", "targets": ["bias scores", "primary analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 137, "kind": "nonclaim", "subtype": "other", "lines": [[178, 178]], "note": "blank line"}, {"id": 138, "kind": "nonclaim", "subtype": "heading", "lines": [[179, 179]], "note": "subsection heading: Unmeasured Confounding"}, {"id": 139, "kind": "nonclaim", "subtype": "hedging", "lines": [[180, 180]], "note": "cannot rule out unmeasured confounding, general caveat"}, {"id": 140, "kind": "nonclaim", "subtype": "hedging", "lines": [[181, 185]], "note": "list of possible unmeasured confounders (player behavior, referee characteristics, match context, reputation, foul severity)"}, {"id": 141, "kind": "nonclaim", "subtype": "other", "lines": [[186, 186]], "note": "blank line"}, {"id": 142, "kind": "nonclaim", "subtype": "heading", "lines": [[187, 187]], "note": "subsection heading: Causal Interpretation"}, {"id": 143, "kind": "nonclaim", "subtype": "hedging", "lines": [[188, 188]], "note": "caveat: observational study cannot establish causation or prove bias mechanism"}, {"id": 144, "kind": "nonclaim", "subtype": "other", "lines": [[189, 189]], "note": "blank line"}, {"id": 145, "kind": "nonclaim", "subtype": "heading", "lines": [[190, 190]], "note": "subsection heading: Generalizability"}, {"id": 146, "kind": "nonclaim", "subtype": "hedging", "lines": [[191, 191]], "note": "caveat: data from 2012-2013 season only, may not reflect current practices"}, {"id": 147, "kind": "nonclaim", "subtype": "hedging", "lines": [[192, 192]], "note": "caveat: limited to four European leagues"}, {"id": 148, "kind": "claim", "lines": [[193, 193]], "assertion": "medium skin tones were excluded, so findings apply only to the contrast between light and dark extremes", "polarity": "did", "targets": ["medium skin tone", "generalizability"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "nonclaim", "subtype": "background", "lines": [[194, 194]], "note": "dataset includes male players only"}, {"id": 150, "kind": "nonclaim", "subtype": "other", "lines": [[195, 195]], "note": "blank line"}, {"id": 151, "kind": "nonclaim", "subtype": "heading", "lines": [[196, 196]], "note": "subsection heading: Statistical Assumptions"}, {"id": 152, "kind": "nonclaim", "subtype": "hedging", "lines": [[197, 197]], "note": "caveat: assumes correct model specification and functional form"}, {"id": 153, "kind": "claim", "lines": [[198, 198]], "assertion": "no effect-modification/interaction tests were conducted; the skin-tone effect was assumed constant across covariate strata", "polarity": "did_not", "targets": ["effect modification", "interactions"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "claim", "lines": [[199, 199]], "assertion": "within-player correlations were assumed constant (exchangeable) across all player dyads", "polarity": "did", "targets": ["exchangeable correlation assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 155, "kind": "nonclaim", "subtype": "hedging", "lines": [[200, 200]], "note": "caveat: relies on large-sample asymptotics, considered satisfied given N=107,606"}, {"id": 156, "kind": "nonclaim", "subtype": "other", "lines": [[201, 201]], "note": "blank line"}, {"id": 157, "kind": "nonclaim", "subtype": "heading", "lines": [[202, 202]], "note": "subsection heading: Multiple Testing"}, {"id": 158, "kind": "claim", "lines": [[203, 203]], "assertion": "multiple analyses were conducted (primary and secondary estimands, sensitivity analyses, diagnostics)", "polarity": "did", "targets": ["multiple analyses"], "confidence": "high", "shares_lines_with": [159]}, {"id": 159, "kind": "claim", "lines": [[203, 203]], "assertion": "the primary analysis was pre-specified in the research question", "polarity": "did", "targets": ["pre-specification", "primary analysis"], "confidence": "high", "shares_lines_with": [158]}, {"id": 160, "kind": "nonclaim", "subtype": "other", "lines": [[204, 204]], "note": "blank line"}, {"id": 161, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[205, 205]], "note": "section divider"}, {"id": 162, "kind": "nonclaim", "subtype": "other", "lines": [[206, 206]], "note": "blank line"}, {"id": 163, "kind": "nonclaim", "subtype": "heading", "lines": [[207, 207]], "note": "section heading: Additional Notes"}, {"id": 164, "kind": "nonclaim", "subtype": "other", "lines": [[208, 208]], "note": "blank line"}, {"id": 165, "kind": "nonclaim", "subtype": "heading", "lines": [[209, 209]], "note": "subsection heading: Sensitivity of Results to Modeling Choices"}, {"id": 166, "kind": "nonclaim", "subtype": "framing", "lines": [[210, 210]], "note": "lead-in: sensitivity to position adjustment"}, {"id": 167, "kind": "claim", "lines": [[211, 212]], "assertion": "without position adjustment OR=1.20 (p=0.048); with position adjustment OR=1.24 (p=0.022)", "polarity": "found", "targets": ["sensitivity analysis", "odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 168, "kind": "nonclaim", "subtype": "other", "lines": [[213, 213]], "note": "blank line"}, {"id": 169, "kind": "claim", "lines": [[214, 214]], "assertion": "position is an important confounder, and the similarity of estimates across models supports robustness", "polarity": "found", "targets": ["position", "robustness"], "confidence": "medium", "shares_lines_with": []}, {"id": 170, "kind": "nonclaim", "subtype": "other", "lines": [[215, 215]], "note": "blank line"}, {"id": 171, "kind": "nonclaim", "subtype": "heading", "lines": [[216, 216]], "note": "subsection heading: Within-League Patterns"}, {"id": 172, "kind": "nonclaim", "subtype": "framing", "lines": [[217, 217]], "note": "lead-in: red card rates vary by league"}, {"id": 173, "kind": "claim", "lines": [[218, 221]], "assertion": "per-league red card rate differences by skin tone: England +0.37pp, France -0.44pp, Germany +0.67pp, Spain -0.42pp", "polarity": "found", "targets": ["league", "red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "nonclaim", "subtype": "other", "lines": [[222, 222]], "note": "blank line"}, {"id": 175, "kind": "claim", "lines": [[223, 223]], "assertion": "the pattern is mixed: dark-skinned players have higher rates in England and Germany but lower rates in France and Spain", "polarity": "found", "targets": ["league pattern"], "confidence": "high", "shares_lines_with": [176]}, {"id": 176, "kind": "claim", "lines": [[223, 223]], "assertion": "the overall adjusted effect pools across leagues weighted by sample size, with Germany and England contributing the largest samples", "polarity": "found", "targets": ["pooled effect", "sample weighting"], "confidence": "medium", "shares_lines_with": [175]}, {"id": 177, "kind": "nonclaim", "subtype": "other", "lines": [[224, 224]], "note": "blank line"}, {"id": 178, "kind": "nonclaim", "subtype": "heading", "lines": [[225, 225]], "note": "subsection heading: Reproducibility"}, {"id": 179, "kind": "claim", "lines": [[226, 226]], "assertion": "all analyses are reproducible from the provided code (final_analysis.py) and the publicly available dataset", "polarity": "did", "targets": ["reproducibility", "code"], "confidence": "high", "shares_lines_with": [180]}, {"id": 180, "kind": "claim", "lines": [[226, 226]], "assertion": "a random seed (42) was set for the parametric bootstrap", "polarity": "did", "targets": ["random seed", "parametric bootstrap"], "confidence": "high", "shares_lines_with": [179]}, {"id": 181, "kind": "nonclaim", "subtype": "other", "lines": [[227, 227]], "note": "blank line"}, {"id": 182, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 228]], "note": "section divider"}, {"id": 183, "kind": "nonclaim", "subtype": "other", "lines": [[229, 229]], "note": "blank line"}, {"id": 184, "kind": "nonclaim", "subtype": "heading", "lines": [[230, 230]], "note": "section heading: Final Statement"}, {"id": 185, "kind": "nonclaim", "subtype": "other", "lines": [[231, 231]], "note": "blank line"}, {"id": 186, "kind": "claim", "lines": [[232, 232]], "assertion": "after adjustment, dark-skinned players face a statistically significant 0.28pp (23% relative) increase in red card probability, restated as the final conclusion", "polarity": "found", "targets": ["final conclusion", "adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 187, "kind": "nonclaim", "subtype": "other", "lines": [[233, 233]], "note": "blank line"}, {"id": 188, "kind": "nonclaim", "subtype": "framing", "lines": [[234, 234]], "note": "forward-looking recommendation for how to report results in a manuscript"}, {"id": 189, "kind": "nonclaim", "subtype": "other", "lines": [[235, 235]], "note": "blank line"}, {"id": 190, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[236, 236]], "note": "section divider"}, {"id": 191, "kind": "nonclaim", "subtype": "other", "lines": [[237, 237]], "note": "blank line"}, {"id": 192, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[238, 238]], "note": "analysis date footer"}, {"id": 193, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[239, 239]], "note": "analyst credit footer"}, {"id": 194, "kind": "claim", "lines": [[240, 240]], "assertion": "the source dataset soccer.csv contained 146,028 dyads, of which 107,606 were analyzed", "polarity": "found", "targets": ["dataset size", "soccer.csv"], "confidence": "medium", "shares_lines_with": []}, {"id": 195, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[241, 241]], "note": "code footer, fully reproducible"}, {"id": 196, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[242, 242]], "note": "figure footer"}]}}