ark vs light difference = -0.46pp (1.39% vs 1.85%)", "polarity": "found", "targets": ["league subgroup", "France"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "claim", "lines": [[154, 154]], "assertion": "Germany: dark vs light difference = +0.40pp (1.20% vs 0.80%)", "polarity": "found", "targets": ["league subgroup", "Germany"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "claim", "lines": [[155, 155]], "assertion": "Spain: dark vs light difference = -0.37pp (1.28% vs 1.64%)", "polarity": "found", "targets": ["league subgroup", "Spain"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[156, 156]], "note": "blank line"}, {"id": 143, "kind": "claim", "lines": [[157, 157]], "assertion": "league effects vary substantially, positive in England/Germany but inverse in France/Spain, i.e. inconsistent across contexts", "polarity": "found", "targets": ["league subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[158, 158]], "note": "blank line"}, {"id": 145, "kind": "nonclaim", "subtype": "heading", "lines": [[159, 159]], "note": "By Position subheading"}, {"id": 146, "kind": "claim", "lines": [[160, 160]], "assertion": "Defenders: +0.12pp", "polarity": "found", "targets": ["position subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 147, "kind": "claim", "lines": [[161, 161]], "assertion": "Midfielders: +0.24pp", "polarity": "found", "targets": ["position subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "claim", "lines": [[162, 162]], "assertion": "Forwards: +0.12pp", "polarity": "found", "targets": ["position subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "claim", "lines": [[163, 163]], "assertion": "Goalkeepers: -0.44pp, based on very few dark-skinned goalkeepers (N=583)", "polarity": "found", "targets": ["position subgroup", "goalkeepers"], "confidence": "high", "shares_lines_with": []}, {"id": 150, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[164, 164]], "note": "blank line"}, {"id": 151, "kind": "claim", "lines": [[165, 165]], "assertion": "position-subgroup effects are small and inconsistent", "polarity": "found", "targets": ["position subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 152, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[166, 166]], "note": "blank line"}, {"id": 153, "kind": "nonclaim", "subtype": "heading", "lines": [[167, 167]], "note": "By Exposure subheading"}, {"id": 154, "kind": "claim", "lines": [[168, 168]], "assertion": "1 game: +0.08pp", "polarity": "found", "targets": ["exposure subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 155, "kind": "claim", "lines": [[169, 169]], "assertion": "2-3 games: +0.35pp", "polarity": "found", "targets": ["exposure subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 156, "kind": "claim", "lines": [[170, 170]], "assertion": "4-10 games: +0.26pp", "polarity": "found", "targets": ["exposure subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 157, "kind": "claim", "lines": [[171, 171]], "assertion": ">10 games: -0.25pp", "polarity": "found", "targets": ["exposure subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[172, 172]], "note": "blank line"}, {"id": 159, "kind": "claim", "lines": [[173, 173]], "assertion": "the association attenuates or reverses with more games played, suggesting regression to the mean or diminishing initial bias", "polarity": "found", "targets": ["exposure subgroup"], "confidence": "low", "shares_lines_with": []}, {"id": 160, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[174, 176]], "note": "blank/separator/blank"}, {"id": 161, "kind": "nonclaim", "subtype": "heading", "lines": [[177, 178]], "note": "Section 6 heading"}, {"id": 162, "kind": "claim", "lines": [[179, 179]], "assertion": "crude (unadjusted) risk difference is 0.11pp (1.35% vs 1.24%)", "polarity": "found", "targets": ["crude estimate"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[180, 180]], "assertion": "crude odds ratio is 1.09", "polarity": "found", "targets": ["crude estimate"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[181, 181]], "note": "blank line"}, {"id": 165, "kind": "claim", "lines": [[182, 182]], "assertion": "adjusted estimates are slightly larger than crude estimates, indicating confounders were masking a small positive association", "polarity": "found", "targets": ["adjusted vs crude estimates"], "confidence": "high", "shares_lines_with": [166]}, {"id": 166, "kind": "claim", "lines": [[182, 182]], "assertion": "the adjustment did not produce a statistically significant result", "polarity": "found", "targets": ["adjusted estimate"], "confidence": "high", "shares_lines_with": [165]}, {"id": 167, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[183, 185]], "note": "blank/separator/blank"}, {"id": 168, "kind": "nonclaim", "subtype": "heading", "lines": [[186, 187]], "note": "Conclusion heading"}, {"id": 169, "kind": "claim", "lines": [[188, 188]], "assertion": "primary conclusion: the hypothesis is NOT SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[189, 189]], "note": "blank line"}, {"id": 171, "kind": "claim", "lines": [[190, 190]], "assertion": "the point estimate suggests a small increase (0.16pp, or 13% higher odds)", "polarity": "found", "targets": ["effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 172, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[191, 191]], "note": "blank line"}, {"id": 173, "kind": "claim", "lines": [[192, 192]], "assertion": "the effect is not statistically significant at α=0.05 (p=0.095 RD, p=0.105 OR)", "polarity": "found", "targets": ["statistical significance"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[193, 193]], "assertion": "the 95% CI includes zero (no effect)", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 175, "kind": "claim", "lines": [[194, 194]], "assertion": "the effect is clinically/practically negligible even at the CI's upper bound (0.34pp)", "polarity": "found", "targets": ["effect size"], "confidence": "high", "shares_lines_with": []}, {"id": 176, "kind": "claim", "lines": [[195, 195]], "assertion": "the effect varies inconsistently across leagues and subgroups, suggesting it may not be a generalizable pattern", "polarity": "found", "targets": ["subgroup consistency"], "confidence": "high", "shares_lines_with": []}, {"id": 177, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[196, 196]], "note": "blank line"}, {"id": 178, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 197]], "note": "Interpretation of Evidence Strength subheading"}, {"id": 179, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[198, 198]], "note": "'Using conventional statistical standards:' lead-in"}, {"id": 180, "kind": "claim", "lines": [[199, 199]], "assertion": "p=0.095 does not meet the α=0.05 threshold", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 181, "kind": "claim", "lines": [[200, 200]], "assertion": "the confidence interval includes the null (RD=0)", "polarity": "found", "targets": ["confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 182, "kind": "claim", "lines": [[201, 201]], "assertion": "therefore, the analysis fails to reject the null hypothesis of no association", "polarity": "found", "targets": ["hypothesis test"], "confidence": "high", "shares_lines_with": []}, {"id": 183, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[202, 202]], "note": "blank line"}, {"id": 184, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[203, 203]], "note": "'However, it is worth noting that:' lead-in"}, {"id": 185, "kind": "claim", "lines": [[204, 204]], "assertion": "the point estimate is positive in all primary and sensitivity analyses", "polarity": "found", "targets": ["point estimate"], "confidence": "high", "shares_lines_with": []}, {"id": 186, "kind": "claim", "lines": [[205, 205]], "assertion": "the p-value is close to 0.05 (0.095)", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 187, "kind": "claim", "lines": [[206, 206]], "assertion": "the continuous skin tone analysis showed a statistically significant effect (p=0.031)", "polarity": "found", "targets": ["sensitivity analysis 2"], "confidence": "high", "shares_lines_with": []}, {"id": 188, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[207, 207]], "note": "blank line"}, {"id": 189, "kind": "claim", "lines": [[208, 208]], "assertion": "these observations suggest the possibility of a weak association the analysis was underpowered to detect, or that the true effect is heterogeneous/context-dependent", "polarity": "found", "targets": ["conclusion"], "confidence": "low", "shares_lines_with": []}, {"id": 190, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[209, 211]], "note": "blank/separator/blank"}, {"id": 191, "kind": "nonclaim", "subtype": "heading", "lines": [[212, 213]], "note": "Limitations heading"}, {"id": 192, "kind": "nonclaim", "subtype": "heading", "lines": [[214, 214]], "note": "Missing Data subheading"}, {"id": 193, "kind": "nonclaim", "subtype": "hedging", "lines": [[215, 215]], "note": "caveat that excluded photo-less players may differ systematically, offset by large sample/high retention"}, {"id": 194, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[216, 216]], "note": "blank line"}, {"id": 195, "kind": "nonclaim", "subtype": "heading", "lines": [[217, 217]], "note": "Skin Tone Measurement subheading"}, {"id": 196, "kind": "claim", "lines": [[218, 218]], "assertion": "skin tone was coded from photos rather than in person", "polarity": "did", "targets": ["skin tone measurement"], "confidence": "high", "shares_lines_with": []}, {"id": 197, "kind": "nonclaim", "subtype": "hedging", "lines": [[219, 219]], "note": "caveat that photos may not accurately represent skin tone due to lighting/quality"}, {"id": 198, "kind": "claim", "lines": [[220, 220]], "assertion": "the continuous analysis suggested more consistent effects than the binary classification, which may obscure nuance", "polarity": "found", "targets": ["skin tone classification"], "confidence": "low", "shares_lines_with": []}, {"id": 199, "kind": "claim", "lines": [[221, 221]], "assertion": "inter-rater reliability was high (r=0.92), though systematic rater bias cannot be ruled out", "polarity": "found", "targets": ["inter-rater reliability"], "confidence": "medium", "shares_lines_with": []}, {"id": 200, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[222, 222]], "note": "blank line"}, {"id": 201, "kind": "nonclaim", "subtype": "heading", "lines": [[223, 223]], "note": "Rare Outcome subheading"}, {"id": 202, "kind": "claim", "lines": [[224, 224]], "assertion": "red cards are rare (1.26% of dyads)", "polarity": "found", "targets": ["outcome rarity"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "nonclaim", "subtype": "hedging", "lines": [[225, 227]], "note": "consequences of rarity: wide CIs, potential model instability, low power for small effects"}, {"id": 204, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 228]], "note": "blank line"}, {"id": 205, "kind": "nonclaim", "subtype": "heading", "lines": [[229, 229]], "note": "Observational Design subheading"}, {"id": 206, "kind": "nonclaim", "subtype": "framing", "lines": [[230, 230]], "note": "notes the study is observational so causal interpretation is limited"}, {"id": 207, "kind": "nonclaim", "subtype": "hedging", "lines": [[231, 231]], "note": "unmeasured confounders (playing style, foul severity, referee characteristics) may remain despite adjustment"}, {"id": 208, "kind": "claim", "lines": [[232, 232]], "assertion": "reverse causation is judged unlikely in this context", "polarity": "found", "targets": ["reverse causation"], "confidence": "low", "shares_lines_with": []}, {"id": 209, "kind": "claim", "lines": [[233, 233]], "assertion": "players and referees were not randomly assigned", "polarity": "did_not", "targets": ["random assignment"], "confidence": "high", "shares_lines_with": []}, {"id": 210, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[234, 234]], "note": "blank line"}, {"id": 211, "kind": "nonclaim", "subtype": "heading", "lines": [[235, 235]], "note": "Unit of Analysis (limitations) subheading"}, {"id": 212, "kind": "claim", "lines": [[236, 236]], "assertion": "the unit of analysis is the player-referee dyad, not the individual game", "polarity": "did", "targets": ["unit of analysis"], "confidence": "high", "shares_lines_with": []}, {"id": 213, "kind": "nonclaim", "subtype": "hedging", "lines": [[237, 238]], "note": "aggregating across games smooths random variation and may obscure game-specific factors"}, {"id": 214, "kind": "claim", "lines": [[239, 239]], "assertion": "the analysis assumes the effect is constant across all encounters between a player and referee", "polarity": "did", "targets": ["model assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 215, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[240, 240]], "note": "blank line"}, {"id": 216, "kind": "nonclaim", "subtype": "heading", "lines": [[241, 241]], "note": "Clustering and Non-Independence subheading"}, {"id": 217, "kind": "claim", "lines": [[242, 242]], "assertion": "additional clustering by referee or league was not modeled (only clustered by player)", "polarity": "did_not", "targets": ["clustering"], "confidence": "high", "shares_lines_with": [218]}, {"id": 218, "kind": "claim", "lines": [[242, 242]], "assertion": "mixed-effects models could have provided more refined estimates", "polarity": "would_have", "targets": ["mixed-effects models"], "confidence": "medium", "shares_lines_with": [217]}, {"id": 219, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[243, 243]], "note": "blank line"}, {"id": 220, "kind": "nonclaim", "subtype": "heading", "lines": [[244, 244]], "note": "Publication Bias subheading"}, {"id": 221, "kind": "claim", "lines": [[245, 245]], "assertion": "did not adjust for multiple comparisons, reasoning that the sensitivity/subgroup analyses were pre-specified rather than exploratory", "polarity": "did_not", "targets": ["multiple comparisons"], "confidence": "high", "shares_lines_with": []}, {"id": 222, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[246, 246]], "note": "blank line"}, {"id": 223, "kind": "nonclaim", "subtype": "heading", "lines": [[247, 247]], "note": "Temporal/Geographic Generalizability subheading"}, {"id": 224, "kind": "nonclaim", "subtype": "hedging", "lines": [[248, 248]], "note": "data are from 2012-2013, four European leagues; results may not generalize elsewhere"}, {"id": 225, "kind": "nonclaim", "subtype": "hedging", "lines": [[249, 251]], "note": "examples of limited generalizability: other time periods, other leagues/countries, women's soccer"}, {"id": 226, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[252, 252]], "note": "blank line"}, {"id": 227, "kind": "nonclaim", "subtype": "heading", "lines": [[253, 253]], "note": "Contextual Factors Not Measured subheading"}, {"id": 228, "kind": "nonclaim", "subtype": "hedging", "lines": [[254, 258]], "note": "list of potential unmeasured confounders (referee characteristics, match context, player reputation, foul severity)"}, {"id": 229, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[259, 261]], "note": "blank/separator/blank"}, {"id": 230, "kind": "nonclaim", "subtype": "heading", "lines": [[262, 263]], "note": "Section 9 heading"}, {"id": 231, "kind": "nonclaim", "subtype": "heading", "lines": [[264, 264]], "note": "Assumptions of Logistic Regression subheading"}, {"id": 232, "kind": "claim", "lines": [[265, 265]], "assertion": "binary outcome assumption is satisfied", "polarity": "found", "targets": ["model assumptions"], "confidence": "high", "shares_lines_with": []}, {"id": 233, "kind": "claim", "lines": [[266, 266]], "assertion": "independence assumption is partially met via player-clustered standard errors", "polarity": "found", "targets": ["model assumptions"], "confidence": "high", "shares_lines_with": []}, {"id": 234, "kind": "claim", "lines": [[267, 267]], "assertion": "the linearity-of-log-odds assumption is judged reasonable given standardized continuous predictors", "polarity": "found", "targets": ["model assumptions"], "confidence": "high", "shares_lines_with": []}, {"id": 235, "kind": "claim", "lines": [[268, 268]], "assertion": "the no-multicollinearity assumption is satisfied (VIFs<5)", "polarity": "found", "targets": ["model assumptions"], "confidence": "high", "shares_lines_with": []}, {"id": 236, "kind": "claim", "lines": [[269, 269]], "assertion": "the large-sample-size assumption is satisfied (N=123,868)", "polarity": "found", "targets": ["model assumptions"], "confidence": "high", "shares_lines_with": []}, {"id": 237, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[270, 270]], "note": "blank line"}, {"id": 238, "kind": "nonclaim", "subtype": "heading", "lines": [[271, 271]], "note": "Robustness Checks Performed subheading"}, {"id": 239, "kind": "claim", "lines": [[272, 275]], "assertion": "performed robustness checks: multiple skin tone definitions, an additional covariate (yellow cards), subgroup analyses (league, position, exposure), and diagnostics (VIFs, convergence)", "polarity": "did", "targets": ["robustness checks"], "confidence": "high", "shares_lines_with": []}, {"id": 240, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[276, 278]], "note": "blank/separator/blank"}, {"id": 241, "kind": "nonclaim", "subtype": "heading", "lines": [[279, 280]], "note": "Recommendations heading"}, {"id": 242, "kind": "nonclaim", "subtype": "framing", "lines": [[281, 287]], "note": "seven suggested directions for future research"}, {"id": 243, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[288, 290]], "note": "blank/separator/blank"}, {"id": 244, "kind": "nonclaim", "subtype": "heading", "lines": [[291, 292]], "note": "Reproducibility heading"}, {"id": 245, "kind": "claim", "lines": [[293, 298]], "assertion": "conducted all analyses in Python using pandas, numpy, statsmodels, scipy, and matplotlib/seaborn", "polarity": "did", "targets": ["software packages"], "confidence": "high", "shares_lines_with": []}, {"id": 246, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[299, 299]], "note": "blank line"}, {"id": 247, "kind": "claim", "lines": [[300, 300]], "assertion": "submitted the complete analysis script (final_analysis.py) which fully reproduces all reported results", "polarity": "did", "targets": ["analysis script"], "confidence": "high", "shares_lines_with": [248]}, {"id": 248, "kind": "claim", "lines": [[300, 300]], "assertion": "set the random seed to 42 for reproducibility", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": [247]}, {"id": 249, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[301, 301]], "note": "blank line"}, {"id": 250, "kind": "claim", "lines": [[302, 302]], "assertion": "used data source ./data/soccer/soccer.csv", "polarity": "did", "targets": ["data source"], "confidence": "high", "shares_lines_with": []}, {"id": 251, "kind": "claim", "lines": [[303, 303]], "assertion": "referenced codebook at ./data/soccer/codebook.txt", "polarity": "did", "targets": ["codebook"], "confidence": "high", "shares_lines_with": []}, {"id": 252, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[304, 304]], "note": "blank line"}, {"id": 253, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[305, 306]], "note": "separator and blank line"}, {"id": 254, "kind": "nonclaim", "subtype": "heading", "lines": [[307, 308]], "note": "Final Statement heading"}, {"id": 255, "kind": "claim", "lines": [[309, 309]], "assertion": "the data do not provide statistically significant evidence for the hypothesis (p=0.095), after adjusting for games, league, position, player characteristics, and within-player clustering", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [256, 257]}, {"id": 256, "kind": "claim", "lines": [[309, 309]], "assertion": "the estimated effect size is small (0.16pp) and the 95% CI includes zero", "polarity": "found", "targets": ["effect size"], "confidence": "high", "shares_lines_with": [255, 257]}, {"id": 257, "kind": "claim", "lines": [[309, 309]], "assertion": "sensitivity analyses using different skin tone definitions yielded similar conclusions, except the continuous definition which showed a statistically significant but still small effect (p=0.031)", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "high", "shares_lines_with": [255, 256]}, {"id": 258, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[310, 310]], "note": "blank line"}, {"id": 259, "kind": "claim", "lines": [[311, 311]], "assertion": "given the totality of evidence, the most defensible conclusion is that the hypothesis is NOT SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [260]}, {"id": 260, "kind": "claim", "lines": [[311, 311]], "assertion": "the possibility of a weak, context-dependent association cannot be entirely ruled out and warrants further investigation", "polarity": "found", "targets": ["conclusion"], "confidence": "low", "shares_lines_with": [259]}, {"id": 261, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[312, 312]], "note": "blank line"}, {"id": 262, "kind": "claim", "lines": [[313, 313]], "assertion": "final conclusion: NOT SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 263, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[314, 315]], "note": "blank line and end-of-tool-output marker"}]}}