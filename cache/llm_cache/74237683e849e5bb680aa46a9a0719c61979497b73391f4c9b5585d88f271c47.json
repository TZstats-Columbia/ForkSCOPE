im", "subtype": "boilerplate", "lines": [[48, 50]], "note": "section separator"}, {"id": 40, "kind": "nonclaim", "subtype": "heading", "lines": [[51, 52]], "note": "section 3 heading"}, {"id": 41, "kind": "nonclaim", "subtype": "heading", "lines": [[53, 53]], "note": "Unit of Analysis subheading"}, {"id": 42, "kind": "claim", "lines": [[54, 54]], "assertion": "the unit of analysis was player-referee dyads (N=115,603), each capturing the full encounter history between a player and referee", "polarity": "did", "targets": ["dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 43, "kind": "nonclaim", "subtype": "other", "lines": [[55, 55]], "note": "blank line"}, {"id": 44, "kind": "nonclaim", "subtype": "heading", "lines": [[56, 56]], "note": "Sample Characteristics subheading"}, {"id": 45, "kind": "claim", "lines": [[57, 63]], "assertion": "the sample comprised 1,419 players (1,089 light-skinned, 330 dark-skinned), 2,904 referees, 1,455 dyads with red cards (1.26%), 1,478 total red cards, 350,448 total games, 26,496 dark-skinned dyads (22.9%) and 89,107 light-skinned dyads (77.1%)", "polarity": "found", "targets": ["players", "referees", "dyads", "red cards", "games"], "confidence": "high", "shares_lines_with": []}, {"id": 46, "kind": "nonclaim", "subtype": "other", "lines": [[64, 64]], "note": "blank line"}, {"id": 47, "kind": "nonclaim", "subtype": "heading", "lines": [[65, 65]], "note": "Outcome Variable subheading"}, {"id": 48, "kind": "claim", "lines": [[66, 66]], "assertion": "the outcome was defined as a binary indicator of whether the player received at least one red card from that referee, base rate 1.26%", "polarity": "did", "targets": ["outcome variable"], "confidence": "high", "shares_lines_with": []}, {"id": 49, "kind": "nonclaim", "subtype": "other", "lines": [[67, 67]], "note": "blank line"}, {"id": 50, "kind": "nonclaim", "subtype": "heading", "lines": [[68, 68]], "note": "Exposure Variable subheading"}, {"id": 51, "kind": "claim", "lines": 