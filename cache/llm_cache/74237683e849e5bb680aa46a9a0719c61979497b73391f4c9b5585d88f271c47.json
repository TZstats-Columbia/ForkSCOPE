 "found", "targets": ["red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 115, "kind": "nonclaim", "subtype": "other", "lines": [[139, 139]], "note": "blank line"}, {"id": 116, "kind": "claim", "lines": [[140, 140]], "assertion": "because effect sizes vary dramatically by league and the sample is biased toward Germany, the pooled estimate may not generalize to the full population", "polarity": "found", "targets": ["pooled estimate", "generalizability"], "confidence": "medium", "shares_lines_with": [117]}, {"id": 117, "kind": "claim", "lines": [[140, 140]], "assertion": "results are only valid for the 77% of players with available photos", "polarity": "found", "targets": ["generalizability"], "confidence": "medium", "shares_lines_with": [116]}, {"id": 118, "kind": "nonclaim", "subtype": "other", "lines": [[141, 141]], "note": "blank line"}, {"id": 119, "kind": "nonclaim", "subtype": "heading", "lines": [[142, 142]], "note": "6.2 Measurement Issues subheading"}, {"id": 120, "kind": "nonclaim", "subtype": "heading", "lines": [[143, 143]], "note": "Skin tone coding lead-in"}, {"id": 121, "kind": "claim", "lines": [[144, 144]], "assertion": "skin tone coding was based on photos rather than in-person observation", "polarity": "did_not", "targets": ["skin tone coding"], "confidence": "high", "shares_lines_with": []}, {"id": 122, "kind": "claim", "lines": [[145, 145]], "assertion": "skin tone ratings are subjective, though inter-rater reliability is high (r=0.923)", "polarity": "found", "targets": ["skin tone ratings"], "confidence": "medium", "shares_lines_with": []}, {"id": 123, "kind": "nonclaim", "subtype": "hedging", "lines": [[146, 146]], "note": "generic caveat that skin tone may be confounded with other appearance characteristics, no specific choice named"}, {"id": 124, "kind": "claim", "lines": [[147, 147]], "assertion": "the 0.5 dichotomization cutpoint is arbitrary, though sensitivity analyses show some robustness to it", "polarity": "found", "targets": ["dichotomization cutpoint"], "confidence": "medium", "shares_lines_with": []}, {"id": 125, "kind": "nonclaim", "subtype": "other", "lines": [[148, 148]], "note": "blank line"}, {"id": 126, "kind": "nonclaim", "subtype": "heading", "lines": [[149, 149]], "note": "Outcome measurement lead-in"}, {"id": 127, "kind": "claim", "lines": [[150, 150]], "assertion": "dyad-level aggregation collapses variation across individual games", "polarity": "did", "targets": ["outcome aggregation"], "confidence": "high", "shares_lines_with": []}, {"id": 128, "kind": "claim", "lines": [[151, 151]], "assertion": "there is no information on whether red cards were justified vs discretionary", "polarity": "did_not", "targets": ["red card justification"], "confidence": "high", "shares_lines_with": []}, {"id": 129, "kind": "claim", "lines": [[152, 152]], "assertion": "red cards are rare events (1.26% base rate), limiting statistical power", "polarity": "found", "targets": ["statistical power"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "nonclaim", "subtype": "other", "lines": [[153, 153]], "note": "blank line"}, {"id": 131, "kind": "nonclaim", "subtype": "heading", "lines": [[154, 154]], "note": "6.3 Confounding subheading"}, {"id": 132, "kind": "nonclaim", "subtype": "heading", "lines": [[155, 155]], "note": "Residual confounding lead-in"}, {"id": 133, "kind": "claim", "lines": [[156, 156]], "assertion": "yellow cards per game is an imperfect proxy for playing style, and position categories may not fully capture role differences for dark-skinned players", "polarity": "did_not", "targets": ["yellow cards per game", "position"], "confidence": "medium", "shares_lines_with": []}, {"id": 134, "kind": "claim", "lines": [[157, 157]], "assertion": "referee fixed effects or referee-level bias measures were not modeled directly, despite clustering SEs by player", "polarity": "did_not", "targets": ["referee fixed effects"], "confidence": "high", "shares_lines_with": []}, {"id": 135, "kind": "claim", "lines": [[158, 158]], "assertion": "match context (score differential, game importance, home/away status) was not controlled for", "polarity": "did_not", "targets": ["match context"], "confidence": "high", "shares_lines_with": []}, {"id": 136, "kind": "nonclaim", "subtype": "other", "lines": [[159, 159]], "note": "blank line"}, {"id": 137, "kind": "claim", "lines": [[160, 160]], "assertion": "position and league are strong predictors of red card rate, and their inclusion changed the estimate from 0.11pp (unadjusted) to 0.17pp (adjusted)", "polarity": "found", "targets": ["position", "league", "adjusted estimate"], "confidence": "high", "shares_lines_with": [138]}, {"id": 138, "kind": "claim", "lines": [[160, 160]], "assertion": "residual confounding remains possible despite these adjustments", "polarity": "found", "targets": ["confounding"], "confidence": "medium", "shares_lines_with": [137]}, {"id": 139, "kind": "nonclaim", "subtype": "other", "lines": [[161, 161]], "note": "blank line"}, {"id": 140, "kind": "nonclaim", "subtype": "heading", "lines": [[162, 162]], "note": "6.4 Clustering subheading"}, {"id": 141, "kind": "claim", "lines": [[163, 163]], "assertion": "multiple dyads per player (avg 81) were addressed via clustered standard errors", "polarity": "did", "targets": ["clustered standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "claim", "lines": [[164, 164]], "assertion": "multiple dyads per referee (avg 46) were not explicitly modeled", "polarity": "did_not", "targets": ["referee clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "claim", "lines": [[165, 165]], "assertion": "within-dyad correlation across games could not be assessed because data was aggregated to the dyad level", "polarity": "did_not", "targets": ["within-dyad correlation"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "nonclaim", "subtype": "other", "lines": [[166, 166]], "note": "blank line"}, {"id": 145, "kind": "nonclaim", "subtype": "heading", "lines": [[167, 167]], "note": "6.5 External Validity subheading"}, {"id": 146, "kind": "claim", "lines": [[168, 168]], "assertion": "data is limited to the 2012-2013 season only, with unknown temporal generalizability", "polarity": "found", "targets": ["external validity"], "confidence": "high", "shares_lines_with": []}, {"id": 147, "kind": "claim", "lines": [[169, 169]], "assertion": "data is limited to four European leagues and may not apply to other regions", "polarity": "found", "targets": ["external validity"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "claim", "lines": [[170, 170]], "assertion": "the sample includes male players only", "polarity": "found", "targets": ["sample"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "claim", "lines": [[171, 171]], "assertion": "selection bias limits generalizability even within this context", "polarity": "found", "targets": ["selection bias"], "confidence": "medium", "shares_lines_with": []}, {"id": 150, "kind": "nonclaim", "subtype": "other", "lines": [[172, 172]], "note": "blank line"}, {"id": 151, "kind": "nonclaim", "subtype": "heading", "lines": [[173, 173]], "note": "6.6 Multiple Testing subheading"}, {"id": 152, "kind": "claim", "lines": [[174, 174]], "assertion": "the primary analysis was pre-specified", "polarity": "did", "targets": ["primary analysis"], "confidence": "medium", "shares_lines_with": [153]}, {"id": 153, "kind": "claim", "lines": [[174, 174]], "assertion": "extensive stratification and sensitivity analyses raise familywise error concerns, and the primary p-value (0.082) is not robust to multiplicity adjustment", "polarity": "found", "targets": ["p-value", "multiple testing"], "confidence": "medium", "shares_lines_with": [152]}, {"id": 154, "kind": "nonclaim", "subtype": "other", "lines": [[175, 175]], "note": "blank line"}, {"id": 155, "kind": "nonclaim", "subtype": "heading", "lines": [[176, 176]], "note": "6.7 Causal Interpretation subheading"}, {"id": 156, "kind": "claim", "lines": [[177, 177]], "assertion": "the study used an observational design", "polarity": "found", "targets": ["study design"], "confidence": "high", "shares_lines_with": []}, {"id": 157, "kind": "claim", "lines": [[178, 178]], "assertion": "reverse causation cannot be ruled out, though considered unlikely for skin tone to red cards and more plausible for behaviors affecting both skin tone perception and red cards", "polarity": "did_not", "targets": ["reverse causation"], "confidence": "medium", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "hedging", "lines": [[179, 179]], "note": "generic reference to unmeasured confounding ('see above'), no new specific content"}, {"id": 159, "kind": "claim", "lines": [[180, 180]], "assertion": "selection on observables cannot be ruled out; comparison groups may differ on unmeasured dimensions even after adjusting for measured covariates", "polarity": "did_not", "targets": ["selection on observables"], "confidence": "medium", "shares_lines_with": []}, {"id": 160, "kind": "nonclaim", "subtype": "other", "lines": [[181, 181]], "note": "blank line"}, {"id": 161, "kind": "nonclaim", "subtype": "heading", "lines": [[182, 182]], "note": "6.8 Key Assumptions subheading"}, {"id": 162, "kind": "claim", "lines": [[183, 183]], "assertion": "the analysis assumed the effect is homogeneous across contexts", "polarity": "did", "targets": ["assumption of homogeneity"], "confidence": "low", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[184, 184]], "assertion": "dramatic heterogeneity by league invalidates the pooled estimate as a single summary", "polarity": "found", "targets": ["pooled estimate", "heterogeneity"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[185, 187]], "note": "section separator"}, {"id": 165, "kind": "nonclaim", "subtype": "heading", "lines": [[188, 189]], "note": "section 7 heading"}, {"id": 166, "kind": "nonclaim", "subtype": "framing", "lines": [[190, 190]], "note": "restatement of the primary research question"}, {"id": 167, "kind": "nonclaim", "subtype": "other", "lines": [[191, 191]], "note": "blank line"}, {"id": 168, "kind": "claim", "lines": [[192, 192]], "assertion": "the answer to the primary question is NOT SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 169, "kind": "nonclaim", "subtype": "other", "lines": [[193, 193]], "note": "blank line"}, {"id": 170, "kind": "claim", "lines": [[194, 194]], "assertion": "the pooled adjusted risk difference is positive (0.17pp) but does not achieve significance (p=0.082) and the CI includes zero", "polarity": "found", "targets": ["adjusted risk difference"], "confidence": "high", "shares_lines_with": [171]}, {"id": 171, "kind": "claim", "lines": [[194, 194]], "assertion": "league-stratified analyses reveal the pooled estimate masks substantial heterogeneity", "polarity": "found", "targets": ["heterogeneity"], "confidence": "high", "shares_lines_with": [170]}, {"id": 172, "kind": "nonclaim", "subtype": "other", "lines": [[195, 195]], "note": "blank line"}, {"id": 173, "kind": "claim", "lines": [[196, 196]], "assertion": "England and Germany show statistically significant positive associations consistent with bias", "polarity": "found", "targets": ["England", "Germany"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "claim", "lines": [[197, 197]], "assertion": "France and Spain show no evidence of bias, with France showing a reversed though non-significant pattern", "polarity": "found", "targets": ["France", "Spain"], "confidence": "high", "shares_lines_with": []}, {"id": 175, "kind": "nonclaim", "subtype": "other", "lines": [[198, 198]], "note": "blank line"}, {"id": 176, "kind": "claim", "lines": [[199, 199]], "assertion": "this heterogeneity fundamentally undermines the hypothesis of a general referee bias", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": [177]}, {"id": 177, "kind": "claim", "lines": [[199, 199]], "assertion": "the phenomenon appears context-dependent, potentially reflecting different referee training, cultural norms, or player compositions across leagues", "polarity": "found", "targets": ["heterogeneity explanation"], "confidence": "low", "shares_lines_with": [176]}, {"id": 178, "kind": "nonclaim", "subtype": "other", "lines": [[200, 200]], "note": "blank line"}, {"id": 179, "kind": "nonclaim", "subtype": "heading", "lines": [[201, 201]], "note": "Effect Size subheading"}, {"id": 180, "kind": "claim", "lines": [[202, 202]], "assertion": "even where significant (England 0.38pp, Germany 0.50pp), the absolute magnitude is small relative to the 1.3% baseline rate", "polarity": "found", "targets": ["effect size"], "confidence": "high", "shares_lines_with": [181]}, {"id": 181, "kind": "claim", "lines": [[202, 202]], "assertion": "over 100 games, a dark-skinned player in Germany would receive about 0.5 additional red cards versus an identical light-skinned player", "polarity": "found", "targets": ["Germany", "effect size"], "confidence": "medium", "shares_lines_with": [180]}, {"id": 182, "kind": "nonclaim", "subtype": "other", "lines": [[203, 203]], "note": "blank line"}, {"id": 183, "kind": "nonclaim", "subtype": "heading", "lines": [[204, 204]], "note": "Uncertainty subheading"}, {"id": 184, "kind": "claim", "lines": [[205, 205]], "assertion": "the primary 95% CI spans zero and p=0.082 means chance cannot be ruled out at α=0.05", "polarity": "found", "targets": ["confidence interval", "p-value"], "confidence": "high", "shares_lines_with": [185]}, {"id": 185, "kind": "claim", "lines": [[205, 205]], "assertion": "marginal non-significance combined with the 20.8% exclusion rate and selection bias warrants skepticism about causal claims", "polarity": "found", "targets": ["causal inference"], "confidence": "medium", "shares_lines_with": [184]}, {"id": 186, "kind": "nonclaim", "subtype": "other", "lines": [[206, 206]], "note": "blank line"}, {"id": 187, "kind": "nonclaim", "subtype": "heading", "lines": [[207, 207]], "note": "Major Threats subheading"}, {"id": 188, "kind": "claim", "lines": [[208, 208]], "assertion": "selection bias (21% exclusion, systematic by league) is a major threat to validity", "polarity": "found", "targets": ["selection bias"], "confidence": "high", "shares_lines_with": []}, {"id": 189, "kind": "claim", "lines": [[209, 209]], "assertion": "heterogeneity, with the effect present in only 2 of 4 leagues, is a major threat to validity", "polarity": "found", "targets": ["heterogeneity"], "confidence": "high", "shares_lines_with": []}, {"id": 190, "kind": "claim", "lines": [[210, 210]], "assertion": "subjective skin tone coding from photos is a major threat to validity", "polarity": "found", "targets": ["measurement"], "confidence": "high", "shares_lines_with": []}, {"id": 191, "kind": "claim", "lines": [[211, 211]], "assertion": "unmeasured confounding from playing style and match context is a major threat to validity", "polarity": "found", "targets": ["confounding"], "confidence": "high", "shares_lines_with": []}, {"id": 192, "kind": "nonclaim", "subtype": "other", "lines": [[212, 212]], "note": "blank line"}, {"id": 193, "kind": "nonclaim", "subtype": "heading", "lines": [[213, 213]], "note": "Final Assessment subheading"}, {"id": 194, "kind": "claim", "lines": [[214, 214]], "assertion": "the expectation of finding weak or null evidence, approached as a skeptic, was largely confirmed by the mixed and marginal results", "polarity": "found", "targets": ["overall conclusion"], "confidence": "medium", "shares_lines_with": [195]}, {"id": 195, "kind": "claim", "lines": [[214, 214]], "assertion": "the data do not provide compelling evidence for a universal referee bias effect", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": [194]}, {"id": 196, "kind": "nonclaim", "subtype": "other", "lines": [[215, 215]], "note": "blank line"}, {"id": 197, "kind": "claim", "lines": [[216, 216]], "assertion": "genuine bias may exist in specific contexts (England and Germany)", "polarity": "found", "targets": ["England", "Germany"], "confidence": "low", "shares_lines_with": [198, 199]}, {"id": 198, "kind": "claim", "lines": [[216, 216]], "assertion": "alternative explanations (residual confounding, random variation, publication bias/data-mining) cannot be ruled out for the England/Germany findings", "polarity": "did_not", "targets": ["alternative explanations"], "confidence": "medium", "shares_lines_with": [197, 199]}, {"id": 199, "kind": "claim", "lines": [[216, 221]], "assertion": "a more definitive test would have required an experimental/quasi-experimental design, complete data without selection bias, better measurement distinguishing discretionary calls, referee-level analysis, and replication across seasons/leagues", "polarity": "would_have", "targets": ["future study design"], "confidence": "medium", "shares_lines_with": [197, 198]}, {"id": 200, "kind": "nonclaim", "subtype": "other", "lines": [[222, 222]], "note": "blank line"}, {"id": 201, "kind": "claim", "lines": [[223, 223]], "assertion": "the recommendation is that the hypothesis should be considered not supported, while acknowledging localized effects cannot be definitively ruled out but remain uncertain and small", "polarity": "found", "targets": ["recommendation"], "confidence": "high", "shares_lines_with": []}, {"id": 202, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[224, 226]], "note": "section separator"}, {"id": 203, "kind": "nonclaim", "subtype": "heading", "lines": [[227, 228]], "note": "deliverables summary heading"}, {"id": 204, "kind": "nonclaim", "subtype": "heading", "lines": [[229, 229]], "note": "Primary Estimand subheading"}, {"id": 205, "kind": "claim", "lines": [[230, 233]], "assertion": "restated primary estimand: adjusted RD 0.171pp, 95% CI [-0.022,0.363], p=0.082", "polarity": "found", "targets": ["adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 206, "kind": "nonclaim", "subtype": "other", "lines": [[234, 234]], "note": "blank line"}, {"id": 207, "kind": "nonclaim", "subtype": "heading", "lines": [[235, 235]], "note": "Secondary Estimand subheading"}, {"id": 208, "kind": "claim", "lines": [[236, 238]], "assertion": "restated secondary estimand: adjusted OR 1.145, 95% CI [0.981,1.336]", "polarity": "found", "targets": ["adjusted odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 209, "kind": "nonclaim", "subtype": "other", "lines": [[239, 239]], "note": "blank line"}, {"id": 210, "kind": "nonclaim", "subtype": "heading", "lines": [[240, 240]], "note": "Model Details subheading"}, {"id": 211, "kind": "claim", "lines": [[241, 241]], "assertion": "restated unit of analysis: player-referee dyads (N=115,603)", "polarity": "did", "targets": ["dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 212, "kind": "claim", "lines": [[242, 242]], "assertion": "restated covariates: position, league, games, yellow cards/game, age, height, weight", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 213, "kind": "claim", "lines": [[243, 243]], "assertion": "restated exclusions: 21% (missing skin tone or covariates)", "polarity": "found", "targets": ["exclusions"], "confidence": "high", "shares_lines_with": []}, {"id": 214, "kind": "claim", "lines": [[244, 244]], "assertion": "restated transformations: skin tone dichotomized at 0.5, yellow cards standardized by games", "polarity": "did", "targets": ["transformations"], "confidence": "high", "shares_lines_with": []}, {"id": 215, "kind": "claim", "lines": [[245, 245]], "assertion": "restated SE approach: player-clustered standard errors", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 216, "kind": "claim", "lines": [[246, 246]], "assertion": "restated method: linear probability model (primary), logistic regression (secondary)", "polarity": "did", "targets": ["model"], "confidence": "high", "shares_lines_with": []}, {"id": 217, "kind": "nonclaim", "subtype": "other", "lines": [[247, 247]], "note": "blank line"}, {"id": 218, "kind": "nonclaim", "subtype": "heading", "lines": [[248, 248]], "note": "Conclusion subheading"}, {"id": 219, "kind": "claim", "lines": [[249, 249]], "assertion": "the pooled estimate is small, marginally non-significant, and masks heterogeneity across leagues (significant England/Germany, null/reversed France/Spain)", "polarity": "found", "targets": ["pooled estimate"], "confidence": "high", "shares_lines_with": [220]}, {"id": 220, "kind": "claim", "lines": [[249, 249]], "assertion": "major selection bias and limited external validity further undermine causal inference", "polarity": "found", "targets": ["causal inference"], "confidence": "high", "shares_lines_with": [219]}, {"id": 221, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[250, 252]], "note": "section separator"}, {"id": 222, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[253, 253]], "note": "self-congratulatory closing statement"}, {"id": 223, "kind": "claim", "lines": [[254, 254]], "assertion": "all analyses are reproducible from the provided code file final_analysis.py", "polarity": "did", "targets": ["final_analysis.py"], "confidence": "low", "shares_lines_with": []}, {"id": 224, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[255, 256]], "note": "blank line and end marker"}]}}