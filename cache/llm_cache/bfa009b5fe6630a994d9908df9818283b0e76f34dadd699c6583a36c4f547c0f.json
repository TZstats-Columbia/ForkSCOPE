ce": "high", "shares_lines_with": []}, {"id": 120, "kind": "nonclaim", "subtype": "hedging", "lines": [[116, 116]], "note": "caveat about potential bias if excluded players differ systematically"}, {"id": 121, "kind": "claim", "lines": [[117, 117]], "assertion": "no evidence was found of systematic differences in red card rates between included and excluded dyads based on league, position, or other observables", "polarity": "found", "targets": ["red card rates", "included dyads", "excluded dyads"], "confidence": "medium", "shares_lines_with": []}, {"id": 122, "kind": "nonclaim", "subtype": "other", "lines": [[118, 118]], "note": "blank line"}, {"id": 123, "kind": "nonclaim", "subtype": "heading", "lines": [[119, 119]], "note": "measurement error list item header"}, {"id": 124, "kind": "claim", "lines": [[120, 120]], "assertion": "skin tone was rated from 2D profile photos rather than in-person assessment", "polarity": "did", "targets": ["skinTone"], "confidence": "high", "shares_lines_with": []}, {"id": 125, "kind": "nonclaim", "subtype": "hedging", "lines": [[121, 121]], "note": "caveat about lighting, photo quality, makeup affecting ratings"}, {"id": 126, "kind": "nonclaim", "subtype": "hedging", "lines": [[122, 122]], "note": "caveat that dichotomization at 0.5 may misclassify players near the cutoff"}, {"id": 127, "kind": "claim", "lines": [[123, 123]], "assertion": "the high inter-rater reliability (r=0.92) is argued to reduce concern about random measurement error", "polarity": "found", "targets": ["raters", "inter-rater reliability"], "confidence": "medium", "shares_lines_with": []}, {"id": 128, "kind": "claim", "lines": [[124, 124]], "assertion": "measurement error is asserted to likely attenuate effect estimates toward the null", "polarity": "found", "targets": ["measurement error"], "confidence": "low", "shares_lines_with": []}, {"id": 129, "kind": "nonclaim", "subtype": "other", "lines": [[125, 125]], "note": "blank line"}, {"id": 130, "kind": "nonclaim", "subtype": "heading", "lines": [[126, 126]], "note": "confounding list item header"}, {"id": 131, "kind": "claim", "lines": [[127, 127]], "assertion": "the model adjusted for key confounders: games, position, league, height, weight", "polarity": "did", "targets": ["confounders"], "confidence": "high", "shares_lines_with": []}, {"id": 132, "kind": "claim", "lines": [[128, 128]], "assertion": "the model did not adjust for player behavior (aggression, foul rates), which could mediate or confound the relationship", "polarity": "did_not", "targets": ["player behavior"], "confidence": "high", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "hedging", "lines": [[129, 129]], "note": "caveat that unmeasured confounding by playing style, tactics, or referee factors cannot be ruled out"}, {"id": 134, "kind": "claim", "lines": [[130, 130]], "assertion": "referee implicit bias measures (IAT, explicit thermometer) were available but not included in the primary model", "polarity": "did_not", "targets": ["referee implicit bias measures"], "confidence": "high", "shares_lines_with": []}, {"id": 135, "kind": "nonclaim", "subtype": "other", "lines": [[131, 131]], "note": "blank line"}, {"id": 136, "kind": "nonclaim", "subtype": "heading", "lines": [[132, 132]], "note": "collider bias list item header"}, {"id": 137, "kind": "nonclaim", "subtype": "hedging", "lines": [[133, 133]], "note": "caveat that number of games may be both confounder and collider"}, {"id": 138, "kind": "nonclaim", "subtype": "hedging", "lines": [[134, 134]], "note": "caveat that adjusting for games could introduce bias if it mediates the pathway"}, {"id": 139, "kind": "claim", "lines": [[135, 135]], "assertion": "a sensitivity analysis without games adjustment would clarify the collider bias concern, but was not performed", "polarity": "would_have", "targets": ["number of games", "sensitivity analysis"], "confidence": "medium", "shares_lines_with": []}, {"id": 140, "kind": "nonclaim", "subtype": "other", "lines": [[136, 136]], "note": "blank line"}, {"id": 141, "kind": "nonclaim", "subtype": "heading", "lines": [[137, 137]], "note": "rare outcome bias list item header"}, {"id": 142, "kind": "claim", "lines": [[138, 138]], "assertion": "only 1.26% of dyads have red cards, making the data sparse", "polarity": "found", "targets": ["red cards", "dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "nonclaim", "subtype": "background", "lines": [[139, 139]], "note": "general statistical fact about logistic regression and rare outcomes"}, {"id": 144, "kind": "claim", "lines": [[140, 140]], "assertion": "Firth penalized likelihood or exact methods could have been considered instead of standard logistic regression, but were not used", "polarity": "would_have", "targets": ["Firth penalized likelihood", "exact methods"], "confidence": "medium", "shares_lines_with": [145]}, {"id": 145, "kind": "claim", "lines": [[140, 140]], "assertion": "standard errors suggest the sample size (n=115,603) is adequate despite the rare outcome", "polarity": "found", "targets": ["standard errors", "sample size"], "confidence": "medium", "shares_lines_with": [144]}, {"id": 146, "kind": "nonclaim", "subtype": "other", "lines": [[141, 141]], "note": "blank line"}, {"id": 147, "kind": "nonclaim", "subtype": "heading", "lines": [[142, 142]], "note": "multiple testing list item header"}, {"id": 148, "kind": "claim", "lines": [[143, 143]], "assertion": "no adjustment was made for multiple comparisons across sensitivity analyses", "polarity": "did_not", "targets": ["multiple comparisons"], "confidence": "high", "shares_lines_with": []}, {"id": 149, "kind": "nonclaim", "subtype": "hedging", "lines": [[144, 144]], "note": "general caveat that testing multiple specifications increases type I error"}, {"id": 150, "kind": "claim", "lines": [[145, 145]], "assertion": "the primary estimand was pre-specified, which is argued to mitigate the multiple testing concern", "polarity": "did", "targets": ["primary estimand"], "confidence": "medium", "shares_lines_with": []}, {"id": 151, "kind": "nonclaim", "subtype": "other", "lines": [[146, 146]], "note": "blank line"}, {"id": 152, "kind": "nonclaim", "subtype": "heading", "lines": [[147, 147]], "note": ""}, {"id": 153, "kind": "nonclaim", "subtype": "other", "lines": [[148, 148]], "note": "blank line"}, {"id": 154, "kind": "claim", "lines": [[149, 149]], "assertion": "the analysis assumes no unmeasured confounding of the skin tone to red card relationship, though this is acknowledged as unlikely to hold perfectly", "polarity": "did", "targets": ["confounders"], "confidence": "medium", "shares_lines_with": []}, {"id": 155, "kind": "nonclaim", "subtype": "other", "lines": [[150, 150]], "note": "blank line"}, {"id": 156, "kind": "claim", "lines": [[151, 151]], "assertion": "the logistic model assumes linearity on the log-odds scale", "polarity": "did", "targets": ["logistic model"], "confidence": "high", "shares_lines_with": [157]}, {"id": 157, "kind": "claim", "lines": [[151, 151]], "assertion": "the continuous skin tone sensitivity analysis suggests potential non-linearity", "polarity": "found", "targets": ["skinTone"], "confidence": "medium", "shares_lines_with": [156]}, {"id": 158, "kind": "nonclaim", "subtype": "other", "lines": [[152, 152]], "note": "blank line"}, {"id": 159, "kind": "claim", "lines": [[153, 153]], "assertion": "the analysis assumes positivity — that all covariate combinations have some probability of both exposure levels", "polarity": "did", "targets": ["positivity"], "confidence": "high", "shares_lines_with": [160]}, {"id": 160, "kind": "claim", "lines": [[153, 153]], "assertion": "the positivity assumption is judged largely satisfied given the large sample size", "polarity": "found", "targets": ["positivity", "sample size"], "confidence": "medium", "shares_lines_with": [159]}, {"id": 161, "kind": "nonclaim", "subtype": "other", "lines": [[154, 154]], "note": "blank line"}, {"id": 162, "kind": "claim", "lines": [[155, 155]], "assertion": "the analysis assumes consistency (well-defined interventions), while noting dark skin is not a manipulable intervention and requires careful causal interpretation", "polarity": "did", "targets": ["consistency assumption"], "confidence": "medium", "shares_lines_with": []}, {"id": 163, "kind": "nonclaim", "subtype": "other", "lines": [[156, 156]], "note": "blank line"}, {"id": 164, "kind": "claim", "lines": [[157, 157]], "assertion": "the analysis assumes player-level clustering is the dominant source of non-independence", "polarity": "did", "targets": ["clustering"], "confidence": "high", "shares_lines_with": [165]}, {"id": 165, "kind": "claim", "lines": [[157, 157]], "assertion": "referee-level clustering or two-way clustering could have been used instead, but were not", "polarity": "would_have", "targets": ["clustering"], "confidence": "medium", "shares_lines_with": [164]}, {"id": 166, "kind": "nonclaim", "subtype": "other", "lines": [[158, 158]], "note": "blank line"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[159, 159]], "note": ""}, {"id": 168, "kind": "nonclaim", "subtype": "other", "lines": [[160, 160]], "note": "blank line"}, {"id": 169, "kind": "claim", "lines": [[161, 161]], "assertion": "because skin tone is not randomly assigned, results are interpreted as adjusted associations rather than causal effects", "polarity": "did_not", "targets": ["causal interpretation"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "nonclaim", "subtype": "other", "lines": [[162, 162]], "note": "blank line"}, {"id": 171, "kind": "claim", "lines": [[163, 163]], "assertion": "player-clustered standard errors address player-level correlation but not referee-level correlation", "polarity": "did", "targets": ["standard errors", "clustering"], "confidence": "high", "shares_lines_with": [172]}, {"id": 172, "kind": "claim", "lines": [[163, 163]], "assertion": "two-way clustering would have been more conservative but was not implemented due to computational constraints", "polarity": "would_have", "targets": ["two-way clustering"], "confidence": "high", "shares_lines_with": [171]}, {"id": 173, "kind": "nonclaim", "subtype": "other", "lines": [[164, 164]], "note": "blank line"}, {"id": 174, "kind": "claim", "lines": [[165, 165]], "assertion": "collapsing skin tone to binary at 0.5 loses information and may obscure a dose-response relationship", "polarity": "did", "targets": ["skinTone"], "confidence": "high", "shares_lines_with": [175]}, {"id": 175, "kind": "claim", "lines": [[165, 165]], "assertion": "the continuous analysis showed a stronger, significant effect (p=0.034)", "polarity": "found", "targets": ["skinTone"], "confidence": "high", "shares_lines_with": [174]}, {"id": 176, "kind": "nonclaim", "subtype": "other", "lines": [[166, 166]], "note": "blank line"}, {"id": 177, "kind": "nonclaim", "subtype": "hedging", "lines": [[167, 167]], "note": "generalizability caveat about the 2012-2013, four-league dataset"}, {"id": 178, "kind": "nonclaim", "subtype": "other", "lines": [[168, 168]], "note": "blank line"}, {"id": 179, "kind": "claim", "lines": [[169, 169]], "assertion": "the author did not consult prior published results on this dataset before conducting this analysis", "polarity": "did_not", "targets": ["prior published research"], "confidence": "high", "shares_lines_with": [180]}, {"id": 180, "kind": "claim", "lines": [[169, 169]], "assertion": "the dataset has previously been analyzed in published research and the hypothesis is not novel, raising potential for selective reporting", "polarity": "found", "targets": ["dataset", "hypothesis"], "confidence": "medium", "shares_lines_with": [179]}, {"id": 181, "kind": "nonclaim", "subtype": "other", "lines": [[170, 170]], "note": "blank line"}, {"id": 182, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[171, 171]], "note": "section divider"}, {"id": 183, "kind": "nonclaim", "subtype": "other", "lines": [[172, 172]], "note": "blank line"}, {"id": 184, "kind": "nonclaim", "subtype": "heading", "lines": [[173, 173]], "note": ""}, {"id": 185, "kind": "nonclaim", "subtype": "other", "lines": [[174, 174]], "note": "blank line"}, {"id": 186, "kind": "nonclaim", "subtype": "heading", "lines": [[175, 175]], "note": ""}, {"id": 187, "kind": "nonclaim", "subtype": "other", "lines": [[176, 176]], "note": "blank line"}, {"id": 188, "kind": "claim", "lines": [[177, 177]], "assertion": "a median-based skin tone cutoff of 0.5 was chosen for interpretability and to maximize sample size in both groups", "polarity": "did", "targets": ["skinTone cutoff"], "confidence": "high", "shares_lines_with": [189]}, {"id": 189, "kind": "claim", "lines": [[177, 177]], "assertion": "sensitivity analyses were run exploring alternative skin tone definitions (extreme comparison, continuous)", "polarity": "did", "targets": ["skinTone"], "confidence": "high", "shares_lines_with": [188]}, {"id": 190, "kind": "nonclaim", "subtype": "other", "lines": [[178, 178]], "note": "blank line"}, {"id": 191, "kind": "claim", "lines": [[179, 179]], "assertion": "a binary \"any red card\" outcome was used rather than a count, due to extreme rarity (98.8% zero)", "polarity": "did", "targets": ["red card outcome"], "confidence": "high", "shares_lines_with": [192]}, {"id": 192, "kind": "claim", "lines": [[179, 179]], "assertion": "count models (Poisson, negative binomial) were rejected because they would be dominated by zeros", "polarity": "did_not", "targets": ["Poisson model", "negative binomial model"], "confidence": "high", "shares_lines_with": [191]}, {"id": 193, "kind": "nonclaim", "subtype": "other", "lines": [[180, 180]], "note": "blank line"}, {"id": 194, "kind": "claim", "lines": [[181, 181]], "assertion": "covariates were selected for being plausible confounders and measured with good quality", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": [195]}, {"id": 195, "kind": "claim", "lines": [[181, 181]], "assertion": "referee characteristics (bias measures) were not included, to avoid post-treatment bias if referee selection is affected by player skin tone", "polarity": "did_not", "targets": ["referee characteristics"], "confidence": "high", "shares_lines_with": [194]}, {"id": 196, "kind": "nonclaim", "subtype": "other", "lines": [[182, 182]], "note": "blank line"}, {"id": 197, "kind": "claim", "lines": [[183, 183]], "assertion": "G-computation was chosen for the risk difference because it provides population-average effects integrating over the full covariate distribution", "polarity": "did", "targets": ["G-computation"], "confidence": "high", "shares_lines_with": [198]}, {"id": 198, "kind": "claim", "lines": [[183, 183]], "assertion": "marginal effects at the mean and the delta method were rejected as alternatives", "polarity": "did_not", "targets": ["marginal effects at the mean", "delta method"], "confidence": "high", "shares_lines_with": [197]}, {"id": 199, "kind": "nonclaim", "subtype": "other", "lines": [[184, 184]], "note": "blank line"}, {"id": 200, "kind": "claim", "lines": [[185, 185]], "assertion": "parameter simulation was used for inference", "polarity": "did", "targets": ["simulation"], "confidence": "high", "shares_lines_with": [201, 202]}, {"id": 201, "kind": "claim", "lines": [[185, 185]], "assertion": "bootstrap was not used, due to computational constraints with the large dataset and hierarchical structure", "polarity": "did_not", "targets": ["bootstrap"], "confidence": "high", "shares_lines_with": [200, 202]}, {"id": 202, "kind": "claim", "lines": [[185, 185]], "assertion": "the simulation was validated to yield results similar to analytical standard errors for the odds ratio", "polarity": "found", "targets": ["simulation", "odds ratio"], "confidence": "medium", "shares_lines_with": [200, 201]}, {"id": 203, "kind": "nonclaim", "subtype": "other", "lines": [[186, 186]], "note": "blank line"}, {"id": 204, "kind": "nonclaim", "subtype": "heading", "lines": [[187, 187]], "note": ""}, {"id": 205, "kind": "nonclaim", "subtype": "other", "lines": [[188, 188]], "note": "blank line"}, {"id": 206, "kind": "claim", "lines": [[189, 189]], "assertion": "all code was provided in final_analysis.py and the analysis is fully reproducible from the raw data file soccer.csv", "polarity": "did", "targets": ["final_analysis.py", "soccer.csv"], "confidence": "high", "shares_lines_with": []}, {"id": 207, "kind": "claim", "lines": [[190, 191]], "assertion": "the analysis used Python 3.11 with pandas, numpy, statsmodels, matplotlib, and scipy", "polarity": "did", "targets": ["Python", "pandas", "statsmodels"], "confidence": "high", "shares_lines_with": []}, {"id": 208, "kind": "nonclaim", "subtype": "other", "lines": [[192, 192]], "note": "blank line"}, {"id": 209, "kind": "claim", "lines": [[193, 193]], "assertion": "a random seed of 42 was set for reproducibility of the simulation-based inference", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 210, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "blank line"}, {"id": 211, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[195, 195]], "note": "section divider"}, {"id": 212, "kind": "nonclaim", "subtype": "other", "lines": [[196, 196]], "note": "blank line"}, {"id": 213, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 197]], "note": ""}, {"id": 214, "kind": "nonclaim", "subtype": "other", "lines": [[198, 198]], "note": "blank line"}, {"id": 215, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[199, 200]], "note": "table header and separator row"}, {"id": 216, "kind": "claim", "lines": [[201, 206]], "assertion": "summary table reports 115,603 dyads, 1,419 players, 2,904 referees, 26,496 (22.9%) dark skin, 89,107 (77.1%) light skin, and 1,455 (1.26%) red cards", "polarity": "found", "targets": ["dyads", "players", "referees", "dark skin", "light skin", "red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 217, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[207, 207]], "note": "blank table spacer row"}, {"id": 218, "kind": "claim", "lines": [[208, 208]], "assertion": "the unadjusted risk difference was 0.120 percentage points", "polarity": "found", "targets": ["unadjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 219, "kind": "claim", "lines": [[209, 211]], "assertion": "the adjusted risk difference was 0.172 percentage points, 95% CI [-0.021, 0.382], p=0.091", "polarity": "found", "targets": ["adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 220, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[212, 212]], "note": "blank table spacer row"}, {"id": 221, "kind": "claim", "lines": [[213, 215]], "assertion": "the adjusted odds ratio was 1.147, 95% CI [0.980, 1.342], p=0.088", "polarity": "found", "targets": ["adjusted odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 222, "kind": "nonclaim", "subtype": "other", "lines": [[216, 216]], "note": "blank line"}, {"id": 223, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[217, 217]], "note": "section divider"}, {"id": 224, "kind": "nonclaim", "subtype": "other", "lines": [[218, 218]], "note": "blank line"}, {"id": 225, "kind": "nonclaim", "subtype": "heading", "lines": [[219, 219]], "note": ""}, {"id": 226, "kind": "nonclaim", "subtype": "other", "lines": [[220, 220]], "note": "blank line"}, {"id": 227, "kind": "claim", "lines": [[221, 221]], "assertion": "the analysis provides insufficient evidence to support the hypothesis at α=0.05, given a 0.17 percentage point point estimate, a CI including zero, and p=0.091 exceeding the threshold", "polarity": "found", "targets": ["hypothesis", "adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 228, "kind": "nonclaim", "subtype": "other", "lines": [[222, 222]], "note": "blank line"}, {"id": 229, "kind": "nonclaim", "subtype": "framing", "lines": [[223, 223]], "note": "closing reflection on future research and methodological importance"}, {"id": 230, "kind": "nonclaim", "subtype": "other", "lines": [[224, 224]], "note": "blank line"}, {"id": 231, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[225, 225]], "note": "reproducible code file reference"}, {"id": 232, "kind": "claim", "lines": [[226, 226]], "assertion": "a figure (red_cards_analysis.png) was produced showing the distribution of simulated risk differences and unadjusted rates by position", "polarity": "did", "targets": ["figure", "risk differences", "position"], "confidence": "medium", "shares_lines_with": []}]}}