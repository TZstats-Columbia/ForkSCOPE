confidence": "high", "shares_lines_with": []}, {"id": 124, "kind": "nonclaim", "subtype": "heading", "lines": [[168, 170]], "note": "blank and subsection 6.2 heading"}, {"id": 125, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[171, 171]], "note": "'By League Country:' label"}, {"id": 126, "kind": "claim", "lines": [[172, 172]], "assertion": "found England: RD=0.39pp, OR=1.37, p=0.006 (strong positive effect)", "polarity": "found", "targets": ["England subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 127, "kind": "claim", "lines": [[173, 173]], "assertion": "found France: RD=-0.37pp, OR=0.78, p=0.071 (negative, not significant)", "polarity": "found", "targets": ["France subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 128, "kind": "claim", "lines": [[174, 174]], "assertion": "found Germany: RD=0.53pp, OR=1.68, p<0.001 (strongest effect)", "polarity": "found", "targets": ["Germany subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 129, "kind": "claim", "lines": [[175, 175]], "assertion": "found Spain: RD=0.08pp, OR=1.06, p=0.700 (null effect)", "polarity": "found", "targets": ["Spain subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 130, "kind": "nonclaim", "subtype": "other", "lines": [[176, 176]], "note": "blank line"}, {"id": 131, "kind": "claim", "lines": [[177, 177]], "assertion": "the effect is heterogeneous across leagues, suggesting referee culture/training may moderate bias", "polarity": "found", "targets": ["league heterogeneity"], "confidence": "medium", "shares_lines_with": [132]}, {"id": 132, "kind": "claim", "lines": [[177, 177]], "assertion": "the overall positive effect is driven primarily by England and Germany", "polarity": "found", "targets": ["league-driven effect"], "confidence": "high", "shares_lines_with": [131]}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[178, 179]], "note": "blank and 'By Position:' label"}, {"id": 134, "kind": "claim", "lines": [[180, 180]], "assertion": "found Defender: RD=0.13pp, OR=1.09, p=0.400 (not significant)", "polarity": "found", "targets": ["Defender subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 135, "kind": "claim", "lines": [[181, 181]], "assertion": "found Forward: RD=0.09pp, OR=1.10, p=0.516 (not significant)", "polarity": "found", "targets": ["Forward subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 136, "kind": "claim", "lines": [[182, 182]], "assertion": "found Goalkeeper: RD=-0.57pp, OR=0.56, p=0.221 (negative, not significant)", "polarity": "found", "targets": ["Goalkeeper subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 137, "kind": "claim", "lines": [[183, 183]], "assertion": "found Midfielder: RD=0.38pp, OR=1.41, p=0.006 (strong positive effect)", "polarity": "found", "targets": ["Midfielder subgroup"], "confidence": "high", "shares_lines_with": []}, {"id": 138, "kind": "nonclaim", "subtype": "other", "lines": [[184, 184]], "note": "blank line"}, {"id": 139, "kind": "claim", "lines": [[185, 185]], "assertion": "the effect is concentrated among midfielders, possibly due to greater referee discretion in midfield fouls versus clear-cut defensive fouls", "polarity": "found", "targets": ["position heterogeneity interpretation"], "confidence": "low", "shares_lines_with": []}, {"id": 140, "kind": "nonclaim", "subtype": "heading", "lines": [[186, 190]], "note": "divider and Section 7 heading"}, {"id": 141, "kind": "claim", "lines": [[191, 191]], "assertion": "the large sample (110,020 dyads, 1,374 events) provides good statistical power", "polarity": "found", "targets": ["sample size", "statistical power"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "claim", "lines": [[192, 192]], "assertion": "skin tone was validated by rating it independently with two blinded raters from photos", "polarity": "did", "targets": ["exposure validation"], "confidence": "high", "shares_lines_with": []}, {"id": 143, "kind": "claim", "lines": [[193, 193]], "assertion": "comprehensively adjusted for key confounders including player characteristics, playing style, league, and referee bias", "polarity": "did", "targets": ["covariate adjustment"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "claim", "lines": [[194, 194]], "assertion": "chose risk difference on the probability scale as the estimand because it is directly interpretable", "polarity": "did", "targets": ["estimand choice"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "claim", "lines": [[195, 195]], "assertion": "used a parametric bootstrap for rigorous inference that accounts for model uncertainty", "polarity": "did", "targets": ["inference method"], "confidence": "high", "shares_lines_with": []}, {"id": 146, "kind": "claim", "lines": [[196, 196]], "assertion": "found results were robust to model specification", "polarity": "found", "targets": ["sensitivity results"], "confidence": "high", "shares_lines_with": []}, {"id": 147, "kind": "claim", "lines": [[197, 197]], "assertion": "used pre-specified light-vs-dark skin categories, described as intuitive and avoiding arbitrary cutoffs", "polarity": "did", "targets": ["skin tone categorization"], "confidence": "high", "shares_lines_with": []}, {"id": 148, "kind": "claim", "lines": [[198, 198]], "assertion": "player-referee assignments are treated as a quasi-random natural experiment, reducing selection bias", "polarity": "found", "targets": ["natural experiment design"], "confidence": "medium", "shares_lines_with": []}, {"id": 149, "kind": "nonclaim", "subtype": "heading", "lines": [[199, 203]], "note": "divider and Section 8 heading"}, {"id": 150, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[204, 205]], "note": "intro label and blank line"}, {"id": 151, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[206, 207]], "note": "coefficients table header"}, {"id": 152, "kind": "claim", "lines": [[208, 208]], "assertion": "found skin tone (dark vs light) coefficient=0.153, 95% CI [0.023,0.284], p=0.021", "polarity": "found", "targets": ["skin tone coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[209, 209]], "assertion": "found games coefficient=0.120, 95% CI [0.110,0.130], p<0.001", "polarity": "found", "targets": ["games coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "claim", "lines": [[210, 210]], "assertion": "found yellow cards coefficient=0.092, 95% CI [0.044,0.140], p<0.001", "polarity": "found", "targets": ["yellow cards coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 155, "kind": "claim", "lines": [[211, 211]], "assertion": "found referee IAT coefficient=1.482, 95% CI [-0.575,3.540], p=0.158 (not significant)", "polarity": "found", "targets": ["referee IAT coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 156, "kind": "claim", "lines": [[212, 212]], "assertion": "found Forward vs Defender coefficient=-0.407, 95% CI [-0.559,-0.254], p<0.001", "polarity": "found", "targets": ["position coefficient (Forward)"], "confidence": "high", "shares_lines_with": []}, {"id": 157, "kind": "claim", "lines": [[213, 213]], "assertion": "found Goalkeeper vs Defender coefficient=-0.278, 95% CI [-0.484,-0.072], p=0.008", "polarity": "found", "targets": ["position coefficient (Goalkeeper)"], "confidence": "high", "shares_lines_with": []}, {"id": 158, "kind": "claim", "lines": [[214, 214]], "assertion": "found Midfielder vs Defender coefficient=-0.397, 95% CI [-0.534,-0.259], p<0.001", "polarity": "found", "targets": ["position coefficient (Midfielder)"], "confidence": "high", "shares_lines_with": []}, {"id": 159, "kind": "claim", "lines": [[215, 215]], "assertion": "found France vs England coefficient=0.469, 95% CI [0.305,0.633], p<0.001 (more red cards in France)", "polarity": "found", "targets": ["league coefficient (France)"], "confidence": "high", "shares_lines_with": []}, {"id": 160, "kind": "claim", "lines": [[216, 216]], "assertion": "found Germany vs England coefficient=-0.121, 95% CI [-0.279,0.038], p=0.137 (not significant)", "polarity": "found", "targets": ["league coefficient (Germany)"], "confidence": "high", "shares_lines_with": []}, {"id": 161, "kind": "claim", "lines": [[217, 217]], "assertion": "found Spain vs England coefficient=0.442, 95% CI [0.286,0.598], p<0.001 (more red cards in Spain)", "polarity": "found", "targets": ["league coefficient (Spain)"], "confidence": "high", "shares_lines_with": []}, {"id": 162, "kind": "claim", "lines": [[218, 218]], "assertion": "found height coefficient=0.004, 95% CI [-0.009,0.017], p=0.550 (not significant)", "polarity": "found", "targets": ["height coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 163, "kind": "claim", "lines": [[219, 219]], "assertion": "found weight coefficient=0.014, 95% CI [0.001,0.026], p=0.037 (heavier players slightly higher risk)", "polarity": "found", "targets": ["weight coefficient"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "nonclaim", "subtype": "heading", "lines": [[220, 224]], "note": "divider and Section 9 heading"}, {"id": 165, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[225, 226]], "note": "comparison table header"}, {"id": 166, "kind": "claim", "lines": [[227, 227]], "assertion": "found P(red card|Light) unadjusted 1.216% vs adjusted 1.204% (-0.01pp)", "polarity": "found", "targets": ["light skin risk"], "confidence": "high", "shares_lines_with": []}, {"id": 167, "kind": "claim", "lines": [[228, 228]], "assertion": "found P(red card|Dark) unadjusted 1.354% vs adjusted 1.395% (+0.04pp)", "polarity": "found", "targets": ["dark skin risk"], "confidence": "high", "shares_lines_with": []}, {"id": 168, "kind": "claim", "lines": [[229, 229]], "assertion": "found risk difference unadjusted 0.139pp vs adjusted 0.191pp (+0.05pp, 38% increase)", "polarity": "found", "targets": ["risk difference comparison"], "confidence": "high", "shares_lines_with": []}, {"id": 169, "kind": "claim", "lines": [[230, 230]], "assertion": "found relative risk unadjusted 1.114 vs adjusted 1.159 (+0.045, 4% increase)", "polarity": "found", "targets": ["relative risk comparison"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "nonclaim", "subtype": "other", "lines": [[231, 231]], "note": "blank line"}, {"id": 171, "kind": "claim", "lines": [[232, 232]], "assertion": "adjustment for confounders increased the estimated effect, suggesting confounders were masking part of the true association (e.g., dark-skinned players playing fewer games or having fewer yellow cards)", "polarity": "found", "targets": ["confounder masking interpretation"], "confidence": "medium", "shares_lines_with": []}, {"id": 172, "kind": "nonclaim", "subtype": "heading", "lines": [[233, 237]], "note": "divider and Section 10 heading"}, {"id": 173, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[238, 239]], "note": "assumptions table header"}, {"id": 174, "kind": "claim", "lines": [[240, 240]], "assertion": "assessed the 'correct outcome model' assumption as partially met since logistic regression is appropriate for a binary outcome", "polarity": "found", "targets": ["outcome model assumption"], "confidence": "high", "shares_lines_with": [175]}, {"id": 175, "kind": "claim", "lines": [[240, 240]], "assertion": "did not test linearity on the logit scale", "polarity": "did_not", "targets": ["logit linearity"], "confidence": "high", "shares_lines_with": [174]}, {"id": 176, "kind": "claim", "lines": [[241, 241]], "assertion": "assessed the 'no unmeasured confounding' assumption as uncertain because player behavior/reputation was not fully captured", "polarity": "found", "targets": ["unmeasured confounding assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 177, "kind": "claim", "lines": [[242, 242]], "assertion": "assessed the positivity assumption as met, since both light and dark players are represented across covariate strata", "polarity": "found", "targets": ["positivity assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 178, "kind": "claim", "lines": [[243, 243]], "assertion": "assessed the consistency assumption as met given a well-defined intervention (skin tone category)", "polarity": "found", "targets": ["consistency assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 179, "kind": "claim", "lines": [[244, 244]], "assertion": "assessed the 'missing at random' assumption as uncertain since missingness may relate to player prominence", "polarity": "found", "targets": ["missing data assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 180, "kind": "claim", "lines": [[245, 245]], "assertion": "assessed the independence assumption as not fully met because dyads are nested within players and referees", "polarity": "found", "targets": ["independence assumption"], "confidence": "high", "shares_lines_with": [181]}, {"id": 181, "kind": "claim", "lines": [[245, 245]], "assertion": "did not use clustered standard errors despite the nested dyad structure", "polarity": "did_not", "targets": ["clustered standard errors"], "confidence": "high", "shares_lines_with": [180]}, {"id": 182, "kind": "claim", "lines": [[246, 246]], "assertion": "assessed the 'no effect modification' assumption as not met, since subgroup analyses show heterogeneity by league and position", "polarity": "found", "targets": ["effect modification assumption"], "confidence": "high", "shares_lines_with": []}, {"id": 183, "kind": "nonclaim", "subtype": "heading", "lines": [[247, 253]], "note": "divider, Final Summary Table heading, and Primary Analysis Results subheading"}, {"id": 184, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[254, 255]], "note": "final summary table header"}, {"id": 185, "kind": "claim", "lines": [[256, 256]], "assertion": "restated adjusted risk difference of 0.1911pp, 95% CI [0.0264,0.3683], p=0.021, significant and positive", "polarity": "found", "targets": ["adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 186, "kind": "claim", "lines": [[257, 257]], "assertion": "restated adjusted odds ratio of 1.1655, 95% CI [1.0230,1.3278], p=0.021, significant and >1", "polarity": "found", "targets": ["adjusted odds ratio"], "confidence": "high", "shares_lines_with": []}, {"id": 187, "kind": "nonclaim", "subtype": "heading", "lines": [[258, 259]], "note": "blank and Model Details subheading"}, {"id": 188, "kind": "claim", "lines": [[260, 260]], "assertion": "restated N=110,020 dyads (83,582 light skin, 26,438 dark skin)", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 189, "kind": "claim", "lines": [[261, 261]], "assertion": "restated outcome as any red card in dyad, 1,374 events, 1.25% prevalence", "polarity": "found", "targets": ["outcome definition"], "confidence": "high", "shares_lines_with": []}, {"id": 190, "kind": "claim", "lines": [[262, 262]], "assertion": "restated covariates used: games, position, league, height, weight, yellow cards, referee implicit bias", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 191, "kind": "claim", "lines": [[263, 263]], "assertion": "restated estimation method as logistic regression with marginal standardization", "polarity": "did", "targets": ["estimation method"], "confidence": "high", "shares_lines_with": []}, {"id": 192, "kind": "claim", "lines": [[264, 264]], "assertion": "restated standard errors as computed via parametric bootstrap (10,000 simulations)", "polarity": "did", "targets": ["standard error method"], "confidence": "high", "shares_lines_with": []}, {"id": 193, "kind": "nonclaim", "subtype": "heading", "lines": [[265, 266]], "note": "blank and Interpretation subheading"}, {"id": 194, "kind": "claim", "lines": [[267, 267]], "assertion": "restated a 0.19 percentage point higher probability for dark-skinned players, a 15.9% relative increase from 1.20% to 1.40%", "polarity": "found", "targets": ["effect size restatement"], "confidence": "high", "shares_lines_with": [195]}, {"id": 195, "kind": "claim", "lines": [[267, 267]], "assertion": "restated the effect as statistically significant (p=0.021) and robust to model specification", "polarity": "found", "targets": ["significance restatement"], "confidence": "high", "shares_lines_with": [194]}, {"id": 196, "kind": "nonclaim", "subtype": "heading", "lines": [[268, 269]], "note": "blank and Conclusion subheading"}, {"id": 197, "kind": "claim", "lines": [[270, 270]], "assertion": "concluded SUPPORTED — statistically significant evidence consistent with referees giving more red cards to dark-skin-toned players", "polarity": "found", "targets": ["overall conclusion"], "confidence": "high", "shares_lines_with": [198, 199, 200]}, {"id": 198, "kind": "claim", "lines": [[270, 270]], "assertion": "the effect is modest in absolute terms but precisely estimated, robust across sensitivity analyses, and practically meaningful in high-stakes matches", "polarity": "found", "targets": ["effect characterization"], "confidence": "high", "shares_lines_with": [197, 199, 200]}, {"id": 199, "kind": "claim", "lines": [[270, 270]], "assertion": "acknowledged limitations including potential unmeasured confounding, measurement error in skin tone ratings, missing data, and cross-league heterogeneity", "polarity": "found", "targets": ["limitations"], "confidence": "low", "shares_lines_with": [197, 198, 200]}, {"id": 200, "kind": "claim", "lines": [[270, 270]], "assertion": "the analysis establishes only a robust adjusted association, and causal interpretation requires additional no-unmeasured-confounding assumptions", "polarity": "did_not", "targets": ["causal interpretation"], "confidence": "high", "shares_lines_with": [197, 198, 199]}, {"id": 201, "kind": "nonclaim", "subtype": "heading", "lines": [[271, 275]], "note": "divider and Reproducibility Statement heading"}, {"id": 202, "kind": "claim", "lines": [[276, 281]], "assertion": "conducted all analyses in Python 3.x using pandas, numpy, statsmodels, matplotlib/seaborn, and scipy", "polarity": "did", "targets": ["software packages"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "nonclaim", "subtype": "other", "lines": [[282, 282]], "note": "blank line"}, {"id": 204, "kind": "claim", "lines": [[283, 286]], "assertion": "submitted complete reproducible code in final_analysis.py, runnable via 'python final_analysis.py'", "polarity": "did", "targets": ["reproducible code"], "confidence": "high", "shares_lines_with": []}, {"id": 205, "kind": "nonclaim", "subtype": "other", "lines": [[287, 287]], "note": "blank line"}, {"id": 206, "kind": "claim", "lines": [[288, 288]], "assertion": "set random seed to 42 for reproducibility of bootstrap simulations", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": [207]}, {"id": 207, "kind": "claim", "lines": [[288, 288]], "assertion": "documented all data, code, and results in the report and accompanying files", "polarity": "did", "targets": ["documentation"], "confidence": "high", "shares_lines_with": [206]}, {"id": 208, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[289, 290]], "note": "blank line and tool output end marker"}]}}