claim", "subtype": "boilerplate", "lines": [[32, 34]], "note": "blank/divider/blank"}, {"id": 31, "kind": "nonclaim", "subtype": "heading", "lines": [[35, 36]], "note": "Section 3 heading + blank"}, {"id": 32, "kind": "nonclaim", "subtype": "heading", "lines": [[37, 37]], "note": "Unit of Analysis subheading"}, {"id": 33, "kind": "claim", "lines": [[38, 38]], "assertion": "unit of analysis was player-referee dyads, with N=116,160", "polarity": "found", "targets": ["player-referee dyads"], "confidence": "high", "shares_lines_with": []}, {"id": 34, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[39, 39]], "note": "blank line"}, {"id": 35, "kind": "nonclaim", "subtype": "heading", "lines": [[40, 40]], "note": "Sample Characteristics subheading"}, {"id": 36, "kind": "claim", "lines": [[41, 41]], "assertion": "there were 1,433 unique players in the sample", "polarity": "found", "targets": ["players"], "confidence": "high", "shares_lines_with": []}, {"id": 37, "kind": "claim", "lines": [[42, 42]], "assertion": "there were 2,917 unique referees in the sample", "polarity": "found", "targets": ["referees"], "confidence": "high", "shares_lines_with": []}, {"id": 38, "kind": "claim", "lines": [[43, 43]], "assertion": "there were 1,457 red card events, a 1.25% overall rate", "polarity": "found", "targets": ["red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 39, "kind": "claim", "lines": [[44, 44]], "assertion": "light-skinned dyads numbered 89,502 (77.1%) with 1,098 red cards (1.23%)", "polarity": "found", "targets": ["light-skinned dyads", "red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 40, "kind": "claim", "lines": [[45, 45]], "assertion": "dark-skinned dyads numbered 26,658 (22.9%) with 359 red cards (1.35%)", "polarity": "found", "targets": ["dark-skinned dyads", "red cards"], "confidence": "high", "shares_lines_with": []}, {"id": 41, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[46, 46]], "note": "blank line"}, {"i