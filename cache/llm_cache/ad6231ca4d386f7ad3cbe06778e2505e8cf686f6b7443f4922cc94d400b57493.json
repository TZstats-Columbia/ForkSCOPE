ro", "polarity": "found", "targets": ["conclusion", "p-value", "confidence interval"], "confidence": "high", "shares_lines_with": [9]}, {"id": 9, "kind": "claim", "lines": [[7, 7]], "assertion": "robustness checks using alternative clustering and specifications consistently showed statistically significant effects in the same direction", "polarity": "found", "targets": ["robustness checks", "clustering"], "confidence": "high", "shares_lines_with": [8]}, {"id": 10, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[8, 10]], "note": "blank/divider/blank"}, {"id": 11, "kind": "nonclaim", "subtype": "heading", "lines": [[11, 12]], "note": "Section 1 heading + blank"}, {"id": 12, "kind": "claim", "lines": [[13, 13]], "assertion": "point estimate of the adjusted risk difference was 0.1872 percentage points (0.001872 absolute)", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 13, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[14, 14]], "note": "blank line"}, {"id": 14, "kind": "claim", "lines": [[15, 15]], "assertion": "95% CI for the risk difference was [-0.0025, 0.3768] percentage points", "polarity": "found", "targets": ["confidence interval", "risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 15, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[16, 16]], "note": "blank line"}, {"id": 16, "kind": "claim", "lines": [[17, 17]], "assertion": "two-sided p-value was 0.0531 at alpha=0.05", "polarity": "found", "targets": ["p-value"], "confidence": "high", "shares_lines_with": []}, {"id": 17, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[18, 18]], "note": "blank line"}, {"id": 18, "kind": "claim", "lines": [[19, 19]], "assertion": "adjusted for games played, player position, league country, and yellow cards", "polarity": "did", "targets": ["games", "position", "leagueCountry", "yellowCards"], "confidence": "high", "shares_lines_with": [19]}, {"id": 19, "kind":