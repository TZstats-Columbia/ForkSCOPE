: [[130, 130]], "assertion": "the Germany-only analysis gave OR=2.127, CI [1.523,2.970], p<0.001, a very strong effect", "polarity": "found", "targets": ["Germany"], "confidence": "high", "shares_lines_with": []}, {"id": 140, "kind": "claim", "lines": [[131, 131]], "assertion": "the France-only analysis gave OR=0.782, CI [0.567,1.078], p=0.133, a null/protective trend", "polarity": "found", "targets": ["France"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "claim", "lines": [[132, 132]], "assertion": "the Spain-only analysis gave OR=0.986, CI [0.649,1.496], p=0.946, a null result", "polarity": "found", "targets": ["Spain"], "confidence": "high", "shares_lines_with": []}, {"id": 142, "kind": "nonclaim", "subtype": "other", "lines": [[133, 133]], "note": "blank line"}, {"id": 143, "kind": "nonclaim", "subtype": "heading", "lines": [[134, 134]], "note": "Key findings subheading"}, {"id": 144, "kind": "claim", "lines": [[135, 135]], "assertion": "the effect is robust to treating skin tone as a continuous variable", "polarity": "found", "targets": ["robustness"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "claim", "lines": [[136, 136]], "assertion": "the effect persists after controlling for yellow cards, suggesting it is not fully explained by playing style", "polarity": "found", "targets": ["yellow cards", "playing style"], "confidence": "medium", "shares_lines_with": []}, {"id": 146, "kind": "claim", "lines": [[137, 137]], "assertion": "the overall effect is driven primarily by Germany and England, with null results in France and Spain", "polarity": "found", "targets": ["Germany", "England", "France", "Spain"], "confidence": "high", "shares_lines_with": [147]}, {"id": 147, "kind": "claim", "lines": [[137, 137]], "assertion": "this heterogeneity is interpreted as suggesting the phenomenon is context-dependent rather than universal", "polarity": "found", "targets": ["heterogeneity interpretation"], "confidence": "medium", "shares_lines_with": [146]}, {"id": 148, "kind": "nonclaim", "subtype": "other", "lines": [[138, 138]], "note": "blank line"}, {"id": 149, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[139, 139]], "note": "section divider"}, {"id": 150, "kind": "nonclaim", "subtype": "other", "lines": [[140, 140]], "note": "blank line"}, {"id": 151, "kind": "nonclaim", "subtype": "heading", "lines": [[141, 141]], "note": "section 5 heading"}, {"id": 152, "kind": "nonclaim", "subtype": "other", "lines": [[142, 142]], "note": "blank line"}, {"id": 153, "kind": "nonclaim", "subtype": "heading", "lines": [[143, 143]], "note": "5.1 Missing Data subheading"}, {"id": 154, "kind": "claim", "lines": [[144, 144]], "assertion": "14.7% of dyads were excluded due to missing photographs/skin tone ratings", "polarity": "found", "targets": ["missing data"], "confidence": "high", "shares_lines_with": []}, {"id": 155, "kind": "claim", "lines": [[145, 145]], "assertion": "15.3% of dyads were excluded due to missing position or medium skin tone", "polarity": "found", "targets": ["missing data"], "confidence": "high", "shares_lines_with": []}, {"id": 156, "kind": "nonclaim", "subtype": "hedging", "lines": [[146, 146]], "note": "raises a hypothetical selection-bias concern without asserting a specific action taken"}, {"id": 157, "kind": "claim", "lines": [[147, 147]], "assertion": "a sensitivity analysis restricted to high-exposure players yielded nearly identical results, as a mitigation check", "polarity": "found", "targets": ["high-exposure sensitivity analysis"], "confidence": "medium", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "other", "lines": [[148, 148]], "note": "blank line"}, {"id": 159, "kind": "nonclaim", "subtype": "heading", "lines": [[149, 149]], "note": "5.2 Measurement of Skin Tone subheading"}, {"id": 160, "kind": "claim", "lines": [[150, 150]], "assertion": "skin tone was assessed based on photographs", "polarity": "did", "targets": ["skin tone measurement"], "confidence": "high", "shares_lines_with": [161]}, {"id": 161, "kind": "claim", "lines": [[150, 150]], "assertion": "skin tone was not assessed via in-person assessment", "polarity": "did_not", "targets": ["skin tone measurement"], "confidence": "high", "shares_lines_with": [160]}, {"id": 162, "kind": "nonclaim", "subtype": "hedging", "lines": [[151, 151]], "note": "caveat that raters' perceptions may differ from referees' real-time perceptions"}, {"id": 163, "kind": "nonclaim", "subtype": "hedging", "lines": [[152, 152]], "note": "caveat about lighting/photo quality introducing measurement error"}, {"id": 164, "kind": "claim", "lines": [[153, 153]], "assertion": "inter-rater reliability was high (r=0.92), suggesting consistent coding", "polarity": "found", "targets": ["inter-rater reliability"], "confidence": "high", "shares_lines_with": [165]}, {"id": 165, "kind": "claim", "lines": [[153, 153]], "assertion": "classical measurement error would be expected to bias the estimate toward the null", "polarity": "found", "targets": ["measurement error bias"], "confidence": "medium", "shares_lines_with": [164]}, {"id": 166, "kind": "nonclaim", "subtype": "other", "lines": [[154, 154]], "note": "blank line"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[155, 155]], "note": "5.3 Residual Confounding subheading"}, {"id": 168, "kind": "nonclaim", "subtype": "hedging", "lines": [[156, 156]], "note": "general caveat that unmeasured confounders could explain the association"}, {"id": 169, "kind": "nonclaim", "subtype": "other", "lines": [[157, 157]], "note": "blank line"}, {"id": 170, "kind": "nonclaim", "subtype": "hedging", "lines": [[158, 158]], "note": "playing style/aggression as a possible unmeasured confounder"}, {"id": 171, "kind": "nonclaim", "subtype": "hedging", "lines": [[159, 159]], "note": "player nationality/ethnicity as a possible unmeasured confounder"}, {"id": 172, "kind": "nonclaim", "subtype": "hedging", "lines": [[160, 160]], "note": "team quality/tactics as a possible unmeasured confounder"}, {"id": 173, "kind": "claim", "lines": [[161, 161]], "assertion": "the analysis did not adjust for match context (match importance, score differential, home/away status)", "polarity": "did_not", "targets": ["match context"], "confidence": "high", "shares_lines_with": []}, {"id": 174, "kind": "nonclaim", "subtype": "other", "lines": [[162, 162]], "note": "blank line"}, {"id": 175, "kind": "nonclaim", "subtype": "heading", "lines": [[163, 163]], "note": "5.4 Clustering Structure subheading"}, {"id": 176, "kind": "claim", "lines": [[164, 164]], "assertion": "the analysis accounted for player-level clustering", "polarity": "did", "targets": ["player-level clustering"], "confidence": "high", "shares_lines_with": [177]}, {"id": 177, "kind": "claim", "lines": [[164, 164]], "assertion": "the analysis did not account for referee-level clustering", "polarity": "did_not", "targets": ["referee-level clustering"], "confidence": "high", "shares_lines_with": [176]}, {"id": 178, "kind": "claim", "lines": [[165, 165]], "assertion": "the analysis did not account for team or match clustering", "polarity": "did_not", "targets": ["team/match clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 179, "kind": "claim", "lines": [[166, 166]], "assertion": "two-way (player × referee) clustering would have been more appropriate but was not used due to computational demands", "polarity": "would_have", "targets": ["two-way clustering"], "confidence": "high", "shares_lines_with": []}, {"id": 180, "kind": "nonclaim", "subtype": "other", "lines": [[167, 167]], "note": "blank line"}, {"id": 181, "kind": "nonclaim", "subtype": "heading", "lines": [[168, 168]], "note": "5.5 Rare Outcome subheading"}, {"id": 182, "kind": "claim", "lines": [[169, 169]], "assertion": "the overall red card rate is only 1.25%", "polarity": "found", "targets": ["red card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 183, "kind": "nonclaim", "subtype": "hedging", "lines": [[170, 170]], "note": "caveat that a low event rate reduces statistical power and precision"}, {"id": 184, "kind": "nonclaim", "subtype": "hedging", "lines": [[171, 171]], "note": "caveat about possible finite-sample bias in logistic regression with rare outcomes, tempered by large sample size"}, {"id": 185, "kind": "nonclaim", "subtype": "other", "lines": [[172, 172]], "note": "blank line"}, {"id": 186, "kind": "nonclaim", "subtype": "heading", "lines": [[173, 173]], "note": "5.6 Effect Heterogeneity subheading"}, {"id": 187, "kind": "claim", "lines": [[174, 174]], "assertion": "the effect varies dramatically by league: null in France/Spain, strong in Germany/England", "polarity": "found", "targets": ["league heterogeneity"], "confidence": "high", "shares_lines_with": []}, {"id": 188, "kind": "nonclaim", "subtype": "hedging", "lines": [[175, 175]], "note": "raises the open question of whether heterogeneity reflects genuine bias or league-specific factors"}, {"id": 189, "kind": "nonclaim", "subtype": "hedging", "lines": [[176, 176]], "note": "caveat that a single fixed overall effect may not represent the heterogeneous pattern well"}, {"id": 190, "kind": "nonclaim", "subtype": "other", "lines": [[177, 177]], "note": "blank line"}, {"id": 191, "kind": "nonclaim", "subtype": "heading", "lines": [[178, 178]], "note": "5.7 Causal Interpretation subheading"}, {"id": 192, "kind": "nonclaim", "subtype": "hedging", "lines": [[179, 179]], "note": "notes the observational design and states that causality cannot be definitively claimed"}, {"id": 193, "kind": "nonclaim", "subtype": "hedging", "lines": [[180, 180]], "note": "alternative explanation that dark-skinned players' behaviors could legitimately warrant more red cards"}, {"id": 194, "kind": "nonclaim", "subtype": "hedging", "lines": [[181, 181]], "note": "alternative explanation that the association could reflect implicit bias or explicit discrimination, mechanisms not distinguishable from behavior"}, {"id": 195, "kind": "nonclaim", "subtype": "other", "lines": [[182, 182]], "note": "blank line"}, {"id": 196, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[183, 183]], "note": "section divider"}, {"id": 197, "kind": "nonclaim", "subtype": "other", "lines": [[184, 184]], "note": "blank line"}, {"id": 198, "kind": "nonclaim", "subtype": "heading", "lines": [[185, 185]], "note": "section 6 heading"}, {"id": 199, "kind": "nonclaim", "subtype": "other", "lines": [[186, 186]], "note": "blank line"}, {"id": 200, "kind": "nonclaim", "subtype": "heading", "lines": [[187, 187]], "note": "Interpretation of Findings subheading"}, {"id": 201, "kind": "nonclaim", "subtype": "other", "lines": [[188, 188]], "note": "blank line"}, {"id": 202, "kind": "claim", "lines": [[189, 189]], "assertion": "the analysis found statistically significant evidence that dark-skinned players receive red cards at a slightly higher rate than light-skinned players, even after adjusting for key confounders", "polarity": "found", "targets": ["dark-skinned players", "light-skinned players"], "confidence": "high", "shares_lines_with": [203, 204]}, {"id": 203, "kind": "claim", "lines": [[189, 189]], "assertion": "the 0.26 percentage point risk difference is small in absolute terms (1.22% to 1.48%) but a 21% relative increase", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": [202, 204]}, {"id": 204, "kind": "claim", "lines": [[189, 189]], "assertion": "over a full season this effect could translate to dozens of additional red cards attributable to skin tone", "polarity": "found", "targets": ["extrapolated red card impact"], "confidence": "low", "shares_lines_with": [202, 203]}, {"id": 205, "kind": "nonclaim", "subtype": "other", "lines": [[190, 190]], "note": "blank line"}, {"id": 206, "kind": "nonclaim", "subtype": "hedging", "lines": [[191, 191]], "note": "introduces factors that temper the conclusion"}, {"id": 207, "kind": "nonclaim", "subtype": "other", "lines": [[192, 192]], "note": "blank line"}, {"id": 208, "kind": "claim", "lines": [[193, 193]], "assertion": "the effect size is modest and the odds-ratio CI barely excludes 1.0 (lower bound 1.014)", "polarity": "found", "targets": ["effect size", "confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 209, "kind": "nonclaim", "subtype": "other", "lines": [[194, 194]], "note": "blank line"}, {"id": 210, "kind": "claim", "lines": [[195, 195]], "assertion": "the effect is concentrated in Germany and England with no evidence in France or Spain, suggesting a context-dependent rather than universal phenomenon", "polarity": "found", "targets": ["Germany", "England", "France", "Spain"], "confidence": "high", "shares_lines_with": []}, {"id": 211, "kind": "nonclaim", "subtype": "hedging", "lines": [[196, 196]], "note": "speculative explanation - different referee training/cultures across leagues"}, {"id": 212, "kind": "nonclaim", "subtype": "hedging", "lines": [[197, 197]], "note": "speculative explanation - different distributions of player characteristics correlating with skin tone"}, {"id": 213, "kind": "claim", "lines": [[198, 198]], "assertion": "supplementary analyses found that explicit/implicit bias measures from Project Implicit were not strongly predictive of the country-level heterogeneity", "polarity": "found", "targets": ["Project Implicit", "implicit bias measures"], "confidence": "medium", "shares_lines_with": []}, {"id": 214, "kind": "nonclaim", "subtype": "other", "lines": [[199, 199]], "note": "blank line"}, {"id": 215, "kind": "nonclaim", "subtype": "hedging", "lines": [[200, 200]], "note": "caveat that residual confounding by playing style, nationality, or other factors could explain some or all of the association"}, {"id": 216, "kind": "nonclaim", "subtype": "other", "lines": [[201, 201]], "note": "blank line"}, {"id": 217, "kind": "claim", "lines": [[202, 202]], "assertion": "the effect persists across multiple model specifications (continuous skin tone, yellow-card control, high-exposure subgroup), strengthening confidence it is not a statistical artifact", "polarity": "found", "targets": ["robustness checks"], "confidence": "medium", "shares_lines_with": []}, {"id": 218, "kind": "nonclaim", "subtype": "other", "lines": [[203, 203]], "note": "blank line"}, {"id": 219, "kind": "nonclaim", "subtype": "heading", "lines": [[204, 204]], "note": "Comparison to Prior Literature subheading"}, {"id": 220, "kind": "nonclaim", "subtype": "other", "lines": [[205, 205]], "note": "blank line"}, {"id": 221, "kind": "claim", "lines": [[206, 206]], "assertion": "the results are described as consistent with Silberzahn & Uhlmann (2015) and the subsequent 'Many Analysts' crowdsourced project, aligning with the central tendency of that literature", "polarity": "found", "targets": ["Silberzahn & Uhlmann (2015)", "Many Analysts project"], "confidence": "medium", "shares_lines_with": []}, {"id": 222, "kind": "claim", "lines": [[207, 207]], "assertion": "the effect size (OR ~1.2-1.3) is similar to that in the prior literature", "polarity": "found", "targets": ["effect size comparison"], "confidence": "medium", "shares_lines_with": []}, {"id": 223, "kind": "claim", "lines": [[208, 208]], "assertion": "concerns about heterogeneity and confounding are similar to those in the prior literature", "polarity": "found", "targets": ["heterogeneity", "confounding"], "confidence": "medium", "shares_lines_with": []}, {"id": 224, "kind": "claim", "lines": [[209, 209]], "assertion": "the effect is characterized as modest but potentially meaningful, echoing the prior literature", "polarity": "found", "targets": ["effect characterization"], "confidence": "medium", "shares_lines_with": []}, {"id": 225, "kind": "nonclaim", "subtype": "other", "lines": [[210, 210]], "note": "blank line"}, {"id": 226, "kind": "nonclaim", "subtype": "heading", "lines": [[211, 211]], "note": "Implications subheading"}, {"id": 227, "kind": "nonclaim", "subtype": "other", "lines": [[212, 212]], "note": "blank line"}, {"id": 228, "kind": "nonclaim", "subtype": "hedging", "lines": [[213, 213]], "note": "conditional discussion of fairness implications if the association reflects bias vs behavioral differences"}, {"id": 229, "kind": "nonclaim", "subtype": "other", "lines": [[214, 214]], "note": "blank line"}, {"id": 230, "kind": "nonclaim", "subtype": "framing", "lines": [[215, 215]], "note": "introduces recommendations for further research"}, {"id": 231, "kind": "nonclaim", "subtype": "framing", "lines": [[216, 216]], "note": "suggests video-based experiments to distinguish bias from behavior"}, {"id": 232, "kind": "nonclaim", "subtype": "framing", "lines": [[217, 217]], "note": "suggests investigating mechanisms of cross-league heterogeneity"}, {"id": 233, "kind": "nonclaim", "subtype": "framing", "lines": [[218, 218]], "note": "suggests investigating interventions such as referee training or VAR review"}, {"id": 234, "kind": "nonclaim", "subtype": "other", "lines": [[219, 219]], "note": "blank line"}, {"id": 235, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[220, 220]], "note": "section divider"}, {"id": 236, "kind": "nonclaim", "subtype": "other", "lines": [[221, 221]], "note": "blank line"}, {"id": 237, "kind": "nonclaim", "subtype": "heading", "lines": [[222, 222]], "note": "section 7 heading"}, {"id": 238, "kind": "nonclaim", "subtype": "other", "lines": [[223, 223]], "note": "blank line"}, {"id": 239, "kind": "claim", "lines": [[224, 224]], "assertion": "the hypothesis is concluded to be supported: dark-skinned players have a statistically significantly higher probability of red cards (adjusted risk difference 0.26pp, CI [0.07,0.46], p=0.008)", "polarity": "found", "targets": ["hypothesis", "adjusted risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 240, "kind": "nonclaim", "subtype": "other", "lines": [[225, 225]], "note": "blank line"}, {"id": 241, "kind": "nonclaim", "subtype": "framing", "lines": [[226, 226]], "note": "introduces the list of caveats"}, {"id": 242, "kind": "claim", "lines": [[227, 227]], "assertion": "the effect size is small in absolute terms though meaningful in relative and cumulative terms", "polarity": "found", "targets": ["effect size"], "confidence": "medium", "shares_lines_with": []}, {"id": 243, "kind": "claim", "lines": [[228, 228]], "assertion": "the effect is highly heterogeneous across leagues, driven by Germany and England, null in France and Spain", "polarity": "found", "targets": ["league heterogeneity"], "confidence": "high", "shares_lines_with": []}, {"id": 244, "kind": "nonclaim", "subtype": "hedging", "lines": [[229, 229]], "note": "caveat that residual confounding by unmeasured factors cannot be ruled out"}, {"id": 245, "kind": "nonclaim", "subtype": "hedging", "lines": [[230, 230]], "note": "caveat that the observational design precludes definitive causal inference"}, {"id": 246, "kind": "nonclaim", "subtype": "other", "lines": [[231, 231]], "note": "blank line"}, {"id": 247, "kind": "claim", "lines": [[232, 232]], "assertion": "overall, the data are described as providing evidence consistent with a small, modest, context-dependent bias, sufficient but not overwhelming to support the hypothesis, with further experimental research needed", "polarity": "found", "targets": ["overall conclusion"], "confidence": "medium", "shares_lines_with": []}, {"id": 248, "kind": "nonclaim", "subtype": "other", "lines": [[233, 233]], "note": "blank line"}, {"id": 249, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[234, 234]], "note": "section divider"}, {"id": 250, "kind": "nonclaim", "subtype": "other", "lines": [[235, 235]], "note": "blank line"}, {"id": 251, "kind": "nonclaim", "subtype": "heading", "lines": [[236, 236]], "note": "Appendix: Reproducibility heading"}, {"id": 252, "kind": "nonclaim", "subtype": "other", "lines": [[237, 237]], "note": "blank line"}, {"