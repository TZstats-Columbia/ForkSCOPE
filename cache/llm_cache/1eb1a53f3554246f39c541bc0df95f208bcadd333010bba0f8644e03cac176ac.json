argets": ["referee country bias"], "confidence": "high", "shares_lines_with": []}, {"id": 99, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[108, 108]], "note": "blank line"}, {"id": 100, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[109, 110]], "note": "divider/blank"}, {"id": 101, "kind": "nonclaim", "subtype": "heading", "lines": [[111, 111]], "note": "section 5 heading"}, {"id": 102, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[112, 112]], "note": "blank line"}, {"id": 103, "kind": "nonclaim", "subtype": "heading", "lines": [[113, 113]], "note": "subheading Strengths"}, {"id": 104, "kind": "claim", "lines": [[114, 114]], "assertion": "large sample of 115,457 dyads spanning four major European leagues", "polarity": "found", "targets": ["sample size"], "confidence": "high", "shares_lines_with": []}, {"id": 105, "kind": "claim", "lines": [[115, 115]], "assertion": "characterized the outcome as objective because red cards are recorded administrative data", "polarity": "found", "targets": ["red card"], "confidence": "low", "shares_lines_with": []}, {"id": 106, "kind": "claim", "lines": [[116, 116]], "assertion": "skin tone was coded blindly by two independent raters, achieving high agreement (r=0.92)", "polarity": "did", "targets": ["skin tone", "rater1", "rater2"], "confidence": "high", "shares_lines_with": []}, {"id": 107, "kind": "claim", "lines": [[117, 117]], "assertion": "adjustment included a rich set of covariates: player position, league, physical attributes, game exposure, and referee country bias", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 108, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[118, 118]], "note": "blank line"}, {"id": 109, "kind": "nonclaim", "subtype": "heading", "lines": [[119, 119]], "note": "subheading Limitations and Favorable Assumptions"}, {"id": 110, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[120, 120]], "note": "blank line"}, {"id": 111, "kind": "nonclaim", "subtype": "heading", "lines": [[121, 121]], "note": "subheading 1. In-sample, exploratory analysis"}, {"id": 112, "kind": "claim", "lines": [[122, 122]], "assertion": "all modeling choices were optimized in-sample to maximize evidence for the hypothesis, which the authors say inflates the risk of false positives and overfitting", "polarity": "did", "targets": ["specification search"], "confidence": "high", "shares_lines_with": [113, 114]}, {"id": 113, "kind": "claim", "lines": [[122, 122]], "assertion": "reported p-values do not correct for the specification search (no correction for multiple comparisons or model selection)", "polarity": "did_not", "targets": ["p-value"], "confidence": "high", "shares_lines_with": [112, 114]}, {"id": 114, "kind": "claim", "lines": [[122, 122]], "assertion": "labeled the analysis exploratory and stated findings require preregistered replication in an independent sample", "polarity": "did", "targets": ["findings"], "confidence": "low", "shares_lines_with": [112, 113]}, {"id": 115, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[123, 123]], "note": "blank line"}, {"id": 116, "kind": "nonclaim", "subtype": "heading", "lines": [[124, 124]], "note": "subheading 2. Skin tone cutpoint selection"}, {"id": 117, "kind": "claim", "lines": [[125, 125]], "assertion": "the 0.375 cutpoint was chosen because it yielded the strongest effect", "polarity": "did", "targets": ["skin tone cutpoint"], "confidence": "high", "shares_lines_with": [118]}, {"id": 118, "kind": "claim", "lines": [[125, 125]], "assertion": "other cutpoints (0.25, 0.5) also show significant effects, which is said to reduce concern that the result is an artifact of a single arbitrary threshold", "polarity": "found", "targets": ["skin tone cutpoint"], "confidence": "medium", "shares_lines_with": [117]}, {"id": 119, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[126, 126]], "note": "blank line"}, {"id": 120, "kind": "nonclaim", "subtype": "heading", "lines": [[127, 127]], "note": "subheading 3. Unmeasured confounding"}, {"id": 121, "kind": "claim", "lines": [[128, 128]], "assertion": "did not control for playing style (aggression, tackles, fouls) as a covariate, noting this could confound the skin-tone/red-card association if more aggressive players are also darker-skinned", "polarity": "did_not", "targets": ["playing style"], "confidence": "high", "shares_lines_with": []}, {"id": 122, "kind": "claim", "lines": [[129, 129]], "assertion": "skin tone distribution varies by league, with France having the highest proportion of dark-skinned players", "polarity": "found", "targets": ["league country", "skin tone"], "confidence": "high", "shares_lines_with": [123, 124]}, {"id": 123, "kind": "claim", "lines": [[129, 129]], "assertion": "controlled for league fixed effects", "polarity": "did", "targets": ["league country"], "confidence": "high", "shares_lines_with": [122, 124]}, {"id": 124, "kind": "claim", "lines": [[129, 129]], "assertion": "did not control for player nationality, cultural factors, or league-specific enforcement norms, leaving possible residual confounding", "polarity": "did_not", "targets": ["nationality", "cultural factors", "enforcement norms"], "confidence": "medium", "shares_lines_with": [122, 123]}, {"id": 125, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[130, 130]], "note": "blank line"}, {"id": 126, "kind": "nonclaim", "subtype": "heading", "lines": [[131, 131]], "note": "subheading 4. Dyadic structure and clustering"}, {"id": 127, "kind": "claim", "lines": [[132, 132]], "assertion": "observations are non-independent dyads, with multiple dyads per player and per referee inducing clustering", "polarity": "found", "targets": ["clustering"], "confidence": "high", "shares_lines_with": [128, 129]}, {"id": 128, "kind": "claim", "lines": [[132, 132]], "assertion": "reported standard (non-clustered) standard errors as the primary result, which are smaller and more favorable to rejecting the null than clustered errors", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": [127, 129]}, {"id": 129, "kind": "claim", "lines": [[132, 132]], "assertion": "post-hoc player-clustered standard errors are about 18% larger (SE=0.072 vs 0.061 for the log-OR), giving a two-sided p≈0.03, with the effect remaining significant but weaker", "polarity": "found", "targets": ["standard errors", "p-value"], "confidence": "high", "shares_lines_with": [127, 128]}, {"id": 130, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[133, 133]], "note": "blank line"}, {"id": 131, "kind": "nonclaim", "subtype": "heading", "lines": [[134, 134]], "note": "subheading 5. Rare outcome and effect magnitude"}, {"id": 132, "kind": "claim", "lines": [[135, 135]], "assertion": "the absolute risk difference (0.185pp) is small though non-negligible given the ~1.26% baseline, with practical significance framed as context-dependent and potentially reflecting systematic bias when aggregated", "polarity": "found", "targets": ["risk difference"], "confidence": "medium", "shares_lines_with": []}, {"id": 133, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[136, 136]], "note": "blank line"}, {"id": 134, "kind": "nonclaim", "subtype": "heading", "lines": [[137, 137]], "note": "subheading 6. Missingness"}, {"id": 135, "kind": "claim", "lines": [[138, 138]], "assertion": "21,407 dyads (14.7%) lack skin tone data because of missing player photos", "polarity": "found", "targets": ["skin tone", "missingness"], "confidence": "high", "shares_lines_with": [136, 137]}, {"id": 136, "kind": "claim", "lines": [[138, 138]], "assertion": "performed descriptive checks (not shown) indicating missingness is associated with fewer games per dyad", "polarity": "did", "targets": ["missingness", "games"], "confidence": "medium", "shares_lines_with": [135, 137]}, {"id": 137, "kind": "claim", "lines": [[138, 138]], "assertion": "concluded excluded dyads likely involve less prominent players or referees, which could bias results if the skin tone-red card relationship differs by prominence", "polarity": "found", "targets": ["missingness"], "confidence": "medium", "shares_lines_with": [135, 136]}, {"id": 138, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[139, 139]], "note": "blank line"}, {"id": 139, "kind": "nonclaim", "subtype": "heading", "lines": [[140, 140]], "note": "subheading 7. Causal interpretation"}, {"id": 140, "kind": "claim", "lines": [[141, 141]], "assertion": "cannot definitively attribute the effect to discrimination without experimental or quasi-experimental evidence", "polarity": "did_not", "targets": ["causal interpretation"], "confidence": "high", "shares_lines_with": []}, {"id": 141, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[142, 142]], "note": "blank line"}, {"id": 142, "kind": "nonclaim", "subtype": "heading", "lines": [[143, 143]], "note": "subheading Why These Assumptions Are Defensible"}, {"id": 143, "kind": "claim", "lines": [[144, 144]], "assertion": "multiple cutpoint thresholds were tested and all show consistent effects", "polarity": "found", "targets": ["skin tone cutpoint"], "confidence": "high", "shares_lines_with": []}, {"id": 144, "kind": "claim", "lines": [[145, 145]], "assertion": "adjusted for a comprehensive set of measured confounders (position, league, physical attributes, game exposure, referee bias)", "polarity": "did", "targets": ["covariates"], "confidence": "high", "shares_lines_with": []}, {"id": 145, "kind": "claim", "lines": [[146, 146]], "assertion": "treated non-clustered standard errors as standard practice for dyadic data where dyads are the unit of interest, using this to justify the choice", "polarity": "did", "targets": ["standard errors"], "confidence": "medium", "shares_lines_with": [146]}, {"id": 146, "kind": "claim", "lines": [[146, 146]], "assertion": "characterized clustered standard errors as conservative, noting the effect remains directionally consistent under clustering", "polarity": "found", "targets": ["standard errors"], "confidence": "medium", "shares_lines_with": [145]}, {"id": 147, "kind": "claim", "lines": [[147, 147]], "assertion": "all analytic choices are documented and reproducible, with code provided for full replication", "polarity": "did", "targets": ["reproducibility"], "confidence": "medium", "shares_lines_with": []}, {"id": 148, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[148, 148]], "note": "blank line"}, {"id": 149, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[149, 150]], "note": "divider/blank"}, {"id": 150, "kind": "nonclaim", "subtype": "heading", "lines": [[151, 151]], "note": "section 6 heading"}, {"id": 151, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[152, 152]], "note": "blank line"}, {"id": 152, "kind": "claim", "lines": [[153, 153]], "assertion": "overall conclusion: the hypothesis is SUPPORTED", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[154, 154]], "note": "blank line"}, {"id": 154, "kind": "claim", "lines": [[155, 155]], "assertion": "concludes there is consistent, statistically significant evidence that dark-skinned players are more likely to receive red cards after adjustment", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [155]}, {"id": 155, "kind": "claim", "lines": [[155, 155]], "assertion": "characterizes the effect as small in absolute terms but a 15% relative increase, robust to alternative skin tone coding, covariate specifications, and exclusion of referee bias controls", "polarity": "found", "targets": ["conclusion"], "confidence": "high", "shares_lines_with": [154]}, {"id": 156, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[156, 156]], "note": "blank line"}, {"id": 157, "kind": "claim", "lines": [[157, 157]], "assertion": "characterizes the magnitude as modest but non-negligible, noting the lower CI bound (0.039) is near zero while the point estimate and upper bound suggest a meaningful signal, and restates the two-sided (0.013) and one-sided (0.007) p-values", "polarity": "found", "targets": ["risk difference", "p-value"], "confidence": "medium", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[158, 158]], "note": "blank line"}, {"id": 159, "kind": "claim", "lines": [[159, 159]], "assertion": "states the analysis cannot rule out confounding by unmeasured player behavior or other factors", "polarity": "did_not", "targets": ["confounding"], "confidence": "high", "shares_lines_with": [160]}, {"id": 160, "kind": "claim", "lines": [[159, 159]], "assertion": "findings are said to motivate preregistered confirmatory research that would ideally incorporate additional controls (foul counts, playing style metrics) and appropriately address clustering, which this analysis did not do", "polarity": "would_have", "targets": ["confounding", "clustering"], "confidence": "low", "shares_lines_with": [159]}, {"id": 161, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[160, 160]], "note": "blank line"}, {"id": 162, "kind": "nonclaim", "subtype": "framing", "lines": [[161, 161]], "note": "forward-looking recommendations for future research"}, {"id": 163, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[162, 162]], "note": "blank line"}, {"id": 164, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[163, 164]], "note": "divider/blank"}, {"id": 165, "kind": "nonclaim", "subtype": "heading", "lines": [[165, 165]], "note": "Reproducibility heading"}, {"id": 166, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[166, 166]], "note": "blank line"}, {"id": 167, "kind": "claim", "lines": [[167, 167]], "assertion": "results are reproducible from the provided script (final_analysis.py) and dataset (soccer.csv), run in Python 3.11 with pandas, numpy, and statsmodels", "polarity": "did", "targets": ["reproducibility"], "confidence": "medium", "shares_lines_with": [168]}, {"id": 168, "kind": "claim", "lines": [[167, 167]], "assertion": "no stochastic operations were used in the final analysis, despite a seed of 42 being set", "polarity": "did_not", "targets": ["reproducibility"], "confidence": "medium", "shares_lines_with": [167]}, {"id": 169, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[168, 168]], "note": "blank line"}, {"id": 170, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[169, 169]], "note": "contact line"}]}}