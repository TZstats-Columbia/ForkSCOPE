m", "subtype": "hedging", "lines": [[155, 155]], "note": "conditional caveat about possible bias from missingness, no specific action named"}, {"id": 135, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[156, 156]], "note": "blank"}, {"id": 136, "kind": "nonclaim", "subtype": "heading", "lines": [[157, 157]], "note": "5.2 unmeasured confounding subheading"}, {"id": 137, "kind": "nonclaim", "subtype": "framing", "lines": [[158, 158]], "note": "intro to potential confounders list"}, {"id": 138, "kind": "nonclaim", "subtype": "hedging", "lines": [[159, 159]], "note": "speculative caveat about player reputation as a possible confounder"}, {"id": 139, "kind": "nonclaim", "subtype": "hedging", "lines": [[160, 160]], "note": "speculative caveat about player stature/physicality as a possible confounder (source text appears garbled)"}, {"id": 140, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[161, 161]], "note": "blank"}, {"id": 141, "kind": "claim", "lines": [[162, 162]], "assertion": "used yellow card rate as a partial mitigation/proxy for foul tendency, acknowledged as imperfect", "polarity": "did", "targets": ["yellow card rate"], "confidence": "medium", "shares_lines_with": [142]}, {"id": 142, "kind": "claim", "lines": [[162, 162]], "assertion": "found light-skinned players had more yellow cards per game yet still received fewer red cards, suggesting they were not less aggressive", "polarity": "found", "targets": ["yellow card rate", "red card rate"], "confidence": "high", "shares_lines_with": [141]}, {"id": 143, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[163, 163]], "note": "blank"}, {"id": 144, "kind": "nonclaim", "subtype": "heading", "lines": [[164, 164]], "note": "5.3 measurement issues subheading"}, {"id": 145, "kind": "nonclaim", "subtype": "hedging", "lines": [[165, 165]], "note": "caveat that photo-based ratings may not reflect real-time referee perception"}, {"id": 146, "kind": "claim", "lines": [[166, 166]], "assertion": "dichotomized continuous skin tone into binary categories, acknowledging this loses information", "polarity": "did", "targets": ["skin tone dichotomization"], "confidence": "high", "shares_lines_with": []}, {"id": 147, "kind": "nonclaim", "subtype": "hedging", "lines": [[167, 167]], "note": "caveat that raters may perceive skin tone differently than referees from other countries"}, {"id": 148, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[168, 168]], "note": "blank"}, {"id": 149, "kind": "nonclaim", "subtype": "heading", "lines": [[169, 169]], "note": "5.4 structural limitations subheading"}, {"id": 150, "kind": "claim", "lines": [[170, 170]], "assertion": "found the dyadic data structure creates complex clustering (~81 dyads/player, ~46 dyads/referee)", "polarity": "found", "targets": ["data structure", "clustering"], "confidence": "medium", "shares_lines_with": []}, {"id": 151, "kind": "claim", "lines": [[171, 171]], "assertion": "addressed clustering via player-clustered standard errors", "polarity": "did", "targets": ["standard errors"], "confidence": "high", "shares_lines_with": []}, {"id": 152, "kind": "claim", "lines": [[172, 172]], "assertion": "considered but did not use crossed random effects (player × referee) because it was computationally intensive", "polarity": "did_not", "targets": ["crossed random effects"], "confidence": "high", "shares_lines_with": []}, {"id": 153, "kind": "claim", "lines": [[173, 173]], "assertion": "found only 1.26% of dyads have red cards, limiting statistical power for subgroup analyses", "polarity": "found", "targets": ["red card rate", "statistical power"], "confidence": "high", "shares_lines_with": []}, {"id": 154, "kind": "nonclaim", "subtype": "hedging", "lines": [[174, 174]], "note": "generic caveat that observational design cannot establish causality and residual confounding is always possible"}, {"id": 155, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[175, 175]], "note": "blank"}, {"id": 156, "kind": "nonclaim", "subtype": "heading", "lines": [[176, 176]], "note": "5.5 assumptions subheading"}, {"id": 157, "kind": "claim", "lines": [[177, 177]], "assertion": "relied on the assumption of conditional exchangeability for causal interpretation", "polarity": "did", "targets": ["conditional exchangeability"], "confidence": "medium", "shares_lines_with": []}, {"id": 158, "kind": "nonclaim", "subtype": "framing", "lines": [[178, 178]], "note": "restates what the exchangeability assumption means"}, {"id": 159, "kind": "nonclaim", "subtype": "hedging", "lines": [[179, 179]], "note": "caveat that the assumption is likely violated if unmeasured characteristics vary by skin tone"}, {"id": 160, "kind": "claim", "lines": [[180, 180]], "assertion": "concludes the effect estimate should be interpreted as an association, not definitively causal", "polarity": "found", "targets": ["causal interpretation"], "confidence": "high", "shares_lines_with": []}, {"id": 161, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[181, 181]], "note": "blank"}, {"id": 162, "kind": "nonclaim", "subtype": "heading", "lines": [[182, 182]], "note": "5.6 external validity subheading"}, {"id": 163, "kind": "claim", "lines": [[183, 183]], "assertion": "restricted the analysis to the 2012-2013 season only, noting patterns may have changed since", "polarity": "did", "targets": ["season"], "confidence": "high", "shares_lines_with": []}, {"id": 164, "kind": "claim", "lines": [[184, 184]], "assertion": "restricted the analysis to four European leagues only, noting it may not generalize to other regions", "polarity": "did", "targets": ["leagues"], "confidence": "high", "shares_lines_with": []}, {"id": 165, "kind": "claim", "lines": [[185, 185]], "assertion": "restricted the sample to male players only", "polarity": "did", "targets": ["sample"], "confidence": "high", "shares_lines_with": []}, {"id": 166, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[186, 188]], "note": "blank/separator"}, {"id": 167, "kind": "nonclaim", "subtype": "heading", "lines": [[189, 190]], "note": "discussion section heading"}, {"id": 168, "kind": "nonclaim", "subtype": "heading", "lines": [[191, 191]], "note": "6.1 magnitude subheading"}, {"id": 169, "kind": "claim", "lines": [[192, 192]], "assertion": "found the adjusted risk difference of 0.20pp is statistically significant but small in absolute terms", "polarity": "found", "targets": ["risk difference"], "confidence": "high", "shares_lines_with": []}, {"id": 170, "kind": "claim", "lines": [[193, 193]], "assertion": "calculated that a dark-skinned player facing 80 referees (median) would accrue ~0.16 additional red cards over a career vs an identical light-skinned player", "polarity": "found", "targets": ["career red cards"], "confidence": "medium", "shares_lines_with": []}, {"id": 171, "kind": "claim", "lines": [[194, 194]], "assertion": "characterizes the effect as modest at the individual level", "polarity": "found", "targets": ["effect magnitude"], "confidence": "low", "shares_lines_with": []}, {"id": 172, "kind": "claim", "lines": [[195, 195]], "assertion": "speculates that at the systemic level, across many players, such bias could substantially affect career trajectories, suspensions, and team performance", "polarity": "found", "targets": ["systemic impact"], "confidence": "low", "shares_lines_with": []}, {"id": 173, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[196, 196]], "note": "blank"}, {"id": 174, "kind": "nonclaim", "subtype": "heading", "lines": [[197, 197]], "note": "6.2 robustness subheading"}, {"id": 175, "kind": "nonclaim", "subtype": "framing", "lines": [[198, 198]], "note": "intro to strengths list"}, {"id": 176, "kind": "claim", "lines": [[199, 199]], "assertion": "cites p=0.005 as well below the conventional threshold, supporting significance", "polarity": "found", "targets": ["p-value"], "confidence": "medium", "shares_lines_with": []}, {"id": 177, "kind": "claim", "lines": [[200, 200]], "assertion": "cites the CI excluding zero with a comfortable margin (lower bound 0.05pp) as supporting evidence", "polarity": "found", "targets": ["confidence interval"], "confidence": "medium", "shares_lines_with": []}, {"id": 178, "kind": "claim", "lines": [[201, 201]], "assertion": "cites the dose-response pattern (stronger effect for extreme groups, continuous relationship) as supporting evidence", "polarity": "found", "targets": ["dose-response"], "confidence": "medium", "shares_lines_with": []}, {"id": 179, "kind": "claim", "lines": [[202, 202]], "assertion": "cites persistence of the effect across multiple sensitivity analyses as supporting evidence", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "medium", "shares_lines_with": []}, {"id": 180, "kind": "claim", "lines": [[203, 203]], "assertion": "cites adjustment for position, league, exposure, and aggressiveness as supporting the causal case", "polarity": "found", "targets": ["covariates"], "confidence": "medium", "shares_lines_with": []}, {"id": 181, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[204, 204]], "note": "blank"}, {"id": 182, "kind": "nonclaim", "subtype": "framing", "lines": [[205, 205]], "note": "intro to weaknesses list"}, {"id": 183, "kind": "nonclaim", "subtype": "hedging", "lines": [[206, 206]], "note": "generic caveat that unmeasured confounders of similar size are easy to imagine"}, {"id": 184, "kind": "claim", "lines": [[207, 207]], "assertion": "found the effect is heterogeneous across leagues, driven primarily by Germany/England, non-significant or reversed in France/Spain", "polarity": "found", "targets": ["league heterogeneity"], "confidence": "high", "shares_lines_with": []}, {"id": 185, "kind": "nonclaim", "subtype": "hedging", "lines": [[208, 208]], "note": "acknowledges it cannot rule out that dark-skinned players commit more severe fouls"}, {"id": 186, "kind": "claim", "lines": [[209, 209]], "assertion": "notes 15% of the sample is missing skin tone ratings as a limitation", "polarity": "found", "targets": ["missing data"], "confidence": "medium", "shares_lines_with": []}, {"id": 187, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[210, 210]], "note": "blank"}, {"id": 188, "kind": "nonclaim", "subtype": "heading", "lines": [[211, 211]], "note": "6.3 alternative explanations subheading"}, {"id": 189, "kind": "nonclaim", "subtype": "framing", "lines": [[212, 212]], "note": "intro stating alternative explanations seem less plausible"}, {"id": 190, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[213, 213]], "note": "blank"}, {"id": 191, "kind": "nonclaim", "subtype": "framing", "lines": [[214, 214]], "note": "label for alternative explanation 1"}, {"id": 192, "kind": "claim", "lines": [[215, 215]], "assertion": "found light-skinned players received more yellow cards per game (0.127 vs 0.130)", "polarity": "found", "targets": ["yellow card rate"], "confidence": "high", "shares_lines_with": []}, {"id": 193, "kind": "claim", "lines": [[216, 216]], "assertion": "found the skin-tone effect persists after adjusting for yellow card rate", "polarity": "found", "targets": ["skin tone effect"], "confidence": "high", "shares_lines_with": []}, {"id": 194, "kind": "claim", "lines": [[217, 217]], "assertion": "rejected the 'dark-skinned players are more aggressive' explanation, concluding the red-card disparity is not due to generally more aggressive play", "polarity": "did_not", "targets": ["aggressiveness explanation"], "confidence": "high", "shares_lines_with": []}, {"id": 195, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[218, 218]], "note": "blank"}, {"id": 196, "kind": "nonclaim", "subtype": "framing", "lines": [[219, 219]], "note": "label for alternative explanation 2"}, {"id": 197, "kind": "claim", "lines": [[220, 220]], "assertion": "found dark-skinned players are more likely to be forwards while light-skinned players are more likely to be goalkeepers/center backs", "polarity": "found", "targets": ["position distribution"], "confidence": "high", "shares_lines_with": []}, {"id": 198, "kind": "claim", "lines": [[221, 221]], "assertion": "found the effect persists after adjusting for position", "polarity": "found", "targets": ["position"], "confidence": "high", "shares_lines_with": []}, {"id": 199, "kind": "claim", "lines": [[222, 222]], "assertion": "found that excluding goalkeepers strengthens the effect", "polarity": "found", "targets": ["goalkeepers"], "confidence": "medium", "shares_lines_with": []}, {"id": 200, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[223, 223]], "note": "blank"}, {"id": 201, "kind": "nonclaim", "subtype": "framing", "lines": [[224, 224]], "note": "label for alternative explanation 3"}, {"id": 202, "kind": "claim", "lines": [[225, 225]], "assertion": "found dark-skinned players are more common in France/England", "polarity": "found", "targets": ["league composition"], "confidence": "high", "shares_lines_with": []}, {"id": 203, "kind": "claim", "lines": [[226, 226]], "assertion": "found the effect persists after adjusting for league", "polarity": "found", "targets": ["league"], "confidence": "high", "shares_lines_with": []}, {"id": 204, "kind": "claim", "lines": [[227, 227]], "assertion": "found the effect is actually stronger in Germany, which has fewer dark-skinned players", "polarity": "found", "targets": ["Germany"], "confidence": "medium", "shares_lines_with": []}, {"id": 205, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[228, 228]], "note": "blank"}, {"id": 206, "kind": "nonclaim", "subtype": "framing", "lines": [[229, 229]], "note": "label for alternative explanation 4"}, {"id": 207, "kind": "claim", "lines": [[230, 230]], "assertion": "found p=0.005 with a bootstrap CI excluding zero", "polarity": "found", "targets": ["p-value", "confidence interval"], "confidence": "high", "shares_lines_with": []}, {"id": 208, "kind": "claim", "lines": [[231, 231]], "assertion": "found multiple sensitivity analyses consistent with the main result", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "medium", "shares_lines_with": []}, {"id": 209, "kind": "claim", "lines": [[232, 232]], "assertion": "found a dose-response relationship observed in the data", "polarity": "found", "targets": ["dose-response"], "confidence": "medium", "shares_lines_with": []}, {"id": 210, "kind": "claim", "lines": [[233, 233]], "assertion": "rejected the random-chance explanation, concluding the finding is very unlikely to be a statistical artifact", "polarity": "did_not", "targets": ["random chance explanation"], "confidence": "high", "shares_lines_with": []}, {"id": 211, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[234, 234]], "note": "blank"}, {"id": 212, "kind": "nonclaim", "subtype": "heading", "lines": [[235, 235]], "note": "6.4 interpretation subheading"}, {"id": 213, "kind": "claim", "lines": [[236, 236]], "assertion": "concludes the most parsimonious explanation is that referees exhibit subtle bias in red-card decisions by skin tone, even after adjusting for position/league/exposure/aggressiveness, most pronounced in Germany/England, possibly reflecting cultural differences in implicit racial attitudes", "polarity": "found", "targets": ["referee bias", "interpretation"], "confidence": "medium", "shares_lines_with": []}, {"id": 214, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[237, 237]], "note": "blank"}, {"id": 215, "kind": "claim", "lines": [[238, 238]], "assertion": "acknowledges the modest effect could reflect unmeasured confounding, but judges that consistency across specifications, the dose-response pattern, and the independent referee-bias effect lend credibility to a causal interpretation", "polarity": "found", "targets": ["causal interpretation"], "confidence": "low", "shares_lines_with": []}, {"id": 216, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[239, 241]], "note": "blank/separator"}, {"id": 217, "kind": "nonclaim", "subtype": "heading", "lines": [[242, 243]], "note": "conclusion section heading"}, {"id": 218, "kind": "claim", "lines": [[244, 244]], "assertion": "states the hypothesis status as SUPPORTED", "polarity": "found", "targets": ["hypothesis"], "confidence": "high", "shares_lines_with": []}, {"id": 219, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[245, 245]], "note": "blank"}, {"id": 220, "kind": "claim", "lines": [[246, 246]], "assertion": "restates the primary finding: statistically significant evidence (p=0.005) that referees are more likely to red-card darker-skinned players after adjustment, risk difference 0.20pp (95% CI [0.05,0.33]), ~17% relative increase", "polarity": "found", "targets": ["risk difference", "hypothesis"], "confidence": "high", "shares_lines_with": []}, {"id": 221, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[247, 247]], "note": "blank"}, {"id": 222, "kind": "nonclaim", "subtype": "heading", "lines": [[248, 248]], "note": "why supported heading"}, {"id": 223, "kind": "claim", "lines": [[249, 249]], "assertion": "cites p=0.005 below α=0.05 and CI excluding zero with a comfortable margin as reason for support", "polarity": "found", "targets": ["p-value", "confidence interval"], "confidence": "medium", "shares_lines_with": []}, {"id": 224, "kind": "claim", "lines": [[250, 250]], "assertion": "cites the effect direction as consistent with the hypothesis across all specifications", "polarity": "found", "targets": ["effect direction"], "confidence": "medium", "shares_lines_with": []}, {"id": 225, "kind": "claim", "lines": [[251, 251]], "assertion": "cites multiple sensitivity analyses confirming the finding is not an artifact of modeling choices", "polarity": "found", "targets": ["sensitivity analyses"], "confidence": "medium", "shares_lines_with": []}, {"id": 226, "kind": "claim", "lines": [[252, 252]], "assertion": "cites the effect being stronger for extreme skin-tone groups as suggesting a genuine gradient", "polarity": "found", "targets": ["dose-response"], "confidence": "medium", "shares_lines_with": []}, {"id": 227, "kind": "claim", "lines": [[253, 253]], "assertion": "characterizes the effect as modest but precisely estimated and unlikely to be zero", "polarity": "found", "targets": ["effect magnitude"], "confidence": "medium", "shares_lines_with": []}, {"id": 228, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[254, 254]], "note": "blank"}, {"id": 229, "kind": "nonclaim", "subtype": "heading", "lines": [[255, 255]], "note": "remaining concerns heading"}, {"id": 230, "kind": "nonclaim", "subtype": "hedging", "lines": [[256, 256]], "note": "restates small absolute effect size as a remaining concern, no new action"}, {"id": 231, "kind": "nonclaim", "subtype": "hedging", "lines": [[257, 257]], "note": "generic caveat that unmeasured confounding remains possible"}, {"id": 232, "kind": "nonclaim", "subtype": "hedging", "lines": [[258, 258]], "note": "generic caveat that league heterogeneity suggests context-dependence"}, {"id": 233, "kind": "nonclaim", "subtype": "hedging", "lines": [[259, 259]], "note": "generic caveat that definitive causality cannot be established from observational data"}, {"id": 234, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[260, 260]], "note": "blank"}, {"id": 235, "kind": "claim", "lines": [[261, 261]], "assertion": "concludes the weight of evidence supports the hypothesis, consistent with broader research on implicit bias in sports officiating", "polarity": "found", "targets": ["hypothesis", "implicit bias"], "confidence": "medium", "shares_lines_with": [236]}, {"id": 236, "kind": "claim", "lines": [[261, 261]], "assertion": "asserts that the effect's persistence after controlling for referee implicit bias indicates a pervasive phenomenon requiring systemic intervention", "polarity": "found", "targets": ["referee bias", "systemic intervention"], "confidence": "low", "shares_lines_with": [235]}, {"id": 237, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[262, 264]], "note": "blank/separator"}, {"id": 238, "kind": "nonclaim", "subtype": "heading", "lines": [[265, 266]], "note": "reproducibility section heading"}, {"id": 239, "kind": "claim", "lines": [[267, 267]], "assertion": "asserts all analyses are fully reproducible using the submitted script final_analysis.py", "polarity": "did", "targets": ["reproducibility", "script"], "confidence": "high", "shares_lines_with": []}, {"id": 240, "kind": "claim", "lines": [[268, 268]], "assertion": "the script includes complete data preparation and sample selection", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 241, "kind": "claim", "lines": [[269, 269]], "assertion": "the script includes the primary analysis with bootstrapped confidence intervals", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 242, "kind": "claim", "lines": [[270, 270]], "assertion": "the script includes all six sensitivity analyses", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 243, "kind": "claim", "lines": [[271, 271]], "assertion": "the script includes missing data diagnostics", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 244, "kind": "claim", "lines": [[272, 272]], "assertion": "the script includes detailed output matching this report", "polarity": "did", "targets": ["script"], "confidence": "medium", "shares_lines_with": []}, {"id": 245, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[273, 273]], "note": "blank"}, {"id": 246, "kind": "nonclaim", "subtype": "framing", "lines": [[274, 274]], "note": "intro to software version list"}, {"id": 247, "kind": "claim", "lines": [[275, 279]], "assertion": "used Python 3.11, pandas 2.0, statsmodels 0.14, numpy 1.24, and scipy 1.11", "polarity": "did", "targets": ["software versions"], "confidence": "high", "shares_lines_with": []}, {"id": 248, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[280, 280]], "note": "blank"}, {"id": 249, "kind": "claim", "lines": [[281, 281]], "assertion": "used random seed 42 for bootstrap replicability", "polarity": "did", "targets": ["random seed"], "confidence": "high", "shares_lines_with": []}, {"id": 250, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[282, 284]], "note": "blank/separator"}, {"id": 251, "kind": "nonclaim", "subtype": "heading", "lines": [[285, 286]], "note": "final note heading"}, {"id": 252, "kind": "claim", "lines": [[287, 287]], "assertion": "reports that despite beginning with strong skepticism expecting the hypothesis to be unsupported, the consistent findings across specifications, the dose-response relationship, and external implicit-bias validation overcame that skepticism", "polarity": "found", "targets": ["author skepticism", "findings"], "confidence": "medium", "shares_lines_with": [253, 254]}, {"id": 253, "kind": "claim", "lines": [[287, 287]], "assertion": "concludes the evidence is compelling enough to support the hypothesis at α=0.05, while remaining cautious about definitive causal claims given the observational design", "polarity": "found", "targets": ["hypothesis", "causal claim"], "confidence": "medium", "shares_lines_with": [252, 254]}, {"id": 254, "kind": "claim", "lines": [[287, 287]], "assertion": "asserts the effect is real, statistically significant, and unlikely due to chance, though its modest magnitude warrants continued scrutiny regarding unmeasured confounding", "polarity": "found", "targets": ["effect", "unmeasured confounding"], "confidence": "medium", "shares_lines_with": [252, 253]}, {"id": 255, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[288, 288]], "note": "blank"}, {"id": 256, "kind": "nonclaim", "subtype": "boilerplate", "lines": [[289, 289]], "note": "tool-output wrapper end tag"}]}}