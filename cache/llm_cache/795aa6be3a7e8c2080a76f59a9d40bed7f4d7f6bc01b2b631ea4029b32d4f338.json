t"], "confidence": "high", "shares_lines_with": []}, {"id": 47, "kind": "nonclaim", "subtype": "heading", "lines": [[72, 72]], "note": "Skin tone operationalization label"}, {"id": 48, "kind": "claim", "lines": [[73, 73]], "assertion": "skin tone was rated independently by two blind raters on a scale from 0 (very light) to 1 (very dark)", "polarity": "did", "targets": ["skin tone rating method"], "confidence": "high", "shares_lines_with": []}, {"id": 49, "kind": "claim", "lines": [[74, 74]], "assertion": "the inter-rater correlation is r=0.924", "polarity": "found", "targets": ["inter-rater correlation"], "confidence": "high", "shares_lines_with": []}, {"id": 50, "kind": "claim", "lines": [[75, 75]], "assertion": "the two raters' ratings were averaged into a single skin tone score", "polarity": "did", "targets": ["skin tone averaging"], "confidence": "high", "shares_lines_with": []}, {"id": 51, "kind": "claim", "lines": [[76, 77]], "assertion": "skin tone was binarized into light (≤0.25) and dark (≥0.50) categories, excluding the middle value", "polarity": "did", "targets": ["skin tone binarization"], "confidence": "high", "shares_lines_with": []}, {"id": 52, "kind": "nonclaim", "subtype": "heading", "lines": [[78, 78]], "note": "Outcome Variable heading"}, {"id": 53, "kind": "claim", "lines": [[79, 79]], "assertion": "the outcome variable was defined as a binary indicator of receiving at least one red card from a given referee across all encounters", "polarity": "did", "targets": ["outcome variable"], "confidence": "high", "shares_lines_with": []}, {"id": 54, "kind": "claim", "lines": [[80, 80]], "assertion": "1,484 dyads (1.25%) have red cards", "polarity": "found", "targets": ["red card count"], "confidence": "high", "shares_lines_with": []}, {"id": 55, "kind": "claim", "lines": [[81, 82]], "assertion": "117,528 dyads (98.75%) have no red cards", "polarity": "found", "targets": ["no red card count"], "confidence": "high", "shares_lines_with": []}, {"id": 56, "kin