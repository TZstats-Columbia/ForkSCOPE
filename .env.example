# ForkSCOPE environment -- TEMPLATE. This file is committed; copy it and edit
# the copy, which is git-ignored:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# `paths.py` reads these directly from the environment; nothing in the package
# parses this file, so it is a convenience for a shell, not configuration the
# pipeline depends on.

# Which study is resolved: a name under studies/, or an absolute path.
#
# LEAVE THIS UNSET for the packaged soccer study. Its study.json sits at the
# package root, not under studies/, so FORKSCOPE_STUDY=soccer resolves to
# studies/soccer -- which does not exist -- and every script exits with
# "no study.json at .../studies/soccer". Setting it to the study you are
# already in is the intuitive move and it is wrong.
#
# Set it only for a SECOND study created from templates/:
#     FORKSCOPE_STUDY=my-study        # -> studies/my-study
#     FORKSCOPE_STUDY=/data/my-study  # absolute paths work too
#FORKSCOPE_STUDY=

# ---------------------------------------------------------------------------
# The two source corpora. NEITHER IS VENDORED and neither is present yet.
#
# These paths are where fetch_corpus.py puts things by default. They do not
# exist until you fetch, and pointing them at nothing is worse than leaving
# them unset:
#
#     python3 scripts/fetch_corpus.py status --dest ../corpus
#     python3 scripts/fetch_corpus.py fetch  --dest ../corpus   # AI + dataset
#     python3 scripts/fetch_corpus.py verify --dest ../corpus   # 697 SHA-256s
#
# VERIFY BEFORE RUNNING STAGE 1. An unset FORKSCOPE_RAW_AI does not fail loudly:
# distillation finds no runs, persona-arm recovery falls back to the corpus
# name, and you get a spurious `ai` arm with per-arm tables that look plausible
# and are wrong. An unfetched Git-LFS pointer has the same shape -- valid
# UTF-8, ~130 bytes, and it silently becomes a run with no report.
#
# The human corpus is NOT fetched automatically and no flag will do it. Those
# are participant documents from a human-subjects study; obtaining them is a
# decision taken against the original study's terms, not a step a script takes
# on your behalf.
# ---------------------------------------------------------------------------
FORKSCOPE_RAW_AI=../corpus/afp
FORKSCOPE_RAW_HUMAN=../corpus/human_corpus

# ---------------------------------------------------------------------------
# You do not need either corpus for anything downstream of stage 1. Every
# artifact after distillation is committed, and cache/ holds 2,293 model
# responses, so the analyses, audits and figures all reproduce with no corpus
# and no model access:
#
#     python3 scripts/build_figures.py
#     python3 scripts/audit_vocab.py
#     python3 scripts/stability.py --corpus "$(python3 -c 'import sys;sys.path.insert(0,"scripts");import paths;print(paths.FINAL_TAG)')"
#
# To PROVE a run spent nothing, take the `claude` CLI off PATH for it. Cache
# hits are unaffected; an uncached call dies with FileNotFoundError instead of
# quietly costing money:
#
#     PATH=$(echo "$PATH" | tr ':' '\n' | grep -v claude | paste -sd: -) \
#       python3 scripts/build_figures.py
# ---------------------------------------------------------------------------

# Requires Python 3.12+. Under 3.9 you get three bogus SyntaxErrors from
# f-strings in fork_graph.py and garden_viewer.py, and _selfcheck.py fails on
# them. If `python3 -V` is older, name the interpreter explicitly.
